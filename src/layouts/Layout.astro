---
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

const {
	title = 'Truly Compass — Free Digital Compass in Your Browser',
	description = 'Free online compass with live heading, auto location, sun position, and moon position. Mobile-friendly — works in your browser at trulycompass.com.',
	canonical = 'https://trulycompass.com/',
	keywords = 'online compass, free compass, digital compass, compass online, browser compass',
 	ogImage = 'https://trulycompass.com/og-image.png',
 	ogImageAlt = 'Truly Compass - Free Digital Compass and Navigation Tools',
 	// Locale controls (pages should pass these when rendering localized variants)
 	lang = 'en',
 	dir = 'ltr',
 	alternates = [], // [{ hreflang: 'ar', href: 'https://trulycompass.com/ar/qibla-compass/' }, ...]
} = Astro.props;
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Truly Compass" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" id="themeColorMeta" content="#0a0a0a" />
		{alternates.map((a) => (
			<link rel="alternate" hrefLang={a.hreflang} href={a.href} />
		))}
		<link rel="canonical" href={canonical} />
		<meta property="og:locale" content={lang === 'ar' ? 'ar_AR' : lang === 'id' ? 'id_ID' : 'en_US'} />
		<meta property="og:site_name" content="Truly Compass" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<!-- Google Analytics & AdSense are loaded conditionally by CookieConsent after user consent -->
		<link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
		<link
			href="https://fonts.bunny.net/css?family=geist:400,500,600|geist-mono:400"
			rel="stylesheet"
		/>
		<script>
			// Apply theme before page renders to prevent flash
			(function() {
				try {
					const theme = localStorage.getItem('oc:theme') || 'dark';
					document.documentElement.setAttribute('data-theme', theme);
					const meta = document.getElementById('themeColorMeta');
					if (meta) meta.content = theme === 'dark' ? '#0a0a0a' : '#fafafa';
				} catch (e) {
					// Ignore errors
				}
			})();
			// Watch theme changes to update meta tag
			try {
				const observer = new MutationObserver(() => {
					const meta = document.getElementById('themeColorMeta');
					if (meta) {
						const theme = document.documentElement.getAttribute('data-theme');
						meta.content = theme === 'light' ? '#fafafa' : '#0a0a0a';
					}
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
			} catch (e) {}
		</script>
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<CookieConsent />
	</body>
</html>
