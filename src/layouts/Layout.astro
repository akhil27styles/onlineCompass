---
import '../styles/global.css';

const {
	title = 'Truly Compass — Free Digital Compass in Your Browser',
	description = 'Free online compass with live heading, auto location, sun position, and moon position. Mobile-friendly — works in your browser at trulycompass.com.',
	canonical = 'https://trulycompass.com/',
	keywords = 'online compass, free compass, digital compass, compass online, browser compass',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="trulycom" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="keywords" content={keywords} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" id="themeColorMeta" content="#0a0a0a" />
		<link rel="canonical" href={canonical} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:site_name" content="Truly Compass" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content="https://trulycompass.com/og-image.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Truly Compass - Free Digital Compass and Navigation Tools" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content="https://trulycompass.com/og-image.png" />
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-L1KC85ZFZF"></script>
		<script>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-L1KC85ZFZF');
		</script>
		<link rel="preconnect" href="https://fonts.bunny.net" crossorigin />
		<link
			href="https://fonts.bunny.net/css?family=geist:400,500,600|geist-mono:400"
			rel="stylesheet"
		/>
		<script>
			// Apply theme before page renders to prevent flash
			(function() {
				try {
					const theme = localStorage.getItem('oc:theme') || 'dark';
					document.documentElement.setAttribute('data-theme', theme);
					const meta = document.getElementById('themeColorMeta');
					if (meta) meta.content = theme === 'dark' ? '#0a0a0a' : '#fafafa';
				} catch (e) {
					// Ignore errors
				}
			})();
			// Watch theme changes to update meta tag
			try {
				const observer = new MutationObserver(() => {
					const meta = document.getElementById('themeColorMeta');
					if (meta) {
						const theme = document.documentElement.getAttribute('data-theme');
						meta.content = theme === 'light' ? '#fafafa' : '#0a0a0a';
					}
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
			} catch (e) {}
		</script>
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
