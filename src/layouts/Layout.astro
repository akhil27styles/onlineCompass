---
import '../styles/global.css';

const {
	title = 'Online Compass - Free Mobile-Friendly Digital Compass',
	description = 'Use Online Compass for a privacy-friendly browser compass with device detection, screen diagonal checks, calibration guidance, and bearing tools.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#ffffff" />
		<link rel="canonical" href="https://freeonlinecompass.com/" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://freeonlinecompass.com/" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
