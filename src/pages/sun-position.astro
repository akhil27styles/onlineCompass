---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DevicePanel from '../components/DevicePanel.astro';
import LocationPrompt from '../components/LocationPrompt.astro';
import SkyDial from '../components/SkyDial.astro';

const facts = [
	['Azimuth', 'Horizontal direction of the sun measured clockwise from north (0°).'],
	['Altitude', 'Height of the sun above the horizon. Negative values mean the sun is below the horizon.'],
	['Solar Noon', 'When the sun reaches its highest point for the day at your coordinates.'],
	['Golden Hour', 'Soft light windows shortly after sunrise and before sunset.'],
];
---

<Layout
	title="Sun Position - Online Compass | freeOnlinecompass.com"
	description="See live sun azimuth, altitude, sunrise, sunset, and solar noon for your location with a mobile-first sun position tool."
	canonical="https://freeonlinecompass.com/sun-position/"
>
	<SiteHeader current="sun" />

	<main id="main">
		<section class="border-b border-hairline bg-canvas-soft pt-8 pb-6 sm:pt-12 lg:pb-14">
			<div class="content-grid grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
				<div class="min-w-0">
					<p class="font-mono text-xs uppercase text-muted" translate="no">freeOnlinecompass.com</p>
					<h1 class="mt-3 max-w-3xl text-balance text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl">
						Sun Position
					</h1>
					<p class="mt-4 max-w-2xl text-pretty text-base leading-7 text-body sm:text-lg">
						Live sun direction, altitude, and today’s key solar times for your current location — calculated in the browser.
					</p>
				</div>
				<DevicePanel />
			</div>
		</section>

		<section class="bg-white py-6 sm:py-12">
			<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
				<SkyDial id="sunDial" title="Sun Direction Now" subtitle="Live Sky" />

				<aside class="grid gap-6">
					<section class="rounded-panel border border-hairline bg-canvas-soft p-4" aria-labelledby="sun-times-title">
						<h2 id="sun-times-title" class="text-sm font-semibold">Today’s Solar Times</h2>
						<dl class="mt-4 grid gap-3 text-sm">
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Sunrise</dt>
								<dd id="sunriseTime" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Solar Noon</dt>
								<dd id="solarNoonTime" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Sunset</dt>
								<dd id="sunsetTime" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Day Length</dt>
								<dd id="dayLength" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Golden Hour Ends</dt>
								<dd id="goldenHourEnd" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Golden Hour Begins</dt>
								<dd id="goldenHourStart" class="font-mono text-ink">--</dd>
							</div>
						</dl>
					</section>

					<section class="rounded-panel border border-hairline bg-white p-4" aria-labelledby="sun-location-title">
						<h2 id="sun-location-title" class="text-sm font-semibold">Your Location</h2>
						<LocationPrompt messageId="sunLocationNote" compact />
					</section>
				</aside>
			</div>
		</section>

		<section class="border-t border-hairline bg-canvas-soft py-10 sm:py-14">
			<div class="content-grid">
				<div class="max-w-2xl">
					<p class="font-mono text-xs uppercase text-muted">Reference</p>
					<h2 class="mt-2 text-3xl font-semibold tracking-tight">How to read sun position</h2>
				</div>
				<div class="mt-8 grid gap-3 sm:grid-cols-2">
					{
						facts.map(([title, body]) => (
							<article class="rounded-panel border border-hairline bg-white p-5">
								<h3 class="text-base font-semibold">{title}</h3>
								<p class="mt-3 text-sm leading-6 text-body">{body}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<script>
	import { mountDeviceUi } from '../scripts/device-ui';
	import { formatDegrees, formatDuration, formatTime, getSunSnapshot } from '../lib/astronomy';

	const beacon = document.querySelector('#sunDialBeacon');
	const degrees = document.querySelector('#sunDialDegrees');
	const altitudeEl = document.querySelector('#sunDialAltitude');
	const status = document.querySelector('#sunDialStatus');
	let coords: { latitude: number; longitude: number } | null = null;
	let timer: number | undefined;

	function setText(el: Element | null, value: string) {
		if (el) el.textContent = value;
	}

	function renderSun() {
		if (!coords) return;
		const snapshot = getSunSnapshot(new Date(), { lat: coords.latitude, lng: coords.longitude });

		if (beacon instanceof HTMLElement) {
			beacon.style.setProperty('--azimuth', `${snapshot.azimuth}deg`);
		}
		setText(degrees, Math.round(snapshot.azimuth).toString());
		setText(altitudeEl, `Altitude ${formatDegrees(snapshot.altitude)}`);
		setText(
			status,
			snapshot.isUp ? 'Sun is above the horizon' : 'Sun is below the horizon',
		);

		setText(document.querySelector('#sunriseTime'), formatTime(snapshot.times.sunrise));
		setText(document.querySelector('#solarNoonTime'), formatTime(snapshot.times.solarNoon));
		setText(document.querySelector('#sunsetTime'), formatTime(snapshot.times.sunset));
		setText(document.querySelector('#dayLength'), formatDuration(snapshot.dayLength));
		setText(document.querySelector('#goldenHourEnd'), formatTime(snapshot.times.goldenHourEnd));
		setText(document.querySelector('#goldenHourStart'), formatTime(snapshot.times.goldenHour));
	}

	function onLocation(latitude: number, longitude: number) {
		coords = { latitude, longitude };
		renderSun();
		window.clearInterval(timer);
		timer = window.setInterval(renderSun, 30_000);
	}

	mountDeviceUi({
		onLocation: (c) => onLocation(c.latitude, c.longitude),
	});

	document.addEventListener('oc:location-ready', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
		setText(status, 'Location ready');
	});

	document.addEventListener('oc:location-needs-permission', () => {
		setText(status, 'Allow location to continue');
	});

	document.addEventListener('oc:location-denied', () => {
		setText(status, 'Location needed');
	});
</script>
