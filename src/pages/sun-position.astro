---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import LocationPrompt from '../components/LocationPrompt.astro';
import SkyDial from '../components/SkyDial.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import AdSlot from '../components/AdSlot.astro';

const facts = [
	['Solar Azimuth', 'The horizontal direction of the sun measured clockwise from North (0°). E.g., East is 90°, South is 180°, West is 270°.'],
	['Solar Altitude', 'The vertical height of the sun above the horizon. Ranges from 0° on the horizon to 90° directly overhead (Zenith). Negative values represent the sun below the horizon (night).'],
	['Solar Noon', 'The moment when the sun reaches its highest point in the sky for the day at your exact coordinates. This differs slightly from 12:00 PM clock time due to timezone boundaries and orbital offsets.'],
	['Golden Hour', 'The periods shortly after sunrise and before sunset where light is warmer, softer, and shadows are elongated — highly valued by photographers.'],
];
---

<Layout
	title="Current Sun Position — Live Azimuth, Altitude, Sunrise & Sunset"
	description="See the sun's current position at your location. Live solar azimuth and altitude, plus today's sunrise, sunset, and solar noon. Free mobile-friendly sun position tool."
	keywords="sun position, current sun position, sun azimuth, solar altitude, sunrise sunset today, sun position now"
	canonical="https://freeonlinecompass.com/sun-position/"
>
	<SeoJsonLd
		slot="head"
		name="Sun Position — Online Compass"
		description="Live sun azimuth, altitude, sunrise, sunset, and solar noon for your location."
		url="https://freeonlinecompass.com/sun-position/"
	/>
	<div class="relative min-h-screen flex flex-col overflow-x-hidden bg-canvas-soft">
		<div class="mesh-gradient-bg" aria-hidden="true"></div>

		<SiteShell current="sun" />

		<main id="main" class="flex-grow z-10">
			<!-- Main Content -->
			<div id="mainContent">
				<section class="content-grid pt-8 pb-6 sm:pt-10 sm:pb-8 text-center relative z-20">
					<p class="font-mono text-xs uppercase text-muted tracking-widest" translate="no">freeOnlinecompass.com</p>
					<h1 class="mt-4 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-none tracking-tighter text-ink sm:text-5xl">
						Current Sun Position
					</h1>
					<p class="mt-4 max-w-2xl mx-auto text-pretty text-sm leading-6 text-body">
						Live sun direction, altitude, and today's sunrise and sunset for your location.
					</p>
				</section>

				<!-- Tool Grid -->
				<section class="py-6 sm:py-8">
					<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
						
						<!-- Left: Dial and primary calculations -->
						<div class="flex flex-col">
							<SkyDial id="sunDial" title="Sun Direction Now" subtitle="Solar Tracking" variant="sun" />
							
							<!-- Sun Direction readout card -->
							<div class="rounded-panel border border-hairline bg-canvas p-6 card-elevated mt-6">
								<p class="font-mono text-[10px] uppercase text-muted tracking-wider text-center">Sun Direction</p>
								<h3 id="sunDirectionText" class="text-xl sm:text-2xl font-semibold tracking-tight text-ink text-center mt-2">--</h3>
								<p class="text-xs text-body text-center font-mono mt-1"><span id="sunAzimuthRaw">--</span>° azimuth <span class="cursor-help text-muted" title="Measured clockwise from North (0°)">ⓘ</span></p>
							</div>

							<!-- Core Metrics Row -->
							<div class="grid grid-cols-3 gap-3 mt-4">
								<div class="rounded-panel border border-hairline bg-canvas p-4 text-center card-elevated">
									<p class="font-mono text-[9px] uppercase text-muted tracking-wider">Altitude</p>
									<p id="sunAltitudeVal" class="text-sm sm:text-base font-semibold text-ink mt-1 font-mono">--</p>
									<p id="sunAltitudeHelp" class="text-[9px] text-body mt-0.5">--</p>
								</div>
								<div class="rounded-panel border border-hairline bg-canvas p-4 text-center card-elevated">
									<p class="font-mono text-[9px] uppercase text-muted tracking-wider">Sunrise</p>
									<p id="sunriseTimeVal" class="text-sm sm:text-base font-semibold text-ink mt-1 font-mono">--</p>
									<p class="text-[9px] text-body mt-0.5">local time</p>
								</div>
								<div class="rounded-panel border border-hairline bg-canvas p-4 text-center card-elevated">
									<p class="font-mono text-[9px] uppercase text-muted tracking-wider">Sunset</p>
									<p id="sunsetTimeVal" class="text-sm sm:text-base font-semibold text-ink mt-1 font-mono">--</p>
									<p class="text-[9px] text-body mt-0.5">local time</p>
								</div>
							</div>
						</div>

						<!-- Right: Sidebar controls and secondary times -->
						<aside class="grid gap-6">
							<!-- Location settings panel -->
							<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="sun-location-title">
								<h2 id="sun-location-title" class="text-xs font-mono uppercase text-muted tracking-wider">Observer Coordinates</h2>
								<div class="mt-4">
									<LocationPrompt messageId="sunLocationNote" compact showAlert={false}/>
								</div>
							</section>

							<!-- Weather widget -->
						<WeatherWidget />

						<!-- Solar timeline details -->
							<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="sun-times-title">
								<h2 id="sun-times-title" class="text-xs font-mono uppercase text-muted tracking-wider">Solar Schedule</h2>
								<dl class="mt-4 grid gap-3 text-xs">
									<div class="flex justify-between gap-4 border-t border-hairline pt-3">
										<dt class="text-body font-mono">Solar Noon</dt>
										<dd id="solarNoonTime" class="font-mono text-ink font-semibold">--</dd>
									</div>
									<div class="flex justify-between gap-4 border-t border-hairline pt-3">
										<dt class="text-body font-mono">Dawn (Civil)</dt>
										<dd id="dawnTime" class="font-mono text-ink font-semibold">--</dd>
									</div>
									<div class="flex justify-between gap-4 border-t border-hairline pt-3">
										<dt class="text-body font-mono">Dusk (Civil)</dt>
										<dd id="duskTime" class="font-mono text-ink font-semibold">--</dd>
									</div>
									<div class="flex justify-between gap-4 border-t border-hairline pt-3">
										<dt class="text-body font-mono">Golden Hour Begins</dt>
										<dd id="goldenHourStart" class="font-mono text-ink font-semibold">--</dd>
									</div>
									<div class="flex justify-between gap-4 border-t border-hairline pt-3">
										<dt class="text-body font-mono">Golden Hour Ends</dt>
										<dd id="goldenHourEnd" class="font-mono text-ink font-semibold">--</dd>
									</div>
									<div class="flex justify-between gap-4 border-t border-hairline pt-3">
										<dt class="text-body font-mono">Day Length</dt>
										<dd id="dayLength" class="font-mono text-ink font-semibold">--</dd>
									</div>
								</dl>
							</section>

							<AdSlot id="ad-sun-sidebar" format="vertical" />
						</aside>
					</div>
				</section>

				<!-- Educational Info -->
				<section class="border-t border-hairline bg-canvas py-12 sm:py-16">
					<div class="content-grid">
						<div class="max-w-2xl">
							<p class="font-mono text-xs uppercase text-muted tracking-widest">Physics Reference</p>
							<h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Understanding the solar path.</h2>
							<p class="mt-3 text-xs sm:text-sm text-body leading-relaxed">
								The trajectory of the sun changes continuously based on latitude, longitude, and date. Use these core astronomical indices to track the sun:
							</p>
						</div>
						<div class="mt-8 grid gap-4 sm:grid-cols-2">
							{facts.map(([title, body]) => (
								<article class="rounded border border-hairline bg-canvas-soft-2 p-5">
									<h3 class="text-sm font-semibold text-ink font-mono">{title}</h3>
									<p class="mt-3 text-xs leading-relaxed text-body">{body}</p>
								</article>
							))}
						</div>
					</div>
				</section>
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
	import { prefetchLocationSilently } from '../lib/geo';
	import { mountDeviceUi } from '../scripts/device-ui';
	import { bindSkyDialFromLocation, setSkyAzimuth } from '../scripts/sky-dial';
	import { formatDegrees, formatDuration, formatTime, getSunSnapshot, getDirectionText } from '../lib/astronomy';

	// Prefetch location silently for faster initial data
	prefetchLocationSilently();

	// Declare state variables first, before any callbacks are registered
	let coords: { latitude: number; longitude: number } | null = null;
	let timer: number | undefined;

	function setText(el: Element | null, value: string) {
		if (el) el.textContent = value;
	}

	function onLocation(latitude: number, longitude: number) {
		coords = { latitude, longitude };
		renderSun();
		window.clearInterval(timer);
		timer = window.setInterval(renderSun, 30_000);
	}

	function renderSun() {
		if (!coords) return;
		const snapshot = getSunSnapshot(new Date(), { lat: coords.latitude, lng: coords.longitude });

		setSkyAzimuth(beacon, snapshot.azimuth, snapshot.isUp);

		setText(degrees, Math.round(snapshot.azimuth).toString());
		setText(altitudeEl, `Altitude ${formatDegrees(snapshot.altitude)}`);
		setText(
			status,
			snapshot.isUp ? 'Sun is above the horizon' : 'Sun is below the horizon',
		);

		// Core readouts
		setText(directionText, getDirectionText(snapshot.azimuth));
		setText(rawAzimuth, Math.round(snapshot.azimuth).toString());
		setText(coreAltitude, formatDegrees(snapshot.altitude));
		setText(coreAltitudeHelp, snapshot.isUp ? 'above horizon' : 'below horizon');
		setText(coreSunrise, formatTime(snapshot.times.sunrise));
		setText(coreSunset, formatTime(snapshot.times.sunset));

		// Schedule list
		setText(document.querySelector('#solarNoonTime'), formatTime(snapshot.times.solarNoon));
		setText(document.querySelector('#dawnTime'), formatTime(snapshot.times.dawn));
		setText(document.querySelector('#duskTime'), formatTime(snapshot.times.dusk));
		setText(document.querySelector('#goldenHourStart'), formatTime(snapshot.times.goldenHour));
		setText(document.querySelector('#goldenHourEnd'), formatTime(snapshot.times.goldenHourEnd));
		setText(document.querySelector('#dayLength'), formatDuration(snapshot.dayLength));
	}

	const beacon = bindSkyDialFromLocation('#sunDialBeacon', (c) => onLocation(c.latitude, c.longitude));
	const degrees = document.querySelector('#sunDialDegrees');
	const altitudeEl = document.querySelector('#sunDialAltitude');
	const status = document.querySelector('#sunDialStatus');
	const dialLocationCity = document.querySelector('#dialLocationCity');

	// Restructured core metrics
	const directionText = document.querySelector('#sunDirectionText');
	const rawAzimuth = document.querySelector('#sunAzimuthRaw');
	const coreAltitude = document.querySelector('#sunAltitudeVal');
	const coreAltitudeHelp = document.querySelector('#sunAltitudeHelp');
	const coreSunrise = document.querySelector('#sunriseTimeVal');
	const coreSunset = document.querySelector('#sunsetTimeVal');

	// Mount device UI and start location fetching immediately so the browser
	// can prompt for geolocation and we can use IP fallback.
	mountDeviceUi({
		onLocation: (c) => onLocation(c.latitude, c.longitude),
	});

	document.addEventListener('oc:location-ready', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
		setText(status, 'Location ready');
		setText(dialLocationCity, `(${detail.coords.latitude.toFixed(4)}°, ${detail.coords.longitude.toFixed(4)}°)`);
	});

	document.addEventListener('oc:location-city-ready', (event) => {
		const detail = (event as CustomEvent<{ city: string; coords: { latitude: number; longitude: number } }>).detail;
		setText(dialLocationCity, `${detail.city} (${detail.coords.latitude.toFixed(4)}°, ${detail.coords.longitude.toFixed(4)}°)`);
	});

	document.addEventListener('oc:location-needs-permission', () => {
		setText(status, 'Tap Allow to enable location');
	});

	document.addEventListener('oc:location-updated', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
	});

	document.addEventListener('oc:location-denied', () => {
		setText(status, 'Location blocked');
	});
</script>

<style>
	/* Mesh background */
	.mesh-gradient-bg {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1400px;
		height: 600px;
		opacity: 0.1;
		filter: blur(120px);
		background: 
			radial-gradient(circle at 10% 20%, #007cf0 0%, transparent 40%),
			radial-gradient(circle at 90% 30%, #00dfd8 0%, transparent 45%),
			radial-gradient(circle at 35% 70%, #7928ca 0%, transparent 40%),
			radial-gradient(circle at 65% 15%, #ff0080 0%, transparent 40%),
			radial-gradient(circle at 50% 50%, #f9cb28 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}

	[data-theme="light"] .mesh-gradient-bg {
		opacity: 0.06;
	}</style>
