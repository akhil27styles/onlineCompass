---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AdSlot from '../components/AdSlot.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import LocationPrompt from '../components/LocationPrompt.astro';

const tickMarks = Array.from({ length: 72 }, (_, index) => ({
	angle: index * 5,
	major: index % 6 === 0,
}));

const directionLabels = [
	{ label: 'N', angle: 0 },
	{ label: 'NE', angle: 45 },
	{ label: 'E', angle: 90 },
	{ label: 'SE', angle: 135 },
	{ label: 'S', angle: 180 },
	{ label: 'SW', angle: 225 },
	{ label: 'W', angle: 270 },
	{ label: 'NW', angle: 315 },
];

const popularTools = [
	{
		href: '/sun-position/',
		label: 'Sun Position',
		title: 'Sun position + heat risk',
		body: 'Live solar azimuth, altitude, sunrise, sunset, UV context, and heat stress from your location.',
	},
	{
		href: '/heat-index/',
		label: 'Heat Index',
		title: 'Feels-like temperature',
		body: 'Check local heat index, humidity, UV, wind, and outdoor heat safety before going outside.',
	},
	{
		href: '/air-quality/',
		label: 'Air Quality',
		title: 'AQI near me',
		body: 'Live air quality index, PM2.5, PM10, ozone, and pollution guidance for your location.',
	},
	{
		href: '/stargazing/',
		label: 'Stargazing',
		title: 'Sky conditions tonight',
		body: 'Moon phase, cloud cover, darkness, and a stargazing score for your location.',
	},
	{
		href: '/prayer-times/',
		label: 'Prayer Times',
		title: 'Prayer times today',
		body: 'Local fajr, sunrise, dhuhr, asr, maghrib, and isha times with browser-based location.',
	},
	{
		href: '/golden-hour/',
		label: 'Golden Hour',
		title: 'Golden hour calculator',
		body: 'Plan sunrise and sunset light windows for photography, travel, and outdoor shoots.',
	},
	{
		href: '/day-length/',
		label: 'Day Length',
		title: 'Day length by location',
		body: 'See today’s daylight duration plus seasonal sunrise and sunset changes.',
	},
];

const improvements = [
	['Precise Bearing Target', 'Pin a destination heading and see real-time turn guidance (turn left/right) relative to your sensor data.'],
	['Auto Location & Geocoding', 'Fetches coordinates on load and resolves your physical city name locally to assist with sun/moon positioning.'],
	['Live Sun & Moon tracking', 'Dedicated astronomical dials that project current altitude and azimuth on a stereographic sky map.'],
	['Heat Risk From Sun Position', 'Combines current weather, UV index, humidity, wind, and solar altitude so outdoor planning is more useful than temperature alone.'],
	['Privacy First', 'Compass orientation and geolocation logic runs entirely in the browser and is never stored on a server.'],
	['Calibrated Instrument', 'Built-in calibration checklists and desktop fallback modes so developers can simulate heading changes.'],
];

const faqs = [
	['Does Truly Compass work on every device?', 'It works best on mobile devices (smartphones/tablets) containing a magnetometer sensor. Desktop browsers do not expose compass data, so a phone or tablet is required for active readings.'],
	['Is this true north or magnetic north?', 'Device orientation sensors report magnetic heading. True north requires a local declination correction. This site allows you to compare live orientation with coordinates.'],
	['Why does the compass ask for permission?', 'For security and privacy, modern mobile browsers (especially Safari on iOS) require an explicit user gesture (a button tap) before activating device motion sensors.'],
	['How do I improve compass accuracy?', 'Hold the device flat in your hand, stand away from metal structures, speakers, or magnetic fields, and move your device slowly in a figure-eight motion to calibrate.'],
];
---

<Layout
	title="Truly Compass — Online Compass, Sun Position, Heat Risk & Prayer Times"
	description="Free online compass with live digital heading, sun position, heat risk, UV index, moon phase, prayer times, qibla compass, wind compass and GPS tools."
	keywords="online compass, free compass, digital compass, compass online, browser compass, magnetic compass, compass for phone, north finder, sun position, heat index today, heat risk, UV index, moon position, prayer times today, islamic prayer times, qibla compass, qibla direction, wind compass, GPS coordinates, my current coordinates, latitude longitude finder, golden hour calculator, day length"
	canonical="https://trulycompass.com/"
>
	<SeoJsonLd
		slot="head"
		name="Truly Compass"
		description="Free online compass with live heading, sun position, and moon position tools."
		url="https://trulycompass.com/"
	/>
	<div class="relative min-h-screen flex flex-col overflow-x-hidden bg-canvas-soft">
		<div class="mesh-gradient-bg" aria-hidden="true"></div>

		<SiteShell current="compass" />

		<main id="main" class="flex-grow z-10">
			<section class="content-grid pt-8 pb-6 sm:pt-10 sm:pb-8 text-center relative z-20">
				<p class="font-mono text-xs uppercase text-muted tracking-widest" translate="no">trulycompass.com</p>
				<h1 class="mt-4 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-none tracking-tighter text-ink sm:text-5xl lg:text-6xl">
					Truly Compass
				</h1>
				<p class="mt-4 max-w-2xl mx-auto text-pretty text-sm leading-6 text-body sm:text-base">
					Free digital compass in your browser — live heading, auto location, sun position, heat risk, UV, prayer times, and moon tools.
				</p>
				<div class="mt-6 grid grid-cols-2 gap-2 sm:mx-auto sm:max-w-lg">
					<a
						class="focus-ring rounded-md border border-hairline bg-canvas px-3 py-3 text-center text-xs font-semibold text-ink transition-colors hover:border-hairline-strong hover:bg-canvas-soft-2 sm:text-sm"
						href="/sun-position/"
					>
						☀ Sun + Heat Risk
					</a>
					<a
						class="focus-ring rounded-md border border-hairline bg-canvas px-3 py-3 text-center text-xs font-semibold text-ink transition-colors hover:border-hairline-strong hover:bg-canvas-soft-2 sm:text-sm"
						href="/prayer-times/"
					>
						☾ Prayer Times
					</a>
				</div>
			</section>

			<section class="content-grid py-4 sm:py-6" aria-labelledby="popular-tools-title">
				<div class="flex flex-wrap items-end justify-between gap-3">
					<div>
						<p class="font-mono text-xs uppercase text-muted tracking-widest">Popular Tools</p>
						<h2 id="popular-tools-title" class="mt-2 text-xl font-semibold tracking-tight text-ink sm:text-2xl">Most searched from this site.</h2>
					</div>
					<a class="focus-ring rounded text-xs font-mono text-body hover:text-ink" href="/sun-position/">Open sun position →</a>
				</div>
				<div class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
					{popularTools.map((tool) => (
						<a class="focus-ring group rounded border border-hairline bg-canvas p-4 transition-colors hover:border-hairline-strong hover:bg-canvas-soft-2" href={tool.href}>
							<p class="font-mono text-[10px] uppercase text-muted tracking-wider">{tool.label}</p>
							<h3 class="mt-2 text-sm font-semibold text-ink">{tool.title}</h3>
							<p class="mt-2 text-xs leading-relaxed text-body">{tool.body}</p>
						</a>
					))}
				</div>
			</section>

			<!-- Interactive Instrument Section -->
			<section id="compass" class="py-6 sm:py-8">
				<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
					
					<!-- Left: Compass Dial Card -->
					<div class="rounded-panel border border-hairline bg-canvas p-6 card-elevated flex flex-col items-center justify-between min-h-[480px]">
						<div class="w-full flex flex-wrap items-center justify-between gap-4 border-b border-hairline pb-4">
							<div>
								<p class="font-mono text-[10px] uppercase text-muted tracking-wider">Live Instrument</p>
								<h2 id="compass-title" class="text-lg font-semibold tracking-tight text-ink mt-0.5">Digital Magnetometer</h2>
							</div>
							<div class="rounded-full border border-hairline bg-canvas-soft-2 px-3 py-1 font-mono text-[11px] text-body" aria-live="polite">
								<span id="modeLabel">Magnetic North</span>
							</div>
						</div>

						<div class="my-8 grid place-items-center">
							<div class="compass-shell" aria-label="Compass dial showing heading">
								<div class="compass-rose" id="compassRose">
									{tickMarks.map((tick) => (
										<span
											class:list={['tick', tick.major && 'tick-major']}
											style={`--tick-angle:${tick.angle}deg`}
											aria-hidden="true"
										/>
									))}
									{directionLabels.map((direction) => (
										<span
											class:list={['direction-label', direction.label === 'N' && 'north-label']}
											style={`--label-angle:${direction.angle}deg`}
										>
											{direction.label}
										</span>
									))}
									<!-- Target bearing indicator on the dial -->
									<span id="targetMarker" class="target-marker" style="display:none"></span>
								</div>
								<div class="fixed-needle" aria-hidden="true">
									<span></span>
								</div>
								<div class="heading-readout">
									<p id="cardinalDirection">--</p>
									<strong><span id="headingDegrees">--</span><span aria-hidden="true">°</span></strong>
								</div>
							</div>
						</div>

						<div class="w-full max-w-xs mx-auto">
							<button id="enableCompass" class="focus-ring w-full rounded-full bg-ink px-5 py-3 text-xs font-semibold text-canvas transition-opacity hover:opacity-90 cursor-pointer" type="button">
								Enable Compass
							</button>
						</div>
					</div>

					<!-- Right: Side controls & guides -->
					<aside class="grid gap-6">
						<!-- Target Pinning Control -->
						<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="bearing-title">
							<h2 id="bearing-title" class="text-xs font-mono uppercase text-muted tracking-wider">Target Pinning</h2>
							<div class="mt-4">
								<div class="flex items-center justify-between text-xs font-semibold">
									<span class="text-body">Pin Heading</span>
									<span class="font-mono text-ink"><span id="targetBearingValue">0</span>°</span>
								</div>
								<input id="targetBearing" class="mt-3 w-full h-1 bg-canvas-soft-2 rounded-lg appearance-none cursor-pointer accent-ink" type="range" min="0" max="359" value="0" name="target-bearing" autocomplete="off" aria-describedby="bearingHelp" />
								<p id="bearingHelp" class="mt-3 text-xs text-body font-mono" aria-live="polite">
									Set a destination bearing to see turn guidance.
								</p>
							</div>
						</section>

						<!-- Location Details -->
						<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="status-title">
							<h2 id="status-title" class="text-xs font-mono uppercase text-muted tracking-wider">Observer Coordinates</h2>
							<div class="mt-4">
								<LocationPrompt />
							</div>
						</section>

						<!-- Calibration Guidance -->
						<section id="calibrate" class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="calibrate-title">
							<h2 id="calibrate-title" class="text-xs font-mono uppercase text-muted tracking-wider">Calibration Guide</h2>
							<ul class="mt-3 grid gap-2 text-xs text-body leading-relaxed">
								<li class="flex items-start gap-1.5 pt-2 border-t border-hairline">
									<span class="text-ink">1.</span> Flat surface: Keep the screen parallel to the floor.
								</li>
								<li class="flex items-start gap-1.5 pt-2 border-t border-hairline">
									<span class="text-ink">2.</span> Clear fields: Avoid headphones, metallic cases, or car consoles.
								</li>
								<li class="flex items-start gap-1.5 pt-2 border-t border-hairline">
									<span class="text-ink">3.</span> Figure-8 motion: Swing the device in an infinity loop if unstable.
								</li>
							</ul>
						</section>
					</aside>
				</div>
			</section>

			<!-- Features Section -->
			<section id="features" class="border-t border-hairline bg-canvas py-12 sm:py-16">
				<div class="content-grid">
					<div class="max-w-2xl">
						<p class="font-mono text-xs uppercase text-muted tracking-widest">Built-In Engineering</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Better than a static instrument.</h2>
						<p class="mt-3 text-xs sm:text-sm text-body leading-relaxed">
							Standard browser dials just show raw orientation. Truly Compass adds advanced user features to handle browser permission lockouts, screen pixel details, and dynamic sky projections.
						</p>
					</div>
					<div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
						{improvements.map(([title, body]) => (
							<article class="rounded border border-hairline bg-canvas-soft-2 p-5 transition-colors hover:border-muted">
								<h3 class="text-sm font-semibold text-ink font-mono">{title}</h3>
								<p class="mt-3 text-xs leading-relaxed text-body">{body}</p>
							</article>
						))}
					</div>
				</div>
			</section>

			<!-- Ad Slot: Horizontal -->
			<section class="content-grid py-6">
				<AdSlot id="ad-home-mid" format="horizontal" />
			</section>

			<!-- Technical Overview -->
			<section class="border-t border-hairline bg-canvas-soft py-12 sm:py-16" aria-labelledby="how-title">
				<div class="content-grid grid gap-8 lg:grid-cols-[300px_minmax(0,1fr)]">
					<div>
						<p class="font-mono text-xs uppercase text-muted tracking-widest">How It Works</p>
						<h2 id="how-title" class="mt-3 text-2xl font-semibold tracking-tight text-ink">Browser-side computing.</h2>
					</div>
					<div class="grid gap-4 text-xs sm:text-sm leading-relaxed text-body">
						<p>
							The browser captures orientation values from the absolute motion sensors. The compass rose rotates inversely relative to the heading angles, locking the needle to the top of the interface. Coordinates are queried locally, keeping location data fully private.
						</p>
						<p>
							Astronomy views integrate formulas to map altitude and azimuth dynamically, presenting sunrise, sunset, and moon phases without requiring third-party server computations.
						</p>
					</div>
				</div>
			</section>

			<!-- FAQ Accordion -->
			<section id="faq" class="border-t border-hairline bg-canvas py-12 sm:py-16">
				<div class="content-grid">
					<div class="max-w-2xl">
						<p class="font-mono text-xs uppercase text-muted tracking-widest">FAQ</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Frequently asked questions.</h2>
					</div>
					<div class="mt-8 grid gap-3">
						{faqs.map(([question, answer]) => (
							<details class="group rounded border border-hairline bg-canvas-soft-2 p-4 transition-colors [&_summary]:open:text-ink">
								<summary class="focus-ring cursor-pointer list-none text-xs font-semibold text-body hover:text-ink font-mono flex items-center justify-between">
									<span>{question}</span>
									<span class="text-[14px] text-muted transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
								</summary>
								<p class="mt-3 text-xs leading-relaxed text-body border-t border-hairline pt-3">{answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
			<!-- Ad Slot: Horizontal -->
			<section class="content-grid py-6">
				<AdSlot id="ad-home-bottom" format="horizontal" />
			</section>

			<!-- Comprehensive SEO Content Section -->
			<section class="border-t border-hairline bg-canvas-soft py-12 sm:py-16">
				<div class="content-grid prose prose-sm max-w-3xl mx-auto">
					<h2 class="text-2xl font-semibold tracking-tight text-ink sm:text-3xl mb-6">The Ultimate Free Online Compass &amp; Navigation Tool</h2>
					
					<p class="text-sm text-body leading-relaxed mb-4">
						Welcome to <strong>trulycompass.com</strong>, your complete solution for digital navigation and astronomical observations. Our <strong>free online compass</strong> is a browser-based application that requires no installation, no app downloads, and works seamlessly on smartphones, tablets, and desktop browsers. Whether you need a simple <strong>compass online</strong>, a <strong>magnetic compass</strong> for navigation, or advanced tools for astronomy and prayer times, we've got you covered.
					</p>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Free Compass for Navigation</h3>
					<p class="text-sm text-body leading-relaxed mb-4">
						Our <strong>digital compass</strong> provides real-time magnetic heading detection on any mobile device. Unlike traditional compasses, our <strong>online compass</strong> uses your phone's built-in magnetometer to display accurate bearing information. Perfect for hikers, travelers, and navigation enthusiasts, this <strong>compass for phone</strong> works without any external app installation—simply open your browser and access it anywhere. The <strong>browser compass</strong> features a highly accurate <strong>magnetic compass</strong> interface that rivals dedicated navigation applications.
					</p>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Sun Position Tracking &amp; Astronomy</h3>
					<p class="text-sm text-body leading-relaxed mb-4">
						Track the sun's position in real-time with our advanced <strong>sun position</strong> tracker. Get precise information about <strong>sun altitude</strong> and <strong>azimuth</strong>, calculate <strong>sunset sunrise times</strong> for any location, and plan your day accordingly. The sun page now combines weather, humidity, wind, UV index, and solar altitude into a practical <strong>heat risk</strong> reading for outdoor planning. Our <strong>golden hour calculator</strong> helps photographers and videographers find the perfect lighting conditions. Monitor <strong>UV index today</strong> to protect your skin, and use our <strong>day length calculator</strong> to understand seasonal daylight variations in your area.
					</p>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Moon Tracking &amp; Lunar Information</h3>
					<p class="text-sm text-body leading-relaxed mb-4">
						Our <strong>moon position today</strong> tracker shows the exact location of the moon in the sky, including altitude and azimuth coordinates. Track <strong>moon phases</strong> throughout the month and plan astronomical observations or cultural events. The <strong>moon phase tracker</strong> provides historical and future moon phase data, perfect for astrology enthusiasts, photographers, and anyone interested in lunar cycles.
					</p>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Islamic Prayer Times &amp; Qibla Direction</h3>
					<p class="text-sm text-body leading-relaxed mb-4">
						For Muslim users, we offer <strong>prayer times today</strong> and <strong>islamic prayer times</strong> calculations for any location on Earth. Our tool displays accurate <strong>salah times</strong> including <strong>fajr</strong> and <strong>maghrib time</strong>, allowing you to never miss a prayer. The <strong>qibla compass online</strong> feature helps you find the <strong>qibla direction</strong> with precision, ensuring your prayers are performed in the correct direction. This <strong>qibla compass</strong> is especially useful for travelers and those in unfamiliar locations.
					</p>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">GPS Coordinates &amp; Location Finder</h3>
					<p class="text-sm text-body leading-relaxed mb-4">
						Need to know your exact location? Our <strong>GPS coordinates finder</strong> tool instantly displays <strong>my current coordinates</strong> with high precision. Quickly find your <strong>latitude longitude</strong> values for any location, or search for <strong>what is my location</strong> and get complete geographic data. This <strong>latitude longitude finder</strong> is essential for geocaching, surveying, travel planning, and outdoor activities. Share your exact coordinates with friends and family using our simple interface.
					</p>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Wind Compass &amp; Bearing Calculations</h3>
					<p class="text-sm text-body leading-relaxed mb-4">
						The <strong>wind compass</strong> feature shows <strong>wind direction</strong> based on your location's weather data. Use our <strong>compass bearing</strong> calculator to determine directional angles between two points on Earth. This <strong>bearing angle calculator</strong> is invaluable for navigation, aviation, maritime activities, and outdoor expeditions. Our advanced <strong>navigation tools</strong> give you all the information needed for precise directional planning.
					</p>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Why Choose Our Free Compass?</h3>
					<ul class="text-sm text-body leading-relaxed mb-4 space-y-2">
						<li class="flex gap-2"><span class="text-ink font-bold">✓</span> <strong>Completely Free</strong> – No hidden costs, no premium features, no ads interrupting functionality</li>
						<li class="flex gap-2"><span class="text-ink font-bold">✓</span> <strong>No App Installation</strong> – Works directly in your web browser on any device</li>
						<li class="flex gap-2"><span class="text-ink font-bold">✓</span> <strong>Privacy First</strong> – All calculations run locally in your browser; your location data is never sent to our servers</li>
						<li class="flex gap-2"><span class="text-ink font-bold">✓</span> <strong>Highly Accurate</strong> – Uses your device's native sensors for precise measurements</li>
						<li class="flex gap-2"><span class="text-ink font-bold">✓</span> <strong>Mobile Optimized</strong> – Beautiful, responsive design works perfectly on phones and tablets</li>
						<li class="flex gap-2"><span class="text-ink font-bold">✓</span> <strong>Multi-Function</strong> – Compass, sun tracker, moon tracker, prayer times, and more in one app</li>
					</ul>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Perfect For:</h3>
					<ul class="text-sm text-body leading-relaxed mb-4 space-y-2">
						<li>Hikers and outdoor adventurers needing reliable navigation</li>
						<li>Travelers wanting to find their location and bearings</li>
						<li>Photographers seeking golden hour times for perfect lighting</li>
						<li>Astronomers tracking celestial bodies and planning observations</li>
						<li>Muslim users finding prayer times and qibla direction</li>
						<li>Geocachers and treasure hunters locating coordinates</li>
						<li>Students learning about compass bearings and navigation</li>
						<li>Developers testing compass functionality in web applications</li>
					</ul>

					<h3 class="text-lg font-semibold text-ink mt-8 mb-4">Get Started Today</h3>
					<p class="text-sm text-body leading-relaxed">
						Ready to navigate the world? Simply enable the compass on your device and start exploring. Whether you need a <strong>north finder</strong>, a way to <strong>find qibla</strong>, or complete astronomical data, our <strong>free online compass</strong> provides everything you need—no installation required. Visit trulycompass.com from any device and experience the future of web-based navigation.
					</p>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
	import { mountDeviceUi } from '../scripts/device-ui';
	import { mountCompass } from '../scripts/compass';
	import { prefetchLocationSilently } from '../lib/geo';

	// Prefetch location early so it's cached for sun/moon pages
	prefetchLocationSilently();

	mountDeviceUi();
	mountCompass();
</script>

<style>
	/* Mesh gradient backdrop */
	.mesh-gradient-bg {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1400px;
		height: 600px;
		opacity: 0.12;
		filter: blur(120px);
		background: 
			radial-gradient(circle at 10% 20%, #007cf0 0%, transparent 40%),
			radial-gradient(circle at 90% 30%, #00dfd8 0%, transparent 45%),
			radial-gradient(circle at 35% 70%, #7928ca 0%, transparent 40%),
			radial-gradient(circle at 65% 15%, #ff0080 0%, transparent 40%),
			radial-gradient(circle at 50% 50%, #f9cb28 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}

	[data-theme="light"] .mesh-gradient-bg {
		opacity: 0.08;
	}

	.compass-shell {
		--compass-size: min(72vw, 360px);
		position: relative;
		width: var(--compass-size);
		aspect-ratio: 1;
		border: 1px solid var(--color-hairline-strong);
		border-radius: 50%;
		background:
			radial-gradient(circle at center, #0d0d11 0 20%, transparent 20.5%),
			radial-gradient(circle at center, transparent 0 58%, rgba(255, 255, 255, 0.03) 58.4% 59.2%, transparent 59.8%),
			#131318;
		box-shadow: 
			inset 0 0 0 10px #131318, 
			inset 0 0 0 11px var(--color-hairline),
			0 24px 60px rgba(0, 0, 0, 0.5),
			0 0 40px rgba(255, 255, 255, 0.02);
		overflow: hidden;
	}

	[data-theme="light"] .compass-shell {
		background:
