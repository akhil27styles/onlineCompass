---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DevicePanel from '../components/DevicePanel.astro';

const tickMarks = Array.from({ length: 72 }, (_, index) => ({
	angle: index * 5,
	major: index % 6 === 0,
}));

const directionLabels = [
	{ label: 'N', angle: 0 },
	{ label: 'NE', angle: 45 },
	{ label: 'E', angle: 90 },
	{ label: 'SE', angle: 135 },
	{ label: 'S', angle: 180 },
	{ label: 'SW', angle: 225 },
	{ label: 'W', angle: 270 },
	{ label: 'NW', angle: 315 },
];

const improvements = [
	['Device Fit', 'Detects viewport, DPR, orientation, and estimated screen diagonal so the instrument feels native on phones first.'],
	['Auto Location', 'Requests your coordinates on load for context on compass, sun, and moon tools — with clear permission states.'],
	['Sun & Moon', 'Dedicated sun and moon position pages with azimuth, altitude, rise/set times, and phase data.'],
	['Bearing Target', 'Pin a target heading and see the turn direction needed to line up with it.'],
	['Privacy Local', 'Compass readings stay in the browser. Location is optional and never uploaded to a server.'],
	['Desktop Fallback', 'Provides a demo heading control when the current device has no magnetometer.'],
];

const faqs = [
	['Does Online Compass work on every device?', 'It works best on phones and tablets with a magnetometer and device-orientation support. Desktop browsers usually do not include the sensor, so this page includes a demo fallback.'],
	['Is this true north or magnetic north?', 'Device sensors report magnetic heading. True north needs a location-based declination correction, so the site clearly separates live magnetic heading from optional location context.'],
	['Why does the compass ask for permission?', 'Modern browsers, especially iOS Safari, require a tap before sharing orientation sensor readings. Location is requested separately for sun and moon tools.'],
	['How do I improve compass accuracy?', 'Hold the phone flat, move away from metal and speakers, remove magnetic cases, and calibrate by slowly moving the phone in a figure-eight pattern.'],
];
---

<Layout>
	<SiteHeader current="compass" />

	<main id="main">
		<section class="border-b border-hairline bg-canvas-soft pt-8 pb-6 sm:pt-12 lg:pb-14">
			<div class="content-grid grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
				<div class="min-w-0">
					<p class="font-mono text-xs uppercase text-muted" translate="no">freeOnlinecompass.com</p>
					<h1 class="mt-3 max-w-3xl text-balance text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl lg:text-6xl">
						Online Compass
					</h1>
					<p class="mt-4 max-w-2xl text-pretty text-base leading-7 text-body sm:text-lg">
						A mobile-first browser compass with live heading, automatic device and location detection, sun and moon position tools, and calibration guidance.
					</p>
					<p
						id="mobileDeviceSummary"
						class="mt-4 inline-flex max-w-full rounded-full border border-hairline bg-white px-3 py-1.5 font-mono text-xs text-body lg:hidden"
						aria-live="polite"
					>
						Detecting device…
					</p>
				</div>
				<DevicePanel />
			</div>
		</section>

		<section id="compass" class="bg-white py-6 sm:py-12">
			<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
				<section class="rounded-panel border border-hairline bg-white p-4 shadow-[0_16px_60px_rgba(0,0,0,0.06)] sm:p-6" aria-labelledby="compass-title">
					<div class="flex flex-wrap items-start justify-between gap-4">
						<div>
							<p class="font-mono text-xs uppercase text-muted">Live Instrument</p>
							<h2 id="compass-title" class="mt-1 text-2xl font-semibold tracking-tight">Find North Fast</h2>
						</div>
						<div class="rounded-full border border-hairline bg-canvas-soft px-3 py-1.5 font-mono text-xs text-body" aria-live="polite">
							<span id="modeLabel">Magnetic Heading</span>
						</div>
					</div>

					<div class="mt-6 grid place-items-center">
						<div class="compass-shell" aria-label="Compass dial showing heading">
							<div class="compass-rose" id="compassRose">
								{tickMarks.map((tick) => (
									<span
										class:list={['tick', tick.major && 'tick-major']}
										style={`--tick-angle:${tick.angle}deg`}
										aria-hidden="true"
									/>
								))}
								{directionLabels.map((direction) => (
									<span
										class:list={['direction-label', direction.label === 'N' && 'north-label']}
										style={`--label-angle:${direction.angle}deg`}
									>
										{direction.label}
									</span>
								))}
							</div>
							<div class="fixed-needle" aria-hidden="true">
								<span></span>
							</div>
							<div class="heading-readout">
								<p id="cardinalDirection">--</p>
								<strong><span id="headingDegrees">--</span><span aria-hidden="true">°</span></strong>
							</div>
						</div>
					</div>

					<div class="mt-6 grid gap-3 sm:grid-cols-2">
						<button id="enableCompass" class="focus-ring rounded-md bg-ink px-4 py-3 text-sm font-semibold text-white transition-colors duration-150 hover:bg-black" type="button">
							Enable Compass
						</button>
						<button id="demoMode" class="focus-ring rounded-md border border-hairline bg-white px-4 py-3 text-sm font-semibold text-ink transition-colors duration-150 hover:border-hairline-strong hover:bg-canvas-soft" type="button">
							Try Demo Heading
						</button>
					</div>

					<div class="mt-5 border-t border-hairline pt-5">
						<label class="flex items-center justify-between gap-4 text-sm font-medium" for="targetBearing">
							<span>Target Bearing</span>
							<span class="font-mono text-body"><span id="targetBearingValue">0</span>°</span>
						</label>
						<input id="targetBearing" class="mt-3 w-full accent-ink" type="range" min="0" max="359" value="0" name="target-bearing" aria-describedby="bearingHelp" />
						<p id="bearingHelp" class="mt-2 text-sm text-body" aria-live="polite">
							Set a destination bearing to see turn guidance.
						</p>
					</div>
				</section>

				<aside class="grid gap-6">
					<section class="rounded-panel border border-hairline bg-canvas-soft p-4" aria-labelledby="status-title">
						<h2 id="status-title" class="text-sm font-semibold">Live Status</h2>
						<div class="mt-4 grid gap-3 text-sm">
							<p id="statusMessage" class="rounded-md border border-hairline bg-white p-3 text-body" aria-live="polite">
								Tap Enable Compass to request sensor access.
							</p>
							<p id="locationResult" class="text-sm leading-6 text-body" aria-live="polite">
								Detecting your location automatically…
							</p>
							<button
								id="retryLocation"
								class="focus-ring rounded-md border border-hairline bg-white px-4 py-3 text-left text-sm font-semibold transition-colors duration-150 hover:border-hairline-strong"
								type="button"
							>
								Retry Location
							</button>
						</div>
					</section>

					<section class="rounded-panel border border-hairline bg-white p-4" aria-labelledby="sky-tools-title">
						<h2 id="sky-tools-title" class="text-sm font-semibold">Sun & Moon Tools</h2>
						<p class="mt-3 text-sm leading-6 text-body">
							Use your detected location for live sky position pages.
						</p>
						<div class="mt-4 grid gap-2">
							<a class="focus-ring rounded-md bg-ink px-4 py-3 text-center text-sm font-semibold text-white hover:bg-black" href="/sun-position/">
								Sun Position
							</a>
							<a class="focus-ring rounded-md border border-hairline bg-white px-4 py-3 text-center text-sm font-semibold hover:border-hairline-strong hover:bg-canvas-soft" href="/moon-position/">
								Moon Position
							</a>
						</div>
					</section>

					<section id="calibrate" class="rounded-panel border border-hairline bg-white p-4" aria-labelledby="calibrate-title">
						<h2 id="calibrate-title" class="text-sm font-semibold">Calibration Checklist</h2>
						<ul class="mt-4 grid gap-3 text-sm leading-6 text-body">
							<li class="border-t border-hairline pt-3">Hold your phone flat, parallel to the ground.</li>
							<li class="border-t border-hairline pt-3">Move away from speakers, magnets, metal desks, and car dashboards.</li>
							<li class="border-t border-hairline pt-3">Move the phone in a slow figure-eight if heading feels unstable.</li>
						</ul>
					</section>
				</aside>
			</div>
		</section>

		<section id="features" class="border-y border-hairline bg-canvas-soft py-10 sm:py-14">
			<div class="content-grid">
				<div class="max-w-2xl">
					<p class="font-mono text-xs uppercase text-muted">Better Than a Basic Dial</p>
					<h2 class="mt-2 text-balance text-3xl font-semibold tracking-tight">Built for the real reasons online compasses fail.</h2>
					<p class="mt-3 text-pretty leading-7 text-body">
						Most compass pages stop at a dial. Online Compass adds device support, permissions, screen size, sun and moon context, fallback behavior, and privacy.
					</p>
				</div>
				<div class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
					{improvements.map(([title, body]) => (
						<article class="rounded-panel border border-hairline bg-white p-5 shadow-[inset_0_0_0_1px_rgba(0,0,0,0.02),0_2px_8px_rgba(0,0,0,0.04)]">
							<h3 class="text-base font-semibold">{title}</h3>
							<p class="mt-3 text-sm leading-6 text-body">{body}</p>
						</article>
					))}
				</div>
			</div>
		</section>

		<section class="bg-white py-10 sm:py-14" aria-labelledby="how-title">
			<div class="content-grid grid gap-8 lg:grid-cols-[360px_minmax(0,1fr)]">
				<div>
					<p class="font-mono text-xs uppercase text-muted">How It Works</p>
					<h2 id="how-title" class="mt-2 text-3xl font-semibold tracking-tight">Sensors first, privacy always.</h2>
				</div>
				<div class="grid gap-4">
					<p class="text-pretty leading-7 text-body">
						The browser reads device orientation data from your phone’s motion and magnetometer sensors, then rotates the compass rose against a fixed top marker. Heading data stays on your device — no account or app install required.
					</p>
					<p class="text-pretty leading-7 text-body">
						Location is detected automatically when you allow it, powering sun and moon position pages. The layout adapts from your screen diagonal before permissions are requested.
					</p>
				</div>
			</div>
		</section>

		<section id="faq" class="border-t border-hairline bg-canvas-soft py-10 sm:py-14">
			<div class="content-grid">
				<div class="max-w-2xl">
					<p class="font-mono text-xs uppercase text-muted">Questions</p>
					<h2 class="mt-2 text-3xl font-semibold tracking-tight">Online Compass FAQ</h2>
				</div>
				<div class="mt-8 grid gap-3">
					{faqs.map(([question, answer]) => (
						<details class="group rounded-panel border border-hairline bg-white p-5">
							<summary class="focus-ring cursor-pointer list-none rounded-md text-base font-semibold">
								{question}
								<span class="float-right ml-4 text-muted transition-transform duration-150 group-open:rotate-45" aria-hidden="true">+</span>
							</summary>
							<p class="mt-3 text-sm leading-6 text-body">{answer}</p>
						</details>
					))}
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<script>
	import { formatCoords } from '../lib/geo';
	import { mountDeviceUi } from '../scripts/device-ui';
	import { mountCompass } from '../scripts/compass';

	const locationResult = document.querySelector('#locationResult');

	function setText(el: Element | null, value: string) {
		if (el) el.textContent = value;
	}

	const { detectLocation } = mountDeviceUi({
		onLocation: (coords) => {
			setText(
				locationResult,
				`${formatCoords(coords)}. Used for sun, moon, and context — heading stays local.`,
			);
		},
	});

	document.addEventListener('oc:location-denied', (event) => {
		const detail = (event as CustomEvent<{ message: string }>).detail;
		setText(locationResult, `${detail.message} Compass still works with device sensors.`);
	});

	document.querySelector('#retryLocation')?.addEventListener('click', async () => {
		setText(locationResult, 'Detecting location…');
		await detectLocation();
	});

	mountCompass();
</script>

<style>
	.compass-shell {
		--compass-size: min(78vw, 430px);
		position: relative;
		width: var(--compass-size);
		aspect-ratio: 1;
		border: 1px solid var(--color-hairline);
		border-radius: 50%;
		background:
			radial-gradient(circle at center, #ffffff 0 18%, transparent 18.5%),
			radial-gradient(circle at center, transparent 0 58%, color-mix(in srgb, var(--color-link) 10%, transparent) 58.4% 59.2%, transparent 59.8%),
			linear-gradient(135deg, color-mix(in srgb, var(--color-cyan-accent) 14%, #ffffff), #ffffff 42%, color-mix(in srgb, var(--color-pink-accent) 10%, #ffffff));
		box-shadow: inset 0 0 0 10px #ffffff, inset 0 0 0 11px var(--color-hairline), 0 24px 70px rgba(0, 0, 0, 0.08);
		overflow: hidden;
	}

	.compass-rose {
		--heading: 0;
		position: absolute;
		inset: 16px;
		border-radius: 50%;
		transform: rotate(calc(var(--heading) * -1deg));
		transition: transform 120ms linear;
		will-change: transform;
	}

	.tick {
		position: absolute;
		top: 50%;
		left: 50%;
		width: 1px;
		height: 8px;
		background: var(--color-hairline-strong);
		transform: rotate(var(--tick-angle)) translateY(calc(var(--compass-size) * -0.42));
		transform-origin: center;
	}

	.tick-major {
		width: 2px;
		height: 18px;
		background: var(--color-ink);
	}

	.direction-label {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		width: 38px;
		height: 24px;
		place-items: center;
		margin: -12px 0 0 -19px;
		color: var(--color-body);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
		transform: rotate(var(--label-angle)) translateY(calc(var(--compass-size) * -0.34)) rotate(calc(var(--label-angle) * -1));
		transform-origin: center;
	}

	.north-label {
		color: #ee0000;
	}

	.fixed-needle {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: start center;
		pointer-events: none;
	}

	.fixed-needle span {
		width: 0;
		height: 0;
		margin-top: 20px;
		border-right: 12px solid transparent;
		border-bottom: 34px solid #ee0000;
		border-left: 12px solid transparent;
		filter: drop-shadow(0 4px 10px rgba(238, 0, 0, 0.24));
	}

	.heading-readout {
		position: absolute;
		top: 50%;
		left: 50%;
		display: grid;
		width: min(40vw, 156px);
		aspect-ratio: 1;
		place-items: center;
		translate: -50% -50%;
		border: 1px solid var(--color-hairline);
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.92);
		text-align: center;
	}

	.heading-readout p {
		margin: 0;
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 600;
	}

	.heading-readout strong {
		display: block;
		margin-top: -28px;
		font-size: clamp(38px, 12vw, 56px);
		font-weight: 650;
		line-height: 1;
	}

	@media (prefers-reduced-motion: reduce) {
		.compass-rose,
		.group-open\:rotate-45 {
			transition-duration: 0.01ms;
		}
	}
</style>
