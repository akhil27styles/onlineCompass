			radial-gradient(ellipse at 50% 50%, rgba(8, 15, 35, 0.4) 0%, transparent 70%),
			linear-gradient(180deg, #000000 0%, #050515 30%, #0a0a1e 60%, #000005 100%);
	}

	.solar-panel {
		background: rgba(10, 12, 30, 0.75);
		backdrop-filter: blur(20px);
		-webkit-backdrop-filter: blur(20px);
		border: 1px solid rgba(255, 255, 255, 0.08);
		box-shadow:
