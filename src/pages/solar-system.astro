---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
---

<Layout
	title="3D Solar System Explorer — Interactive Planet Viewer"
	description="Explore our solar system in stunning 3D. View planets, moons, and satellites with real-time orbits and detailed information. Interactive space exploration."
	keywords="3D solar system, planets, space, astronomy, solar system explorer, interactive planets"
	canonical="https://freeonlinecompass.com/solar-system/"
>
	<SeoJsonLd
		slot="head"
		name="3D Solar System — Online Compass"
		description="Interactive 3D solar system with planets, moons, and satellites."
		url="https://freeonlinecompass.com/solar-system/"
	/>
	<div class="relative min-h-screen flex flex-col overflow-hidden bg-canvas-soft">
		<SiteShell current="solar-system" />

		<main id="main" class="flex-grow relative">
			<!-- 3D Canvas -->
			<div id="solarSystemCanvas" class="fixed inset-0 z-0"></div>

			<!-- Loading Overlay -->
			<div id="loadingOverlay" class="fixed inset-0 z-50 flex flex-col items-center justify-center" style="background: radial-gradient(ellipse at 50% 40%, #0a0e27 0%, #000000 100%);">
				<div class="text-center space-y-6">
					<div class="relative w-20 h-20 mx-auto">
						<div class="absolute inset-0 rounded-full border-2 border-transparent border-t-amber-400 border-r-amber-400/50 animate-spin"></div>
						<div class="absolute inset-2 rounded-full border-2 border-transparent border-b-blue-400 border-l-blue-400/50 animate-spin" style="animation-direction: reverse; animation-duration: 1.5s;"></div>
						<div class="absolute inset-4 rounded-full bg-amber-500/20 flex items-center justify-center">
							<span class="text-2xl">☀️</span>
						</div>
					</div>
					<div>
						<h2 class="text-lg font-semibold text-white/90 tracking-wide">Initializing Solar System</h2>
						<p id="loadingText" class="text-xs text-white/50 mt-2 font-mono">Loading textures...</p>
					</div>
					<div class="w-48 mx-auto">
						<div class="h-1 bg-white/10 rounded-full overflow-hidden">
							<div id="loadingBar" class="h-full bg-gradient-to-r from-amber-500 via-orange-400 to-amber-500 rounded-full transition-all duration-500 ease-out" style="width: 0%;"></div>
						</div>
						<p id="loadingPercent" class="text-[10px] text-white/30 mt-1.5 font-mono text-right">0%</p>
					</div>
				</div>
			</div>

			<!-- UI Overlay -->
			<div class="relative z-10 pointer-events-none">
				<!-- Header Info -->
				<div class="content-grid pt-4 sm:pt-6 pb-3 sm:pb-4 pointer-events-auto">
					<div class="flex items-center justify-between gap-2 sm:gap-4 solar-panel rounded-xl p-3 sm:p-4">
						<div class="min-w-0">
							<h1 class="text-lg sm:text-2xl font-semibold tracking-tight text-white truncate">🪐 3D Solar System</h1>
							<p class="text-[10px] sm:text-xs text-white/50 mt-0.5 sm:mt-1">Explore planets, moons & satellites in real-time</p>
						</div>
						<div class="flex items-center gap-2">
							<button id="resetCamera" class="shrink-0 rounded-lg bg-white/10 hover:bg-white/20 backdrop-blur-sm px-3 sm:px-4 py-2 text-xs sm:text-sm font-semibold text-white/90 transition-all border border-white/10">
								<span class="hidden sm:inline">⟲ Reset View</span>
								<span class="sm:hidden">⟲</span>
							</button>
						</div>
					</div>
				</div>

				<!-- Planet Info Panel (initially hidden) -->
				<div id="planetInfo" class="fixed right-2 sm:right-4 top-20 sm:top-24 w-[calc(100%-1rem)] sm:w-80 max-w-sm solar-panel rounded-xl p-4 sm:p-5 shadow-2xl hidden pointer-events-auto max-h-[60vh] sm:max-h-[70vh] overflow-y-auto">
					<div class="flex items-start justify-between gap-3 mb-3 sm:mb-4">
						<div class="flex items-center gap-3 flex-1 min-w-0">
							<img id="planetImage" src="" alt="" class="w-10 h-10 sm:w-12 sm:h-12 rounded-full object-cover border-2 border-white/20 shadow-lg" />
							<div class="min-w-0">
								<h2 id="planetName" class="text-lg sm:text-xl font-semibold text-white truncate">Planet Name</h2>
								<p id="planetType" class="text-[10px] sm:text-xs text-white/40 uppercase tracking-wider mt-0.5 sm:mt-1 font-mono">Type</p>
							</div>
						</div>
						<button id="closeInfo" class="shrink-0 text-white/40 hover:text-white transition-colors p-1">
							<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
							</svg>
						</button>
					</div>
					
					<div class="space-y-2 sm:space-y-3 text-xs sm:text-sm">
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-white/10">
							<span class="text-white/50">Diameter</span>
							<span id="planetDiameter" class="text-white/90 font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-white/10">
							<span class="text-white/50">Distance from Sun</span>
							<span id="planetDistance" class="text-white/90 font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-white/10">
							<span class="text-white/50">Orbital Period</span>
							<span id="planetPeriod" class="text-white/90 font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-white/10">
							<span class="text-white/50">Rotation Period</span>
							<span id="planetRotation" class="text-white/90 font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-white/10">
							<span class="text-white/50">Moons</span>
							<span id="planetMoons" class="text-white/90 font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="pt-2">
							<p id="planetDescription" class="text-[11px] sm:text-xs text-white/50 leading-relaxed">--</p>
						</div>
					</div>
				</div>

				<!-- Controls Panel - Hidden on small mobile -->
				<div class="hidden sm:block fixed left-4 bottom-28 solar-panel rounded-xl p-4 pointer-events-auto">
					<p class="text-xs font-mono uppercase text-white/30 tracking-wider mb-3">Controls</p>
					<div class="space-y-2 text-xs text-white/60">
						<div class="flex items-center gap-2">
							<kbd class="px-2 py-1 bg-white/5 rounded border border-white/10 font-mono text-white/80 text-[10px]">Drag</kbd>
							<span>Rotate</span>
						</div>
						<div class="flex items-center gap-2">
							<kbd class="px-2 py-1 bg-white/5 rounded border border-white/10 font-mono text-white/80 text-[10px]">Scroll</kbd>
							<span>Zoom</span>
						</div>
						<div class="flex items-center gap-2">
							<kbd class="px-2 py-1 bg-white/5 rounded border border-white/10 font-mono text-white/80 text-[10px]">Click</kbd>
							<span>Select</span>
						</div>
					</div>
					<!-- Toggles -->
					<div class="mt-4 pt-3 border-t border-white/10 space-y-2">
						<label class="flex items-center gap-2 cursor-pointer group">
							<input type="checkbox" id="toggleOrbits" checked class="accent-amber-500 w-3 h-3" />
							<span class="text-[11px] text-white/50 group-hover:text-white/70 transition-colors">Orbits</span>
						</label>
						<label class="flex items-center gap-2 cursor-pointer group">
							<input type="checkbox" id="toggleLabels" checked class="accent-amber-500 w-3 h-3" />
							<span class="text-[11px] text-white/50 group-hover:text-white/70 transition-colors">Labels</span>
						</label>
						<label class="flex items-center gap-2 cursor-pointer group">
							<input type="checkbox" id="toggleTrails" checked class="accent-amber-500 w-3 h-3" />
							<span class="text-[11px] text-white/50 group-hover:text-white/70 transition-colors">Sat. Trails</span>
						</label>
					</div>
				</div>

				<!-- Speed Control -->
				<div class="fixed left-1/2 -translate-x-1/2 bottom-[4.5rem] sm:bottom-20 solar-panel rounded-full px-4 py-2 pointer-events-auto flex items-center gap-3">
					<span class="text-[10px] text-white/30 font-mono">🐢</span>
					<input type="range" id="speedSlider" min="0" max="200" value="100" class="w-20 sm:w-28 accent-amber-500 h-1" />
					<span class="text-[10px] text-white/30 font-mono">🐇</span>
					<span id="speedLabel" class="text-[10px] text-white/40 font-mono ml-1 min-w-[2rem]">1.0×</span>
				</div>

				<!-- Quick Planet Navigation - Mobile Optimized with Real Images & 3D Effects -->
				<div class="fixed bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 solar-panel rounded-full px-2 sm:px-4 py-1.5 sm:py-2 pointer-events-auto overflow-x-auto max-w-[95vw] shadow-2xl" style="perspective: 1000px;">
					<div class="flex items-center gap-1.5 sm:gap-2">
						<button class="planet-quick-nav planet-icon w-7 h-7 sm:w-8 sm:h-8 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-yellow-400 shadow-lg hover:shadow-yellow-400/50" data-planet="sun" title="Sun" style="box-shadow: 0 0 12px rgba(253, 184, 19, 0.4), inset 0 0 8px rgba(253, 184, 19, 0.2); transform-style: preserve-3d;">
							<img src="/images/sun.jpeg" alt="Sun" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-5 h-5 sm:w-6 sm:h-6 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-gray-400 shadow-lg hover:shadow-gray-400/50" data-planet="mercury" title="Mercury" style="box-shadow: 0 0 8px rgba(156, 120, 83, 0.3), inset 0 0 6px rgba(156, 120, 83, 0.1);">
							<img src="/images/mercury.jpeg" alt="Mercury" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-orange-300 shadow-lg hover:shadow-orange-300/50" data-planet="venus" title="Venus" style="box-shadow: 0 0 10px rgba(255, 198, 73, 0.4), inset 0 0 6px rgba(255, 198, 73, 0.15);">
							<img src="/images/venus.jpeg" alt="Venus" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-blue-400 shadow-lg hover:shadow-blue-400/50" data-planet="earth" title="Earth" style="box-shadow: 0 0 10px rgba(34, 51, 255, 0.4), inset 0 0 6px rgba(34, 51, 255, 0.15);">
							<img src="/images/earth.jpeg" alt="Earth" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-5 h-5 sm:w-6 sm:h-6 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-red-400 shadow-lg hover:shadow-red-400/50" data-planet="mars" title="Mars" style="box-shadow: 0 0 8px rgba(220, 20, 60, 0.3), inset 0 0 6px rgba(220, 20, 60, 0.1);">
							<img src="/images/mars.jpeg" alt="Mars" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-7 h-7 sm:w-9 sm:h-9 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-orange-200 shadow-lg hover:shadow-orange-200/50" data-planet="jupiter" title="Jupiter" style="box-shadow: 0 0 12px rgba(255, 165, 0, 0.4), inset 0 0 8px rgba(255, 165, 0, 0.15);">
							<img src="/images/jupiter.jpeg" alt="Jupiter" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-7 h-7 sm:w-8 sm:h-8 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-yellow-300 shadow-lg hover:shadow-yellow-300/50" data-planet="saturn" title="Saturn" style="box-shadow: 0 0 12px rgba(255, 215, 0, 0.4), inset 0 0 8px rgba(255, 215, 0, 0.15);">
							<img src="/images/saturn.jpeg" alt="Saturn" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-cyan-300 shadow-lg hover:shadow-cyan-300/50" data-planet="uranus" title="Uranus" style="box-shadow: 0 0 10px rgba(79, 208, 224, 0.3), inset 0 0 6px rgba(79, 208, 224, 0.1);">
							<img src="/images/uranus.png" alt="Uranus" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-all duration-200 shrink-0 overflow-hidden border-2 border-blue-500 shadow-lg hover:shadow-blue-500/50" data-planet="neptune" title="Neptune" style="box-shadow: 0 0 10px rgba(30, 144, 255, 0.4), inset 0 0 6px rgba(30, 144, 255, 0.15);">
							<img src="/images/neptune.jpeg" alt="Neptune" class="w-full h-full object-cover" />
						</button>
					</div>
				</div>
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
	import * as THREE from 'three';
	import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
	import { EffectComposer } from 'three/examples/jsm/postprocessing/EffectComposer.js';
	import { RenderPass } from 'three/examples/jsm/postprocessing/RenderPass.js';
	import { UnrealBloomPass } from 'three/examples/jsm/postprocessing/UnrealBloomPass.js';

	// ─── Planet Data ──────────────────────────────────────────────
	const planetData: Record<string, any> = {
		sun: {
			name: 'Sun', type: 'Star',
			diameter: '1,392,700 km', distanceText: '0 km',
			period: '—', rotation: '25-35 days', moons: '0',
			description: 'The Sun is the star at the center of our Solar System. It accounts for about 99.86% of the total mass of the Solar System.',
			size: 18, color: 0xfdb813, distance: 0, speed: 0,
			tilt: 7.25, image: '/images/sun.jpeg'
		},
		mercury: {
			name: 'Mercury', type: 'Terrestrial Planet',
			diameter: '4,879 km', distanceText: '57.9 million km',
			period: '88 days', rotation: '59 days', moons: '0',
			description: 'Mercury is the smallest planet in our solar system and closest to the Sun. It has a very thin atmosphere and extreme temperature swings.',
			size: 2.4, color: 0x8c7853, distance: 38, speed: 0.04,
			tilt: 0.034, image: '/images/mercury.jpeg'
		},
		venus: {
			name: 'Venus', type: 'Terrestrial Planet',
			diameter: '12,104 km', distanceText: '108.2 million km',
			period: '225 days', rotation: '243 days', moons: '0',
			description: 'Venus is the hottest planet in our solar system with surface temperatures hot enough to melt lead. It rotates in the opposite direction.',
			size: 3.2, color: 0xffc649, distance: 52, speed: 0.03,
			tilt: 177.4, image: '/images/venus.jpeg'
		},
		earth: {
			name: 'Earth', type: 'Terrestrial Planet',
			diameter: '12,742 km', distanceText: '149.6 million km',
			period: '365.25 days', rotation: '24 hours', moons: '1 (Moon)',
			description: 'Earth is our home planet, the only known planet to harbor life. It has one natural satellite, the Moon, and is covered 71% by water.',
			size: 3.5, color: 0x2233ff, distance: 68, speed: 0.025,
			tilt: 23.44, hasMoon: true, image: '/images/earth.jpeg'
		},
		mars: {
			name: 'Mars', type: 'Terrestrial Planet',
			diameter: '6,779 km', distanceText: '227.9 million km',
			period: '687 days', rotation: '24.6 hours', moons: '2 (Phobos, Deimos)',
			description: 'Mars is known as the Red Planet due to iron oxide on its surface. It has the largest volcano in the solar system, Olympus Mons.',
			size: 2.8, color: 0xdc143c, distance: 84, speed: 0.02,
			tilt: 25.19, image: '/images/mars.jpeg'
		},
		jupiter: {
			name: 'Jupiter', type: 'Gas Giant',
			diameter: '139,820 km', distanceText: '778.5 million km',
			period: '11.86 years', rotation: '9.9 hours', moons: '95+',
			description: 'Jupiter is the largest planet in our solar system. Its famous Great Red Spot is a giant storm larger than Earth.',
			size: 10, color: 0xffa500, distance: 125, speed: 0.013,
			tilt: 3.13, image: '/images/jupiter.jpeg'
		},
		saturn: {
			name: 'Saturn', type: 'Gas Giant',
			diameter: '116,460 km', distanceText: '1.43 billion km',
			period: '29.46 years', rotation: '10.7 hours', moons: '146+',
			description: 'Saturn is best known for its spectacular ring system made of ice and rock particles. It is the least dense planet.',
			size: 8.5, color: 0xffd700, distance: 165, speed: 0.01,
			tilt: 26.73, hasRings: true, image: '/images/saturn.jpeg'
		},
		uranus: {
			name: 'Uranus', type: 'Ice Giant',
			diameter: '50,724 km', distanceText: '2.87 billion km',
			period: '84 years', rotation: '17.2 hours', moons: '27',
			description: 'Uranus rotates on its side, likely due to a massive collision long ago. It appears blue-green due to methane.',
			size: 5, color: 0x4fd0e0, distance: 205, speed: 0.007,
			tilt: 97.77, image: '/images/uranus.png'
		},
		neptune: {
			name: 'Neptune', type: 'Ice Giant',
			diameter: '49,244 km', distanceText: '4.5 billion km',
			period: '164.8 years', rotation: '16 hours', moons: '14',
			description: 'Neptune is the windiest planet with speeds reaching 2,100 km/h. It was the first planet located through mathematical predictions.',
			size: 4.8, color: 0x1e90ff, distance: 240, speed: 0.005,
			tilt: 28.32, image: '/images/neptune.jpeg'
		}
	};

	// ─── Texture URLs ─────────────────────────────────────────────
	const textureUrls: Record<string, string> = {
		sun: '/images/sun.jpeg',
		mercury: '/images/mercury.jpeg',
		venus: '/images/venus.jpeg',
		earth: '/images/earth.jpeg',
		mars: '/images/mars.jpeg',
		jupiter: '/images/jupiter.jpeg',
		saturn: '/images/saturn.jpeg',
		uranus: '/images/uranus.png',
		neptune: '/images/neptune.jpeg',
		moon: '/images/moon.jpeg'
	};

	// ─── Scene Setup ──────────────────────────────────────────────
	const scene = new THREE.Scene();
	const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 5000);
	const renderer = new THREE.WebGLRenderer({
		antialias: true,
		alpha: false,
		powerPreference: 'high-performance'
	});

	const container = document.getElementById('solarSystemCanvas');
	if (!container) throw new Error('Canvas container not found');

	renderer.setSize(window.innerWidth, window.innerHeight);
	renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
	renderer.shadowMap.enabled = true;
	renderer.shadowMap.type = THREE.PCFSoftShadowMap;
	renderer.toneMapping = THREE.ACESFilmicToneMapping;
	renderer.toneMappingExposure = 1.2;
	renderer.outputColorSpace = THREE.SRGBColorSpace;
	container.appendChild(renderer.domElement);

	// ─── Post-Processing (Bloom) ──────────────────────────────────
	const composer = new EffectComposer(renderer);
	const renderPass = new RenderPass(scene, camera);
	composer.addPass(renderPass);

	const bloomPass = new UnrealBloomPass(
		new THREE.Vector2(window.innerWidth, window.innerHeight),
		0.8,   // strength
		0.4,   // radius
		0.85   // threshold
	);
	composer.addPass(bloomPass);

	// ─── Texture Loader & Progress ────────────────────────────────
	const textureLoader = new THREE.TextureLoader();
	textureLoader.crossOrigin = 'anonymous';

	let texturesLoaded = 0;
	const totalTextures = Object.keys(textureUrls).length; // 10
	const loadingBar = document.getElementById('loadingBar');
	const loadingPercent = document.getElementById('loadingPercent');
	const loadingText = document.getElementById('loadingText');
	const loadingOverlay = document.getElementById('loadingOverlay');

	function updateLoadingProgress(name: string) {
		texturesLoaded++;
		const pct = Math.round((texturesLoaded / totalTextures) * 100);
		if (loadingBar) loadingBar.style.width = `${pct}%`;
		if (loadingPercent) loadingPercent.textContent = `${pct}%`;
		if (loadingText) loadingText.textContent = `Loaded ${name}...`;
		if (texturesLoaded >= totalTextures) {
			setTimeout(() => {
				if (loadingOverlay) {
					loadingOverlay.style.transition = 'opacity 0.8s ease-out';
					loadingOverlay.style.opacity = '0';
					setTimeout(() => { loadingOverlay.style.display = 'none'; }, 800);
				}
			}, 400);
		}
	}

	function createPlanetTexture(key: string): THREE.Texture {
		const canvas = document.createElement('canvas');
		const isSunOrGas = key === 'sun' || key === 'jupiter' || key === 'saturn' || key === 'earth';
		canvas.width = isSunOrGas ? 1024 : 512;
		canvas.height = isSunOrGas ? 512 : 256;
		const ctx = canvas.getContext('2d')!;

		if (key === 'sun') {
			// Fiery Sun
			ctx.fillStyle = '#ff4d00';
			ctx.fillRect(0, 0, 1024, 512);
			for (let i = 0; i < 150; i++) {
				const x = Math.random() * 1024;
				const y = Math.random() * 512;
				const r = 25 + Math.random() * 65;
				const grad = ctx.createRadialGradient(x, y, 0, x, y, r);
				grad.addColorStop(0, 'rgba(255, 235, 10, 0.95)');
				grad.addColorStop(0.4, 'rgba(255, 140, 0, 0.45)');
				grad.addColorStop(1, 'rgba(255, 0, 0, 0)');
				ctx.fillStyle = grad;
				ctx.beginPath();
				ctx.arc(x, y, r, 0, Math.PI * 2);
				ctx.fill();
			}
		} else if (key === 'mercury') {
			// Gray, cratered Mercury
			ctx.fillStyle = '#858588';
			ctx.fillRect(0, 0, 512, 256);
			ctx.fillStyle = 'rgba(0, 0, 0, 0.12)';
			for (let i = 0; i < 20; i++) {
				ctx.beginPath();
				ctx.arc(Math.random() * 512, Math.random() * 256, 15 + Math.random() * 35, 0, Math.PI * 2);
				ctx.fill();
			}
			for (let i = 0; i < 150; i++) {
				const x = Math.random() * 512;
				const y = Math.random() * 256;
				const r = 1.5 + Math.random() * 7;
				ctx.fillStyle = 'rgba(0, 0, 0, 0.22)';
				ctx.beginPath(); ctx.arc(x, y, r, 0, Math.PI * 2); ctx.fill();
				ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
				ctx.lineWidth = 0.5;
				ctx.beginPath(); ctx.arc(x + 0.5, y + 0.5, r, 0, Math.PI * 2); ctx.stroke();
			}
		} else if (key === 'venus') {
			// Yellow-orange Venus atmosphere
			ctx.fillStyle = '#cca058';
			ctx.fillRect(0, 0, 512, 256);
			const grad = ctx.createLinearGradient(0, 0, 0, 256);
			grad.addColorStop(0, 'rgba(251, 219, 150, 0.35)');
			grad.addColorStop(0.4, 'rgba(211, 139, 39, 0.25)');
			grad.addColorStop(0.7, 'rgba(251, 219, 150, 0.45)');
			grad.addColorStop(1, 'rgba(181, 113, 22, 0.35)');
			ctx.fillStyle = grad;
			ctx.fillRect(0, 0, 512, 256);
			ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
			for (let i = 0; i < 40; i++) {
				ctx.beginPath();
				ctx.ellipse(Math.random() * 512, Math.random() * 256, 50 + Math.random() * 120, 5 + Math.random() * 10, Math.random() * 0.15, 0, Math.PI * 2);
				ctx.fill();
			}
		} else if (key === 'earth') {
			// Earth: Blue oceans, green/brown continents, clouds
			ctx.fillStyle = '#0f2c59';
			ctx.fillRect(0, 0, 1024, 512);
			ctx.fillStyle = '#275225';
			for (let i = 0; i < 25; i++) {
				const cx = Math.random() * 1024;
				const cy = 100 + Math.random() * 312;
				const size = 60 + Math.random() * 140;
				ctx.beginPath();
				ctx.arc(cx, cy, size, 0, Math.PI * 2);
				ctx.fill();
				for (let j = 0; j < 5; j++) {
					ctx.fillStyle = Math.random() > 0.5 ? '#366e33' : '#5a4f32';
					ctx.beginPath();
					ctx.arc(cx + (Math.random() - 0.5) * size * 1.5, cy + (Math.random() - 0.5) * size * 1.5, size * 0.5, 0, Math.PI * 2);
					ctx.fill();
				}
			}
			ctx.fillStyle = '#ffffff';
			ctx.fillRect(0, 0, 1024, 35);
			ctx.fillRect(0, 482, 1024, 30);
			ctx.fillStyle = 'rgba(255, 255, 255, 0.3)';
			for (let i = 0; i < 45; i++) {
				ctx.beginPath();
				ctx.ellipse(Math.random() * 1024, Math.random() * 512, 70 + Math.random() * 160, 10 + Math.random() * 20, Math.random() * 0.12, 0, Math.PI * 2);
				ctx.fill();
			}
		} else if (key === 'mars') {
			// Red desert Mars
			ctx.fillStyle = '#a64a2b';
			ctx.fillRect(0, 0, 512, 256);
			ctx.fillStyle = '#5c2211';
			for (let i = 0; i < 15; i++) {
				ctx.beginPath();
				ctx.arc(Math.random() * 512, Math.random() * 256, 20 + Math.random() * 50, 0, Math.PI * 2);
				ctx.fill();
			}
			ctx.fillStyle = '#ffffff';
			ctx.beginPath(); ctx.arc(256, 0, 18, 0, Math.PI); ctx.fill();
		} else if (key === 'jupiter') {
			// Striped Jupiter
			for (let y = 0; y < 512; y += 4) {
				const n = Math.sin(y * 0.14) * Math.cos(y * 0.05);
				if (n > 0.25) ctx.fillStyle = '#b8864b';
				else if (n > 0) ctx.fillStyle = '#dec39c';
				else if (n > -0.3) ctx.fillStyle = '#8f5b2b';
				else ctx.fillStyle = '#cca87a';
				ctx.fillRect(0, y, 1024, 4);
			}
			ctx.fillStyle = '#8f2015';
			ctx.beginPath();
			ctx.ellipse(620, 360, 45, 25, 0, 0, Math.PI * 2);
			ctx.fill();
			ctx.fillStyle = '#d95a4c';
			ctx.beginPath();
			ctx.ellipse(620, 360, 25, 12, 0, 0, Math.PI * 2);
			ctx.fill();
		} else if (key === 'saturn') {
			// Saturn bands
			for (let y = 0; y < 512; y += 4) {
				const n = Math.sin(y * 0.08);
				if (n > 0.4) ctx.fillStyle = '#d6b77c';
				else if (n > 0) ctx.fillStyle = '#eccf9c';
				else if (n > -0.4) ctx.fillStyle = '#bda066';
				else ctx.fillStyle = '#deb97d';
				ctx.fillRect(0, y, 1024, 4);
			}
		} else if (key === 'uranus') {
			// Uranus cyan
			const grad = ctx.createLinearGradient(0, 0, 0, 256);
			grad.addColorStop(0, '#bbf5f2');
			grad.addColorStop(0.5, '#85dedb');
			grad.addColorStop(1, '#6bbab7');
			ctx.fillStyle = grad;
			ctx.fillRect(0, 0, 512, 256);
		} else if (key === 'neptune') {
			// Neptune azure
			ctx.fillStyle = '#274b94';
			ctx.fillRect(0, 0, 512, 256);
			ctx.fillStyle = '#172b54';
			ctx.beginPath();
			ctx.ellipse(300, 160, 35, 20, 0, 0, Math.PI * 2);
			ctx.fill();
			ctx.strokeStyle = 'rgba(255, 255, 255, 0.12)';
			ctx.lineWidth = 1.5;
			ctx.beginPath(); ctx.moveTo(0, 95); ctx.quadraticCurveTo(256, 115, 512, 95); ctx.stroke();
		} else if (key === 'moon') {
			// Moon gray
			ctx.fillStyle = '#666666';
			ctx.fillRect(0, 0, 512, 256);
			ctx.fillStyle = 'rgba(0, 0, 0, 0.15)';
			for (let i = 0; i < 12; i++) {
				ctx.beginPath();
				ctx.arc(Math.random() * 512, Math.random() * 256, 20 + Math.random() * 40, 0, Math.PI * 2);
				ctx.fill();
			}
			for (let i = 0; i < 100; i++) {
				ctx.fillStyle = 'rgba(255, 255, 255, 0.08)';
				ctx.beginPath();
				ctx.arc(Math.random() * 512, Math.random() * 256, 2 + Math.random() * 7, 0, Math.PI * 2);
				ctx.fill();
			}
		}

		const texture = new THREE.CanvasTexture(canvas);
		texture.colorSpace = THREE.SRGBColorSpace;
		texture.wrapS = THREE.RepeatWrapping;
		texture.wrapT = THREE.ClampToEdgeWrapping;
		
		updateLoadingProgress(key);
		return texture;
	}

	// ─── Camera & Controls ────────────────────────────────────────
	camera.position.set(0, 120, 180);
	camera.lookAt(0, 0, 0);

	const controls = new OrbitControls(camera, renderer.domElement);
	controls.enableDamping = true;
	controls.dampingFactor = 0.05;
	controls.minDistance = 20;
	controls.maxDistance = 600;
	controls.touches = { ONE: THREE.TOUCH.ROTATE, TWO: THREE.TOUCH.DOLLY_PAN };

	// Headlight to illuminate the side of planets facing the camera
	const cameraLight = new THREE.DirectionalLight(0xffffff, 2.0);
	camera.add(cameraLight);
	scene.add(camera);

	// ─── Speed Control ────────────────────────────────────────────
	let speedMultiplier = 1.0;
	const speedSlider = document.getElementById('speedSlider') as HTMLInputElement;
	const speedLabel = document.getElementById('speedLabel');
	speedSlider?.addEventListener('input', () => {
		speedMultiplier = parseFloat(speedSlider.value) / 100;
		if (speedLabel) speedLabel.textContent = `${speedMultiplier.toFixed(1)}×`;
	});

	// ─── Toggle Controls ──────────────────────────────────────────
	let showOrbits = true;
	let showLabels = true;
	let showTrails = true;

	document.getElementById('toggleOrbits')?.addEventListener('change', (e) => {
		showOrbits = (e.target as HTMLInputElement).checked;
		orbitLines.forEach(l => { l.visible = showOrbits; });
	});
	document.getElementById('toggleLabels')?.addEventListener('change', (e) => {
		showLabels = (e.target as HTMLInputElement).checked;
	});
	document.getElementById('toggleTrails')?.addEventListener('change', (e) => {
		showTrails = (e.target as HTMLInputElement).checked;
		satellites.forEach(s => { if (s.trail) s.trail.visible = showTrails; });
	});

	// ─── Enhanced Starfield ───────────────────────────────────────
	function createStarfield() {
		const geo = new THREE.BufferGeometry();
		const verts: number[] = [];
		const colors: number[] = [];
		const sizes: number[] = [];

		for (let i = 0; i < 18000; i++) {
			verts.push(
				(Math.random() - 0.5) * 4000,
				(Math.random() - 0.5) * 4000,
				(Math.random() - 0.5) * 4000
			);
			const r = Math.random();
			if (r < 0.6) colors.push(1, 1, 1);
			else if (r < 0.75) colors.push(0.85, 0.9, 1);
			else if (r < 0.9) colors.push(1, 0.95, 0.85);
			else colors.push(0.7, 0.8, 1);

			sizes.push(Math.random() * 2.5 + 0.3);
		}

		geo.setAttribute('position', new THREE.Float32BufferAttribute(verts, 3));
		geo.setAttribute('color', new THREE.Float32BufferAttribute(colors, 3));

		return new THREE.Points(geo, new THREE.PointsMaterial({
			size: 1.0,
			vertexColors: true,
			transparent: true,
			opacity: 0.85,
			sizeAttenuation: true
		}));
	}
	scene.add(createStarfield());

	// Space fog
	scene.fog = new THREE.FogExp2(new THREE.Color(0x000510), 0.00012);

	// ─── Shooting Stars ───────────────────────────────────────────
	interface ShootingStar {
		mesh: THREE.Line;
		velocity: THREE.Vector3;
		life: number;
		maxLife: number;
	}
	const shootingStars: ShootingStar[] = [];

	function createShootingStar() {
		const startPos = new THREE.Vector3(
			(Math.random() - 0.5) * 800,
			Math.random() * 300 + 100,
			(Math.random() - 0.5) * 800
		);
		const dir = new THREE.Vector3(
			(Math.random() - 0.5) * 2,
			-Math.random() * 1.5 - 0.5,
			(Math.random() - 0.5) * 2
		).normalize();

		const trailLength = 8;
		const positions = new Float32Array(trailLength * 3);
		for (let i = 0; i < trailLength; i++) {
			positions[i * 3] = startPos.x;
			positions[i * 3 + 1] = startPos.y;
			positions[i * 3 + 2] = startPos.z;
		}
		const geo = new THREE.BufferGeometry();
		geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

		const mat = new THREE.LineBasicMaterial({
			color: 0xffffff,
			transparent: true,
			opacity: 0.8,
			linewidth: 1
		});
		const line = new THREE.Line(geo, mat);
		scene.add(line);

		shootingStars.push({
			mesh: line,
			velocity: dir.multiplyScalar(3 + Math.random() * 4),
			life: 0,
			maxLife: 60 + Math.random() * 60
		});
	}

	function updateShootingStars() {
		// Spawn occasionally
		if (Math.random() < 0.008) createShootingStar();

		for (let i = shootingStars.length - 1; i >= 0; i--) {
			const ss = shootingStars[i];
			ss.life++;

			const positions = ss.mesh.geometry.attributes.position.array as Float32Array;
			// Shift trail
			for (let j = positions.length / 3 - 1; j > 0; j--) {
				positions[j * 3] = positions[(j - 1) * 3];
				positions[j * 3 + 1] = positions[(j - 1) * 3 + 1];
				positions[j * 3 + 2] = positions[(j - 1) * 3 + 2];
			}
			// Move head
			positions[0] += ss.velocity.x;
			positions[1] += ss.velocity.y;
			positions[2] += ss.velocity.z;
			ss.mesh.geometry.attributes.position.needsUpdate = true;

			// Fade out
			const progress = ss.life / ss.maxLife;
			(ss.mesh.material as THREE.LineBasicMaterial).opacity = 0.8 * (1 - progress);

			if (ss.life >= ss.maxLife) {
				scene.remove(ss.mesh);
				ss.mesh.geometry.dispose();
				(ss.mesh.material as THREE.Material).dispose();
				shootingStars.splice(i, 1);
			}
		}
	}

	// ─── Lighting ─────────────────────────────────────────────────
	const ambientLight = new THREE.AmbientLight(0x222233, 0.45);
	scene.add(ambientLight);

	const sunLight = new THREE.PointLight(0xfff5e0, 3.5, 3000);
	sunLight.position.set(0, 0, 0);
	sunLight.castShadow = true;
	sunLight.shadow.mapSize.width = 2048;
	sunLight.shadow.mapSize.height = 2048;
	scene.add(sunLight);

	const hemiLight = new THREE.HemisphereLight(0x0d1a44, 0x000000, 0.12);
	scene.add(hemiLight);



	function createSun(): THREE.Group {
		const group = new THREE.Group();
		const sunTex = createPlanetTexture('sun');

		// Core sun sphere
		const sunGeo = new THREE.SphereGeometry(planetData.sun.size, 64, 64);
		const sunMat = new THREE.MeshBasicMaterial({
			map: sunTex,
			color: 0xffffff,
			toneMapped: false
		});
		const sunMesh = new THREE.Mesh(sunGeo, sunMat);
		sunMesh.userData = { planetKey: 'sun', ...planetData.sun };
		group.add(sunMesh);

		// Inner glow layer
		const glow1Geo = new THREE.SphereGeometry(planetData.sun.size * 1.15, 48, 48);
		const glow1Mat = new THREE.ShaderMaterial({
			uniforms: {
				glowColor: { value: new THREE.Color(0xffcc44) },
				viewVector: { value: camera.position },
				time: { value: 0.0 }
			},
			vertexShader: `
				uniform vec3 viewVector;
				varying float intensity;
				void main() {
					vec3 vNormal = normalize(normalMatrix * normal);
					vec3 vNormel = normalize(normalMatrix * viewVector);
					intensity = pow(0.65 - dot(vNormal, vNormel), 2.5);
					gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
				}
			`,
			fragmentShader: `
				uniform vec3 glowColor;
				uniform float time;
				varying float intensity;
				void main() {
					float pulse = 1.0 + 0.15 * sin(time * 2.0);
					vec3 glow = glowColor * intensity * pulse;
					gl_FragColor = vec4(glow, intensity * 0.8);
				}
			`,
			side: THREE.BackSide,
			blending: THREE.AdditiveBlending,
			transparent: true
		});
		group.add(new THREE.Mesh(glow1Geo, glow1Mat));

		// Outer glow layer
		const glow2Geo = new THREE.SphereGeometry(planetData.sun.size * 1.4, 32, 32);
		const glow2Mat = new THREE.ShaderMaterial({
			uniforms: {
				glowColor: { value: new THREE.Color(0xff8800) },
				viewVector: { value: camera.position },
				time: { value: 0.0 }
			},
			vertexShader: `
				uniform vec3 viewVector;
				varying float intensity;
				void main() {
					vec3 vNormal = normalize(normalMatrix * normal);
					vec3 vNormel = normalize(normalMatrix * viewVector);
					intensity = pow(0.55 - dot(vNormal, vNormel), 3.0);
					gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
				}
			`,
			fragmentShader: `
				uniform vec3 glowColor;
				uniform float time;
				varying float intensity;
				void main() {
					float pulse = 1.0 + 0.1 * sin(time * 1.5 + 1.0);
					vec3 glow = glowColor * intensity * pulse * 0.6;
					gl_FragColor = vec4(glow, intensity * 0.5);
				}
			`,
			side: THREE.BackSide,
			blending: THREE.AdditiveBlending,
			transparent: true
		});
		group.add(new THREE.Mesh(glow2Geo, glow2Mat));

		return group;
	}

	// ─── Planet Creation ──────────────────────────────────────────
	interface PlanetEntry {
		mesh: THREE.Mesh;
		group: THREE.Group;
		orbit: number;
		speed: number;
		angle: number;
		moon?: THREE.Mesh;
		moonOrbit?: number;
		ring?: THREE.Mesh;
		atmosphere?: THREE.Mesh;
	}
	const planets: Record<string, PlanetEntry> = {};
	const orbitLines: THREE.Line[] = [];
	const sunGroup = createSun();
	scene.add(sunGroup);
	planets['sun'] = {
		mesh: sunGroup.children[0] as THREE.Mesh,
		group: sunGroup,
		orbit: 0,
		speed: 0,
		angle: 0
	};

	// Create each planet
	Object.entries(planetData).forEach(([key, data]) => {
		if (key === 'sun') return;

		const planetGroup = new THREE.Group();

		// Load texture
		const tex = createPlanetTexture(key);

		// Planet sphere
		const geo = new THREE.SphereGeometry(data.size, 64, 64);
		let mat: THREE.Material;

		if (key === 'earth') {
			mat = new THREE.MeshStandardMaterial({
				map: tex, roughness: 0.65, metalness: 0.1
			});
		} else if (key === 'jupiter' || key === 'saturn') {
			mat = new THREE.MeshStandardMaterial({
				map: tex, roughness: 0.55, metalness: 0.05
			});
		} else if (key === 'uranus' || key === 'neptune') {
			mat = new THREE.MeshStandardMaterial({
				map: tex, roughness: 0.4, metalness: 0.12
			});
		} else {
			mat = new THREE.MeshStandardMaterial({
				map: tex, roughness: 0.9, metalness: 0.0
			});
		}

		const mesh = new THREE.Mesh(geo, mat);
		mesh.userData = { planetKey: key, ...data };
		mesh.castShadow = true;
		mesh.receiveShadow = true;

		// Axial tilt
		const tiltRad = (data.tilt || 0) * Math.PI / 180;
		mesh.rotation.z = tiltRad;

		planetGroup.add(mesh);

		// Earth atmosphere glow
		if (key === 'earth') {
			const atmoGeo = new THREE.SphereGeometry(data.size * 1.08, 48, 48);
			const atmoMat = new THREE.ShaderMaterial({
				uniforms: {
					glowColor: { value: new THREE.Color(0x4488ff) },
					viewVector: { value: camera.position }
				},
				vertexShader: `
					uniform vec3 viewVector;
					varying float intensity;
					void main() {
						vec3 vNormal = normalize(normalMatrix * normal);
						vec3 vNormel = normalize(normalMatrix * viewVector);
						intensity = pow(0.6 - dot(vNormal, vNormel), 3.0);
						gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
					}
				`,
				fragmentShader: `
					uniform vec3 glowColor;
					varying float intensity;
					void main() {
						vec3 glow = glowColor * intensity;
						gl_FragColor = vec4(glow, intensity * 0.6);
					}
				`,
				side: THREE.BackSide,
				blending: THREE.AdditiveBlending,
				transparent: true
			});
			const atmo = new THREE.Mesh(atmoGeo, atmoMat);
			planetGroup.add(atmo);
			planets[key] = { ...planets[key], atmosphere: atmo } as any;
		}

		// Moon for Earth
		if (data.hasMoon) {
			const moonTex = createPlanetTexture('moon');
			const moonGeo = new THREE.SphereGeometry(0.9, 32, 32);
			const moonMat = new THREE.MeshStandardMaterial({
				map: moonTex, roughness: 1.0, metalness: 0
			});
			const moon = new THREE.Mesh(moonGeo, moonMat);
			moon.position.x = 7;
			moon.castShadow = true;
			moon.receiveShadow = true;
			planetGroup.add(moon);
		}

		// Saturn rings — procedural gradient texture
		if (data.hasRings) {
			const ringInner = data.size * 1.3;
			const ringOuter = data.size * 2.4;
			const ringGeo = new THREE.RingGeometry(ringInner, ringOuter, 128, 4);

			// Procedural ring texture
			const ringCanvas = document.createElement('canvas');
			ringCanvas.width = 512;
			ringCanvas.height = 64;
			const ctx = ringCanvas.getContext('2d')!;
			const gradient = ctx.createLinearGradient(0, 0, 512, 0);
			gradient.addColorStop(0, 'rgba(180, 160, 130, 0.0)');
			gradient.addColorStop(0.05, 'rgba(200, 180, 140, 0.7)');
			gradient.addColorStop(0.15, 'rgba(210, 190, 150, 0.4)');
			gradient.addColorStop(0.2, 'rgba(180, 160, 120, 0.8)');
			gradient.addColorStop(0.35, 'rgba(220, 200, 160, 0.3)');
			gradient.addColorStop(0.4, 'rgba(200, 180, 140, 0.6)');
			gradient.addColorStop(0.5, 'rgba(180, 160, 130, 0.2)');
			gradient.addColorStop(0.6, 'rgba(210, 195, 155, 0.7)');
			gradient.addColorStop(0.75, 'rgba(190, 170, 130, 0.5)');
			gradient.addColorStop(0.85, 'rgba(170, 150, 120, 0.3)');
			gradient.addColorStop(1, 'rgba(160, 140, 110, 0.0)');
			ctx.fillStyle = gradient;
			ctx.fillRect(0, 0, 512, 64);

			// Add ring gap bands
			ctx.fillStyle = 'rgba(0, 0, 0, 0.4)';
			ctx.fillRect(170, 0, 6, 64);  // Cassini division
			ctx.fillStyle = 'rgba(0, 0, 0, 0.2)';
			ctx.fillRect(260, 0, 3, 64);
			ctx.fillRect(380, 0, 4, 64);

			const ringTex = new THREE.CanvasTexture(ringCanvas);
			ringTex.wrapS = THREE.ClampToEdgeWrapping;

			// Remap UVs so texture maps radially
			const uvs = ringGeo.attributes.uv;
			const pos = ringGeo.attributes.position;
			for (let i = 0; i < uvs.count; i++) {
				const x = pos.getX(i);
				const z = pos.getZ(i);
				const dist = Math.sqrt(x * x + z * z);
				const u = (dist - ringInner) / (ringOuter - ringInner);
				uvs.setXY(i, u, 0.5);
			}

			const ringMat = new THREE.MeshStandardMaterial({
				map: ringTex,
				side: THREE.DoubleSide,
				transparent: true,
				opacity: 0.85,
				roughness: 0.9,
				metalness: 0
			});
			const ring = new THREE.Mesh(ringGeo, ringMat);
			ring.rotation.x = -Math.PI / 2.2;
			ring.castShadow = true;
			ring.receiveShadow = true;
			planetGroup.add(ring);
		}

		// Position planet group
		planetGroup.position.x = data.distance;
		scene.add(planetGroup);

		planets[key] = {
			mesh: mesh,
			group: planetGroup,
			orbit: data.distance,
			speed: data.speed,
			angle: Math.random() * Math.PI * 2,
			...(data.hasMoon ? { moon: planetGroup.children.find((c: any) => c.geometry?.parameters?.radius === 0.9) as THREE.Mesh, moonOrbit: 7 } : {})
		};

		// Orbit line — dashed & tinted
		const orbitGeo = new THREE.BufferGeometry();
		const orbitPts: number[] = [];
		for (let i = 0; i <= 128; i++) {
			const a = (i / 128) * Math.PI * 2;
			orbitPts.push(Math.cos(a) * data.distance, 0, Math.sin(a) * data.distance);
		}
		orbitGeo.setAttribute('position', new THREE.Float32BufferAttribute(orbitPts, 3));

		const planetColor = new THREE.Color(data.color);
		const orbitColor = planetColor.clone().lerp(new THREE.Color(0x333333), 0.6);
		const orbitMat = new THREE.LineBasicMaterial({
			color: orbitColor,
			transparent: true,
			opacity: 0.25
		});
		const orbitLine = new THREE.Line(orbitGeo, orbitMat);
		scene.add(orbitLine);
		orbitLines.push(orbitLine);
	});

	// ─── Asteroid Belt ────────────────────────────────────────────
	function createAsteroidBelt() {
		const count = 600;
		const innerRadius = 95;
		const outerRadius = 115;
		const positions = new Float32Array(count * 3);
		const sizes = new Float32Array(count);
		const colors = new Float32Array(count * 3);

		for (let i = 0; i < count; i++) {
			const angle = Math.random() * Math.PI * 2;
			const radius = innerRadius + Math.random() * (outerRadius - innerRadius);
			const y = (Math.random() - 0.5) * 6;

			positions[i * 3] = Math.cos(angle) * radius;
			positions[i * 3 + 1] = y;
			positions[i * 3 + 2] = Math.sin(angle) * radius;

			sizes[i] = Math.random() * 1.5 + 0.3;

			const shade = 0.3 + Math.random() * 0.3;
			colors[i * 3] = shade;
			colors[i * 3 + 1] = shade * 0.9;
			colors[i * 3 + 2] = shade * 0.8;
		}

		const geo = new THREE.BufferGeometry();
		geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));
		geo.setAttribute('color', new THREE.BufferAttribute(colors, 3));

		const mat = new THREE.PointsMaterial({
			size: 0.6,
			vertexColors: true,
			transparent: true,
			opacity: 0.7,
			sizeAttenuation: true
		});

		return new THREE.Points(geo, mat);
	}
	const asteroidBelt = createAsteroidBelt();
	scene.add(asteroidBelt);

	// ─── Satellites ───────────────────────────────────────────────
	interface SatelliteConfig {
		name: string;
		parentPlanet: string;
		orbitRadius: number;
		speed: number;
		size: number;
		color: number;
		trailColor: number;
		tilt: number;        // orbital tilt in radians
		eccentricity: number; // 0 = circular
		isVoyager?: boolean;
	}

	const satelliteConfigs: SatelliteConfig[] = [
		{
			name: 'ISS',
			parentPlanet: 'earth',
			orbitRadius: 5.5,
			speed: 0.08,
			size: 0.25,
			color: 0xcccccc,
			trailColor: 0x44aaff,
			tilt: 0.4,
			eccentricity: 0
		},
		{
			name: 'Hubble',
			parentPlanet: 'earth',
			orbitRadius: 7.5,
			speed: 0.055,
			size: 0.2,
			color: 0xdddddd,
			trailColor: 0xffaa44,
			tilt: 0.15,
			eccentricity: 0
		},
		{
			name: 'MRO',
			parentPlanet: 'mars',
			orbitRadius: 5,
			speed: 0.06,
			size: 0.2,
			color: 0xccaa88,
			trailColor: 0xff6644,
			tilt: 0.3,
			eccentricity: 0.05
		},
		{
			name: 'Juno',
			parentPlanet: 'jupiter',
			orbitRadius: 16,
			speed: 0.04,
			size: 0.35,
			color: 0x88aacc,
			trailColor: 0x88ccff,
			tilt: 1.2,    // polar orbit
			eccentricity: 0.1
		},
		{
			name: 'Cassini',
			parentPlanet: 'saturn',
			orbitRadius: 15,
			speed: 0.035,
			size: 0.3,
			color: 0xbbaa88,
			trailColor: 0xffdd66,
			tilt: 0.5,
			eccentricity: 0.08
		},
		{
			name: 'Voyager 1',
			parentPlanet: 'neptune',
			orbitRadius: 0,
			speed: 0.006,
			size: 0.3,
			color: 0xaaaacc,
			trailColor: 0xaa88ff,
			tilt: 0,
			eccentricity: 0,
			isVoyager: true
		}
	];

	interface SatelliteInstance {
		config: SatelliteConfig;
		body: THREE.Group;
		trail: THREE.Line;
		trailPositions: Float32Array;
		angle: number;
		voyagerT?: number;
	}
	const satellites: SatelliteInstance[] = [];

	function createSatelliteBody(config: SatelliteConfig): THREE.Group {
		const group = new THREE.Group();

		// Main body
		const bodyGeo = new THREE.BoxGeometry(config.size, config.size * 0.6, config.size * 0.6);
		const bodyMat = new THREE.MeshStandardMaterial({
			color: config.color,
			metalness: 0.8,
			roughness: 0.3,
			emissive: config.trailColor,
			emissiveIntensity: 0.15
		});
		group.add(new THREE.Mesh(bodyGeo, bodyMat));

		// Solar panels (two flat rectangles)
		const panelGeo = new THREE.BoxGeometry(config.size * 2, config.size * 0.05, config.size * 0.8);
		const panelMat = new THREE.MeshStandardMaterial({
			color: 0x2244aa,
			metalness: 0.6,
			roughness: 0.2,
			emissive: 0x112244,
			emissiveIntensity: 0.1
		});
		const panel1 = new THREE.Mesh(panelGeo, panelMat);
		panel1.position.x = config.size * 1.2;
		group.add(panel1);

		const panel2 = new THREE.Mesh(panelGeo, panelMat);
		panel2.position.x = -config.size * 1.2;
		group.add(panel2);

		// Blinking light
		const lightGeo = new THREE.SphereGeometry(config.size * 0.15, 8, 8);
		const lightMat = new THREE.MeshBasicMaterial({
			color: config.trailColor,
			toneMapped: false
		});
		const light = new THREE.Mesh(lightGeo, lightMat);
		light.position.y = config.size * 0.4;
		group.add(light);

		return group;
	}

	function createSatelliteTrail(color: number): { line: THREE.Line, positions: Float32Array } {
		const trailLength = 80;
		const positions = new Float32Array(trailLength * 3);
		const geo = new THREE.BufferGeometry();
		geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

		const mat = new THREE.LineBasicMaterial({
			color: color,
			transparent: true,
			opacity: 0.4,
			linewidth: 1
		});

		return { line: new THREE.Line(geo, mat), positions };
	}

	// Create all satellites
	satelliteConfigs.forEach(config => {
		const body = createSatelliteBody(config);
		const { line: trail, positions: trailPositions } = createSatelliteTrail(config.trailColor);

		scene.add(body);
		scene.add(trail);

		satellites.push({
			config,
			body,
			trail,
			trailPositions,
			angle: Math.random() * Math.PI * 2,
			voyagerT: config.isVoyager ? 0 : undefined
		});
	});

	// ─── Raycaster ────────────────────────────────────────────────
	const raycaster = new THREE.Raycaster();
	const mouse = new THREE.Vector2();
	const clickableMeshes = Object.values(planets).map(p => p.mesh);

	function onPlanetClick(event: MouseEvent) {
		// Don't trigger on drag
		mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
		mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

		raycaster.setFromCamera(mouse, camera);
		const intersects = raycaster.intersectObjects(clickableMeshes);

		if (intersects.length > 0) {
			const hit = intersects[0].object as THREE.Mesh;
			const key = hit.userData.planetKey;
			if (key) {
				showPlanetInfo(key);
				focusOnPlanet(key);
			}
		}
	}

	function showPlanetInfo(planetKey: string) {
		const data = planetData[planetKey];
		const panel = document.getElementById('planetInfo');
		if (!panel || !data) return;

		const img = document.getElementById('planetImage') as HTMLImageElement;
		if (img) {
			img.src = data.image;
			img.alt = data.name;
		}

		document.getElementById('planetName')!.textContent = data.name;
		document.getElementById('planetType')!.textContent = data.type;
		document.getElementById('planetDiameter')!.textContent = data.diameter;
		document.getElementById('planetDistance')!.textContent = data.distanceText;
		document.getElementById('planetPeriod')!.textContent = data.period;
		document.getElementById('planetRotation')!.textContent = data.rotation;
		document.getElementById('planetMoons')!.textContent = data.moons;
		document.getElementById('planetDescription')!.textContent = data.description;

		panel.classList.remove('hidden');
	}

	function focusOnPlanet(planetKey: string) {
		const planet = planets[planetKey];
		if (!planet) return;

		const targetPos = planetKey === 'sun'
			? new THREE.Vector3(0, 0, 0)
			: planet.group.position.clone();
		const dist = planetData[planetKey].size * 4;

		const camTarget = new THREE.Vector3(
			targetPos.x + dist,
			dist * 0.5,
			targetPos.z + dist
		);

		const startPos = camera.position.clone();
		const startTarget = controls.target.clone();
		const startTime = Date.now();
		const duration = 1200;

		function animateCamera() {
			const t = Math.min((Date.now() - startTime) / duration, 1);
			const eased = 1 - Math.pow(1 - t, 3);

			camera.position.lerpVectors(startPos, camTarget, eased);
			controls.target.copy(startTarget).lerp(targetPos, eased);
			controls.update();

			if (t < 1) requestAnimationFrame(animateCamera);
		}
		animateCamera();
	}

	// ─── Event Listeners ──────────────────────────────────────────
	window.addEventListener('click', onPlanetClick);

	document.getElementById('closeInfo')?.addEventListener('click', () => {
		document.getElementById('planetInfo')?.classList.add('hidden');
	});

	document.getElementById('resetCamera')?.addEventListener('click', () => {
		camera.position.set(0, 120, 180);
		controls.target.set(0, 0, 0);
		controls.update();
		document.getElementById('planetInfo')?.classList.add('hidden');
	});

	document.querySelectorAll('.planet-quick-nav').forEach(button => {
		button.addEventListener('click', (e) => {
			e.stopPropagation();
			const planetKey = (button as HTMLElement).dataset.planet;
			if (planetKey) {
				showPlanetInfo(planetKey);
				focusOnPlanet(planetKey);
			}
		});
	});

	// ─── Animation Loop ───────────────────────────────────────────
	const clock = new THREE.Clock();

	function animate() {
		requestAnimationFrame(animate);

		const elapsed = clock.getElapsedTime();
		const dt = clock.getDelta();
		const speed = speedMultiplier;

		// Update sun corona pulse
		sunGroup.children.forEach((child: any) => {
			if (child.material && child.material.uniforms && child.material.uniforms.time) {
				child.material.uniforms.time.value = elapsed;
				child.material.uniforms.viewVector.value.copy(camera.position);
			}
		});

		// Update planet positions and rotations
		Object.entries(planets).forEach(([key, planet]) => {
			if (key === 'sun') {
				planet.mesh.rotation.y += 0.002 * speed;
				return;
			}

			// Orbit
			planet.angle += planet.speed * 0.016 * speed;
			planet.group.position.x = Math.cos(planet.angle) * planet.orbit;
			planet.group.position.z = Math.sin(planet.angle) * planet.orbit;

			// Self rotation
			planet.mesh.rotation.y += 0.008 * speed;

			// Moon orbit
			if (planet.moon && planet.moonOrbit) {
				const moonAngle = elapsed * 1.5 * speed;
				planet.moon.position.x = Math.cos(moonAngle) * planet.moonOrbit;
				planet.moon.position.z = Math.sin(moonAngle) * planet.moonOrbit;
			}

			// Update atmosphere shader
			if ((planet as any).atmosphere) {
				const atmo = (planet as any).atmosphere;
				if (atmo.material.uniforms) {
					atmo.material.uniforms.viewVector.value.copy(camera.position);
				}
			}
		});

		// Rotate asteroid belt slowly
		asteroidBelt.rotation.y += 0.0003 * speed;

		// Update satellites
		satellites.forEach(sat => {
			const parentPlanet = planets[sat.config.parentPlanet];
			if (!parentPlanet) return;

			let worldPos: THREE.Vector3;

			if (sat.config.isVoyager) {
				// Voyager: travels on a path through the outer solar system
				sat.voyagerT = (sat.voyagerT || 0) + 0.0008 * speed;
				const t = sat.voyagerT % (Math.PI * 2);

				// Spiral outward trajectory
				const baseRadius = 250 + sat.voyagerT * 5;
				worldPos = new THREE.Vector3(
					Math.cos(t) * baseRadius,
					Math.sin(t * 2) * 15,
					Math.sin(t) * baseRadius
				);

				// Wrap around when too far
				if (baseRadius > 500) sat.voyagerT = 0;
			} else {
				// Normal satellite: orbit around parent planet
				sat.angle += sat.config.speed * speed;
				const parentPos = parentPlanet.group.position;

				const r = sat.config.orbitRadius * (1 + sat.config.eccentricity * Math.sin(sat.angle));
				const localX = Math.cos(sat.angle) * r;
				const localZ = Math.sin(sat.angle) * r;
				const localY = Math.sin(sat.angle * 0.7) * r * Math.sin(sat.config.tilt);

				worldPos = new THREE.Vector3(
					parentPos.x + localX,
					localY,
					parentPos.z + localZ
				);
			}

			sat.body.position.copy(worldPos);
			sat.body.rotation.y += 0.03 * speed;

			// Blinking light
			const blinkChild = sat.body.children[3]; // light sphere
			if (blinkChild && blinkChild instanceof THREE.Mesh) {
				const blink = Math.sin(elapsed * 5 + satellites.indexOf(sat)) > 0.3 ? 1 : 0.2;
				(blinkChild.material as THREE.MeshBasicMaterial).opacity = blink;
			}

			// Update trail
			if (sat.trail.visible) {
				const tp = sat.trailPositions;
				// Shift trail backwards
				for (let i = tp.length / 3 - 1; i > 0; i--) {
					tp[i * 3] = tp[(i - 1) * 3];
					tp[i * 3 + 1] = tp[(i - 1) * 3 + 1];
					tp[i * 3 + 2] = tp[(i - 1) * 3 + 2];
				}
				tp[0] = worldPos.x;
				tp[1] = worldPos.y;
				tp[2] = worldPos.z;
				sat.trail.geometry.attributes.position.needsUpdate = true;
			}
		});

		// Shooting stars
		updateShootingStars();

		// Render
		controls.update();
		composer.render();
	}

	// ─── Resize Handler ───────────────────────────────────────────
	window.addEventListener('resize', () => {
		camera.aspect = window.innerWidth / window.innerHeight;
		camera.updateProjectionMatrix();
		renderer.setSize(window.innerWidth, window.innerHeight);
		composer.setSize(window.innerWidth, window.innerHeight);
		bloomPass.resolution.set(window.innerWidth, window.innerHeight);
	});

	animate();
</script>

