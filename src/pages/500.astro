---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout
	title="Server Error — 500 | Truly Compass"
	description="Something went wrong on our end. Please try again or contact us if the issue persists."
	keywords="500, server error, internal error, truly compass"
	canonical="https://trulycompass.com/500/"
>
	<div class="relative min-h-screen flex flex-col overflow-x-hidden bg-canvas-soft">
		<SiteHeader current="compass" />
		<main id="main" class="flex-grow z-10 flex items-center justify-center py-20">
			<div class="content-grid text-center max-w-lg">
				<p class="font-mono text-7xl sm:text-8xl font-bold text-ink/20 tracking-tighter">500</p>
				<h1 class="mt-4 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Server Error</h1>
				<p class="mt-3 text-sm text-body leading-relaxed font-mono">
					Something went wrong on our end. Please try again shortly.
				</p>
				<div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
					<a
						href="/"
						class="focus-ring rounded-full bg-ink px-8 py-3 text-sm font-semibold text-canvas transition-opacity hover:opacity-90"
					>
						← Back to Home
					</a>
					<a
						href="/contact/"
						class="focus-ring rounded-full border border-hairline bg-canvas px-8 py-3 text-sm font-semibold text-ink transition-colors hover:border-hairline-strong"
					>
						Contact Support
					</a>
				</div>
			</div>
		</main>
		<SiteFooter />
	</div>
</Layout>
