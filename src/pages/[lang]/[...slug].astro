---
import Layout from '../../layouts/Layout.astro';
import SiteShell from '../../components/SiteShell.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import LocationPrompt from '../../components/LocationPrompt.astro';
import AdSlot from '../../components/AdSlot.astro';
import SeoJsonLd from '../../components/SeoJsonLd.astro';
import { getTranslations } from '../../i18n/translations';
import { SUPPORTED_LOCALES, DEFAULT_LOCALE } from '../../i18n/locales';

export async function getStaticPaths() {
	const pageMeta: Record<string, { current: string }> = {
		home: { current: 'compass' },
		'sun-position': { current: 'sun' },
		'moon-position': { current: 'moon' },
		'qibla-compass': { current: 'qibla' },
		'prayer-times': { current: 'prayer-times' },
		'wind-compass': { current: 'wind' },
		'golden-hour': { current: 'golden-hour' },
		'uv-index': { current: 'uv-index' },
		'day-length': { current: 'day-length' },
		'solar-system': { current: 'solar-system' },
		'gps-coordinates': { current: 'compass' },
		'compass-bearings': { current: 'compass' },
	};
	const nonDefaultLocales = SUPPORTED_LOCALES.filter(l => l.code !== DEFAULT_LOCALE);
	type RouteParams = { lang: string; slug?: string };
	const paths: { params: RouteParams; props: { locale: string; page: string } }[] = [];
	for (const locale of nonDefaultLocales) {
		paths.push({ params: { lang: locale.code }, props: { locale: locale.code, page: 'home' } });
		for (const [slug] of Object.entries(pageMeta)) {
			if (slug === 'home') continue;
			paths.push({ params: { lang: locale.code, slug }, props: { locale: locale.code, page: slug } });
		}
	}
	return paths;
}

const { locale, page } = Astro.props;
const t = getTranslations(locale);

const pageMeta: Record<string, { current: string; seoName: string; seoDesc: string }> = {
	home: { current: 'compass', seoName: 'Online Compass', seoDesc: 'seo.home' },
	'sun-position': { current: 'sun', seoName: 'Sun Position — Online Compass', seoDesc: 'seo.sun' },
	'moon-position': { current: 'moon', seoName: 'Moon Position — Online Compass', seoDesc: 'seo.moon' },
	'qibla-compass': { current: 'qibla', seoName: 'Qibla Finder — Online Compass', seoDesc: 'seo.qibla' },
	'prayer-times': { current: 'prayer-times', seoName: 'Prayer Times — Online Compass', seoDesc: 'seo.prayerTimes' },
	'wind-compass': { current: 'wind', seoName: 'Wind Compass — Online Compass', seoDesc: '' },
	'golden-hour': { current: 'golden-hour', seoName: 'Golden Hour — Online Compass', seoDesc: '' },
	'uv-index': { current: 'uv-index', seoName: 'UV Index — Online Compass', seoDesc: '' },
	'day-length': { current: 'day-length', seoName: 'Day Length — Online Compass', seoDesc: '' },
	'solar-system': { current: 'solar-system', seoName: '3D Solar System — Online Compass', seoDesc: '' },
	'gps-coordinates': { current: 'compass', seoName: 'GPS Coordinates — Online Compass', seoDesc: '' },
	'compass-bearings': { current: 'compass', seoName: 'Compass Bearings — Online Compass', seoDesc: '' },
};

const pageKeyMap: Record<string, string> = {
	home: 'compass',
	'sun-position': 'sun',
	'moon-position': 'moon',
	'qibla-compass': 'qibla',
	'prayer-times': 'prayerTimes',
	'wind-compass': 'wind',
	'golden-hour': 'goldenHour',
	'uv-index': 'uvIndex',
	'day-length': 'dayLength',
	'solar-system': 'solarSystem',
	'gps-coordinates': 'gps',
	'compass-bearings': 'bearings',
};

const meta = pageMeta[page] || pageMeta.home;
const pageKey = pageKeyMap[page] || page;
const baseUrl = 'https://freeonlinecompass.com';
const path = page === 'home' ? '' : `/${page}/`;
const canonicalUrl = locale === DEFAULT_LOCALE ? `${baseUrl}${path}` : `${baseUrl}/${locale}${path}`;
const pageTitle = t[`${pageKey}.title`] || meta.seoName;
const pageDesc = t[meta.seoDesc] || t[`${pageKey}.description`] || t['site.description'];
const pageKeywords = t[`${pageKey}.keywords`] || t['site.keywords'];
const heading = t[`${pageKey}.heading`] || t[`nav.${pageKey}`] || t[`nav.${meta.current}`] || page;
const subtitle = t[`${pageKey}.subtitle`] || '';
---

<Layout
	lang={locale}
	title={pageTitle}
	description={pageDesc}
	keywords={pageKeywords}
	canonical={canonicalUrl}
>
	<SeoJsonLd
		slot="head"
		name={meta.seoName}
		description={pageDesc}
		url={canonicalUrl}
	/>
	<div class="relative min-h-screen flex flex-col overflow-x-hidden bg-canvas-soft">
		<div class="mesh-gradient-bg" aria-hidden="true"></div>
		<SiteShell current={meta.current} lang={locale} />
		<main id="main" class="flex-grow z-10">
			<section class="content-grid pt-8 pb-6 sm:pt-10 sm:pb-8 text-center relative z-20">
				<p class="font-mono text-xs uppercase text-muted tracking-widest" translate="no">freeOnlinecompass.com</p>
				<h1 class="mt-4 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-none tracking-tighter text-ink sm:text-5xl lg:text-6xl">
					{heading}
				</h1>
				{subtitle && (
					<p class="mt-4 max-w-2xl mx-auto text-pretty text-sm leading-6 text-body sm:text-base">{subtitle}</p>
				)}
			</section>

			{page === 'home' && (
				<section class="py-6 sm:py-8">
					<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
						<div class="rounded-panel border border-hairline bg-canvas p-6 card-elevated text-center">
							<h2 class="text-lg font-semibold text-ink">{t['compass.instrument'] || 'Live Instrument'}</h2>
							<p class="text-sm text-body mt-2">{t['compass.description'] || ''}</p>
							<p class="mt-4 text-xs font-mono text-muted">{t['compass.magneticNorth'] || 'Magnetic North'}</p>
						</div>
						<aside class="grid gap-6">
							<section class="rounded-panel border border-hairline bg-canvas p-4">
								<h2 class="text-xs font-mono uppercase text-muted tracking-wider">{t['compass.coordinates'] || 'Observer Coordinates'}</h2>
								<div class="mt-4"><LocationPrompt messageId="ptLocationNote" compact /></div>
							</section>
						</aside>
					</div>
				</section>
			)}

			{page === 'prayer-times' && (
				<section class="py-6 sm:py-8">
					<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
						<div class="flex flex-col">
							<div class="rounded-panel border border-hairline bg-canvas p-6 card-elevated text-center">
								<p class="font-mono text-[10px] uppercase text-muted tracking-wider">{t['prayerTimes.nextPrayer'] || 'Next Prayer'}</p>
								<p id="nextPrayerName" class="mt-2 text-lg font-semibold text-ink font-mono">--</p>
								<p id="nextPrayerCountdown" class="mt-1 text-3xl sm:text-4xl font-semibold tracking-tight text-ink font-mono">--</p>
								<p id="nextPrayerTime" class="text-xs text-body mt-1 font-mono"></p>
							</div>
							<div class="rounded-panel border border-hairline bg-canvas p-4 card-elevated mt-4">
								<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
									<div class="flex flex-col gap-1.5">
										<label for="methodSelect" class="text-[10px] font-mono text-muted uppercase tracking-wider">{t['prayerTimes.calcMethod'] || 'Calculation Method'}</label>
										<select id="methodSelect" class="focus-ring rounded-md border border-hairline bg-canvas-soft-2 px-3 py-2 text-xs font-mono text-ink"></select>
									</div>
									<div class="flex flex-col gap-1.5">
										<span class="text-[10px] font-mono text-muted uppercase tracking-wider">{t['prayerTimes.asrCalc'] || 'Asr Calculation'}</span>
										<div id="asrRadioGroup" class="flex gap-2"></div>
									</div>
								</div>
							</div>
							<div class="rounded-panel border border-hairline bg-canvas card-elevated mt-4 overflow-hidden">
								<div class="overflow-x-auto">
									<table id="prayerTable" class="w-full text-xs font-mono">
										<thead>
											<tr class="border-b border-hairline bg-canvas-soft-2">
												<th scope="col" class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">{t['prayerTimes.prayer'] || 'Prayer'}</th>
												<th scope="col" class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">{t['prayerTimes.time'] || 'Time'}</th>
												<th scope="col" class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">{t['prayerTimes.status'] || 'Status'}</th>
											</tr>
										</thead>
										<tbody></tbody>
									</table>
								</div>
							</div>
						</div>
						<aside class="grid gap-6">
							<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm">
								<h2 class="text-xs font-mono uppercase text-muted tracking-wider">{t['prayerTimes.observerCoords'] || 'Observer Coordinates'}</h2>
								<div class="mt-4"><LocationPrompt messageId="ptLocationNote" compact /></div>
							</section>
						</aside>
					</div>
				</section>
			)}

			{!['home', 'prayer-times'].includes(page) && (
				<section class="py-6 sm:py-8">
					<div class="content-grid">
						<div class="rounded-panel border border-hairline bg-canvas p-6 card-elevated text-center">
							<p class="text-sm text-body mt-2">{t[`${page}.subtitle`] || subtitle || ''}</p>
						</div>
					</div>
				</section>
			)}
		</main>
		<SiteFooter lang={locale} />
	</div>
</Layout>

<script>
	import { prefetchLocationSilently } from '../../lib/geo';
	import { mountDeviceUi } from '../../scripts/device-ui';
	import { getPrayerTimes, formatPrayerTime, formatRemaining, CALCULATION_METHODS } from '../../lib/prayer-times';

	prefetchLocationSilently();

	const page = document.querySelector('h1')?.textContent?.toLowerCase() || '';
	const isPrayerTimes = !!(document.getElementById('prayerTable'));

	if (isPrayerTimes) {
		const methodSelect = document.getElementById('methodSelect') as HTMLSelectElement;
		const asrRadioGroup = document.getElementById('asrRadioGroup');

		if (methodSelect) {
			CALCULATION_METHODS.forEach(m => {
				const opt = document.createElement('option');
				opt.value = m.id;
				opt.textContent = m.name;
				if (m.id === 'mwl') opt.selected = true;
				methodSelect.appendChild(opt);
			});
		}

		if (asrRadioGroup) {
			const asrOptions = [
				{ value: 'shafii', label: 'Shafi\'i / Maliki / Hanbali' },
				{ value: 'hanafi', label: 'Hanafi' },
			];
			asrOptions.forEach((opt, i) => {
				const label = document.createElement('label');
				label.className = 'flex items-center gap-2 cursor-pointer rounded-md border border-hairline bg-canvas-soft-2 px-3 py-2 text-xs font-mono text-ink';
				const input = document.createElement('input');
				input.type = 'radio';
				input.name = 'asrMethod';
				input.value = opt.value;
				if (i === 0) input.checked = true;
				input.className = 'accent-ink w-3 h-3';
				label.appendChild(input);
				label.appendChild(document.createTextNode(' ' + opt.label));
				asrRadioGroup.appendChild(label);
			});
		}

		const prayerIds = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'];
		const prayerNames = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];
		const tbody = document.querySelector('#prayerTable tbody');
		if (tbody) {
			prayerIds.forEach((id, i) => {
				const tr = document.createElement('tr');
				tr.id = `row-${id}`;
				tr.className = 'border-b border-hairline';
				tr.innerHTML = `
					<td class="px-4 py-3 font-semibold text-ink">${prayerNames[i]}</td>
					<td id="time-${id}" class="px-4 py-3 text-body">--</td>
					<td id="status-${id}" class="px-4 py-3 text-muted">--</td>
				`;
				tbody.appendChild(tr);
			});
		}

		let coords: { latitude: number; longitude: number } | null = null;
		let timer: number | undefined;
		let currentNextPrayer: { name: string; time: Date } | null = null;

		function setText(el: Element | null, value: string) {
			if (el) el.textContent = value;
		}

		function render() {
			if (!coords) return;
			const ms = document.querySelector('#methodSelect') as HTMLSelectElement;
			const hr = document.querySelector('input[name="asrMethod"]:checked') as HTMLInputElement;
			const methodId = ms?.value || 'mwl';
			const hanafi = hr?.value === 'hanafi';
			const times = getPrayerTimes(new Date(), coords.latitude, coords.longitude, methodId, hanafi);
			const now = new Date();
			const prayerMap: Record<string, Date> = { fajr: times.fajr, dhuhr: times.dhuhr, asr: times.asr, maghrib: times.maghrib, isha: times.isha };
			let nextFound = false;
			prayerIds.forEach((id, i) => {
				const time = prayerMap[id];
				const row = document.querySelector(`#row-${id}`);
				const timeEl = document.querySelector(`#time-${id}`);
				const statusEl = document.querySelector(`#status-${id}`);
				setText(timeEl, formatPrayerTime(time));
				if (time > now && !nextFound) {
					nextFound = true;
					setText(statusEl, 'Next ✓');
					statusEl?.classList.add('text-amber-accent', 'font-semibold');
					statusEl?.classList.remove('text-muted');
					row?.classList.add('bg-amber-50', 'dark:bg-amber-950/10');
				} else if (time < now && (i === prayerIds.length - 1 || prayerMap[prayerIds[i + 1]] > now)) {
					setText(statusEl, 'Current');
					statusEl?.classList.add('text-cyan-accent', 'font-semibold');
					statusEl?.classList.remove('text-muted');
					row?.classList.add('bg-cyan-50', 'dark:bg-cyan-950/10');
				} else {
					setText(statusEl, time > now ? 'Upcoming' : 'Passed');
					statusEl?.classList.remove('text-amber-accent', 'text-cyan-accent', 'font-semibold');
					statusEl?.classList.add('text-muted');
					row?.classList.remove('bg-amber-50', 'dark:bg-amber-950/10', 'bg-cyan-50', 'dark:bg-cyan-950/10');
				}
			});
			currentNextPrayer = times.nextPrayer;
			const nextName = document.querySelector('#nextPrayerName');
			const nextCountdown = document.querySelector('#nextPrayerCountdown');
			const nextTime = document.querySelector('#nextPrayerTime');
			if (times.nextPrayer) {
				setText(nextName, times.nextPrayer.name);
				setText(nextCountdown, formatRemaining(times.nextPrayer.time));
				setText(nextTime, `at ${formatPrayerTime(times.nextPrayer.time)}`);
			}
		}

		function onLocation(latitude: number, longitude: number) {
			coords = { latitude, longitude };
			render();
			window.clearInterval(timer);
			timer = window.setInterval(render, 30_000);
		}

		document.querySelector('#methodSelect')?.addEventListener('change', render);
		document.addEventListener('change', (e) => {
			const target = e.target as HTMLElement;
			if (target.matches('input[name="asrMethod"]')) render();
		});
		mountDeviceUi({ onLocation: (c: any) => onLocation(c.latitude, c.longitude) });
		document.addEventListener('oc:location-ready', (event) => {
			const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
			onLocation(detail.coords.latitude, detail.coords.longitude);
		});
	} else {
		mountDeviceUi({});
	}
</script>

<style>
	.mesh-gradient-bg {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1400px;
		height: 600px;
		opacity: 0.1;
		filter: blur(120px);
		background: 
			radial-gradient(circle at 10% 20%, #007cf0 0%, transparent 40%),
			radial-gradient(circle at 90% 30%, #00dfd8 0%, transparent 45%),
			radial-gradient(circle at 35% 70%, #7928ca 0%, transparent 40%),
			radial-gradient(circle at 65% 15%, #ff0080 0%, transparent 40%),
			radial-gradient(circle at 50% 50%, #f9cb28 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}
	[data-theme="light"] .mesh-gradient-bg {
		opacity: 0.06;
	}
</style>
