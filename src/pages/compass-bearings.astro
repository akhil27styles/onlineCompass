---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';

const bearings = [
	{ degrees: 0, cardinal: 'North', abbrev: 'N', nextCardinal: 'NNE' },
	{ degrees: 22.5, cardinal: 'North-Northeast', abbrev: 'NNE', nextCardinal: 'NE' },
	{ degrees: 45, cardinal: 'Northeast', abbrev: 'NE', nextCardinal: 'ENE' },
	{ degrees: 67.5, cardinal: 'East-Northeast', abbrev: 'ENE', nextCardinal: 'E' },
	{ degrees: 90, cardinal: 'East', abbrev: 'E', nextCardinal: 'ESE' },
	{ degrees: 112.5, cardinal: 'East-Southeast', abbrev: 'ESE', nextCardinal: 'SE' },
	{ degrees: 135, cardinal: 'Southeast', abbrev: 'SE', nextCardinal: 'SSE' },
	{ degrees: 157.5, cardinal: 'South-Southeast', abbrev: 'SSE', nextCardinal: 'S' },
	{ degrees: 180, cardinal: 'South', abbrev: 'S', nextCardinal: 'SSW' },
	{ degrees: 202.5, cardinal: 'South-Southwest', abbrev: 'SSW', nextCardinal: 'SW' },
	{ degrees: 225, cardinal: 'Southwest', abbrev: 'SW', nextCardinal: 'WSW' },
	{ degrees: 247.5, cardinal: 'West-Southwest', abbrev: 'WSW', nextCardinal: 'W' },
	{ degrees: 270, cardinal: 'West', abbrev: 'W', nextCardinal: 'WNW' },
	{ degrees: 292.5, cardinal: 'West-Northwest', abbrev: 'WNW', nextCardinal: 'NW' },
	{ degrees: 315, cardinal: 'Northwest', abbrev: 'NW', nextCardinal: 'NNW' },
	{ degrees: 337.5, cardinal: 'North-Northwest', abbrev: 'NNW', nextCardinal: 'N' },
];

const cardinalOnly = bearings.filter(b => b.degrees % 90 === 0);
const intercardinal = bearings.filter(b => b.degrees % 45 === 0 && b.degrees % 90 !== 0);
const halfQuarter = bearings.filter(b => b.degrees % 22.5 === 0 && b.degrees % 45 !== 0);
---

<Layout
	title="Compass Bearings Chart — Direction Reference | freeOnlinecompass.com"
	description="Complete compass bearings reference chart: 0° to 360° with cardinal and intercardinal direction names and abbreviations. Learn compass bearings for navigation."
	keywords="compass bearings, compass directions, bearing chart, 360 degree compass, cardinal directions, intercardinal directions, NNE, ENE, compass rose"
	canonical="https://freeonlinecompass.com/compass-bearings/"
>
	<SeoJsonLd
		slot="head"
		name="Compass Bearings Reference Chart"
		description="Complete compass bearing reference from 0° to 360° with cardinal and intercardinal names."
		url="https://freeonlinecompass.com/compass-bearings/"
	/>
	<div class="relative min-h-screen flex flex-col overflow-x-hidden bg-canvas-soft">
		<div class="mesh-gradient-bg" aria-hidden="true"></div>

		<SiteShell current="bearings" />

		<main id="main" class="flex-grow z-10">
			<section class="content-grid pt-8 pb-6 sm:pt-10 sm:pb-8 text-center relative z-20">
				<p class="font-mono text-xs uppercase text-muted tracking-widest" translate="no">freeOnlinecompass.com</p>
				<h1 class="mt-4 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-none tracking-tighter text-ink sm:text-5xl">
					Compass Bearings Reference
				</h1>
				<p class="mt-4 max-w-2xl mx-auto text-pretty text-sm leading-6 text-body">
					A complete reference chart for compass bearings from 0° to 360°, with cardinal and intercardinal direction names and abbreviations.
				</p>
			</section>

			<!-- Main Bearings Table -->
			<section class="py-6 sm:py-8">
				<div class="content-grid">
					<div class="rounded-panel border border-hairline bg-canvas card-elevated overflow-hidden">
						<div class="overflow-x-auto">
							<table class="w-full text-xs font-mono">
								<thead>
									<tr class="border-b border-hairline bg-canvas-soft-2">
										<th class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">Degrees</th>
										<th class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">Cardinal / Intercardinal Name</th>
										<th class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">Abbrev.</th>
										<th class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">Compass Point</th>
									</tr>
								</thead>
								<tbody>
									{bearings.map((b, i) => (
										<tr class:list={['border-b border-hairline last:border-0', i % 2 === 0 ? 'bg-canvas' : 'bg-canvas-soft-2/50']}>
											<td class="px-4 py-3 text-ink font-semibold">{b.degrees}°</td>
											<td class="px-4 py-3 text-body">{b.cardinal}</td>
											<td class="px-4 py-3 text-ink font-semibold">{b.abbrev}</td>
											<td class="px-4 py-3 text-muted">
												{b.degrees % 90 === 0 ? 'Cardinal' : b.degrees % 45 === 0 ? 'Intercardinal' : 'Half-quarter'}
											</td>
										</tr>
									))}
								</tbody>
							</table>
						</div>
					</div>
				</div>
			</section>

			<!-- Cardinal directions with visual -->
			<section class="py-8 sm:py-12">
				<div class="content-grid">
					<h2 class="text-xl font-semibold text-ink tracking-tight">Cardinal Directions</h2>
					<p class="mt-2 text-xs sm:text-sm text-body">The four main compass points, each 90° apart.</p>

					<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
						{cardinalOnly.map(b => (
							<div class="flex flex-col items-center gap-2 rounded-lg border border-hairline bg-canvas p-5 text-center card-elevated">
								<span class="text-3xl" aria-hidden="true">
									{b.degrees === 0 ? '↑' : b.degrees === 90 ? '→' : b.degrees === 180 ? '↓' : '←'}
								</span>
								<p class="text-base font-semibold text-ink">{b.cardinal}</p>
								<p class="font-mono text-xs text-body">{b.degrees}°</p>
							</div>
						))}
					</div>
				</div>
			</section>

			<!-- Educational content -->
			<section class="border-t border-hairline bg-canvas py-12 sm:py-16">
				<div class="content-grid">
					<div class="max-w-2xl">
						<p class="font-mono text-xs uppercase text-muted tracking-widest">Navigation Guide</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Understanding compass bearings.</h2>
					</div>
					<div class="mt-6 grid gap-6 sm:grid-cols-2">
						<article class="rounded border border-hairline bg-canvas-soft-2 p-5">
							<h3 class="text-sm font-semibold text-ink font-mono">What is a compass bearing?</h3>
							<p class="mt-3 text-xs leading-relaxed text-body">
								A compass bearing is a direction measured in degrees clockwise from North. 0° is always North, 90° is East, 180° is South, and 270° is West. A bearing of 315° points northwest.
							</p>
						</article>
						<article class="rounded border border-hairline bg-canvas-soft-2 p-5">
							<h3 class="text-sm font-semibold text-ink font-mono">The 32-point compass rose</h3>
							<p class="mt-3 text-xs leading-relaxed text-body">
								Traditional compasses divide the circle into 32 points, each 11.25° apart. The 16 main points (shown above) include all cardinal (N, E, S, W) and intercardinal (NE, SE, SW, NW) directions.
							</p>
						</article>
						<article class="rounded border border-hairline bg-canvas-soft-2 p-5">
							<h3 class="text-sm font-semibold text-ink font-mono">Reading bearings on a compass</h3>
							<p class="mt-3 text-xs leading-relaxed text-body">
								Hold the compass flat and let the needle settle. The red end points magnetic North. Rotate the bezel until the orienting arrow aligns with the needle — the bearing is read at the index line.
							</p>
						</article>
						<article class="rounded border border-hairline bg-canvas-soft-2 p-5">
							<h3 class="text-sm font-semibold text-ink font-mono">Azimuth vs Bearing</h3>
							<p class="mt-3 text-xs leading-relaxed text-body">
								Both azimuth and bearing describe horizontal direction. Azimuth is measured clockwise from North from 0° to 360°, which is the same as a bearing in this tool. Some navigation systems use different conventions.
							</p>
						</article>
					</div>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<style>
	.mesh-gradient-bg {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1400px;
		height: 600px;
		opacity: 0.1;
		filter: blur(120px);
		background: 
			radial-gradient(circle at 10% 20%, #007cf0 0%, transparent 40%),
			radial-gradient(circle at 90% 30%, #00dfd8 0%, transparent 45%),
			radial-gradient(circle at 35% 70%, #7928ca 0%, transparent 40%),
			radial-gradient(circle at 65% 15%, #ff0080 0%, transparent 40%),
			radial-gradient(circle at 50% 50%, #f9cb28 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}
	[data-theme="light"] .mesh-gradient-bg {
		opacity: 0.06;
	}
</style>