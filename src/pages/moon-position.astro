---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import LocationPrompt from '../components/LocationPrompt.astro';
import SkyDial from '../components/SkyDial.astro';

const facts = [
	['Moon Phases', 'The cycle of phases represents the changing fraction of the Moon illuminated by the Sun as observed from Earth. A full cycle (synodic month) takes roughly 29.53 days.'],
	['Moonrise and Moonset', 'The moments when the upper edge of the Moon crosses the horizon. The timing shifts by about 50 minutes later each day on average, corresponding to the Moon\'s orbital rotation.'],
	['Orbital Distance', 'The distance between the center of the Earth and the Moon. It ranges from ~356,400 km at perigee (closest point) to ~406,700 km at apogee (furthest point) due to its elliptical orbit.'],
	['Moon Elevation (Altitude)', 'The vertical angle between the Moon and the horizon. When the elevation is negative, the Moon is below the horizon and invisible to the observer.'],
];
---

<Layout
	title="Current Moon Position — Moon Phase, Moonrise, Moonset & Azimuth"
	description="See where the moon is right now from your location. Live moon phase, azimuth, altitude, moonrise and moonset times. Free mobile-friendly moon position tool."
	keywords="moon position, current moon position, moon phase today, moonrise moonset, moon azimuth, moon position now"
	canonical="https://freeonlinecompass.com/moon-position/"
>
	<SeoJsonLd
		slot="head"
		name="Moon Position — Online Compass"
		description="Live moon phase, azimuth, altitude, moonrise, and moonset for your location."
		url="https://freeonlinecompass.com/moon-position/"
	/>
	<div class="relative overflow-hidden min-h-screen flex flex-col bg-canvas-soft">
		<div class="mesh-gradient-bg" aria-hidden="true"></div>

		<SiteShell current="moon" />

		<main id="main" class="flex-grow z-10">
			<section class="content-grid pt-8 pb-6 sm:pt-10 sm:pb-8 text-center relative z-20">
				<p class="font-mono text-xs uppercase text-muted tracking-widest" translate="no">freeOnlinecompass.com</p>
				<h1 class="mt-4 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-none tracking-tighter text-ink sm:text-5xl">
					Current Moon Position
				</h1>
				<p class="mt-4 max-w-2xl mx-auto text-pretty text-sm leading-6 text-body">
					Live moon phase, direction, and moonrise or moonset for your location — auto-detected in your browser.
				</p>
			</section>

			<!-- Tool Grid -->
			<section class="py-6 sm:py-8">
				<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
					
					<!-- Left: Dial and calculations -->
					<div class="flex flex-col">
						<SkyDial id="moonDial" title="Moon Direction Now" subtitle="Lunar Tracking" />
						
						<!-- Moon Direction readout card -->
						<div class="rounded-panel border border-hairline bg-canvas p-6 card-elevated mt-6">
							<p class="font-mono text-[10px] uppercase text-muted tracking-wider text-center">Moon Direction</p>
							<h3 id="moonDirectionText" class="text-xl sm:text-2xl font-semibold tracking-tight text-white text-center mt-2">--</h3>
							<p class="text-xs text-body text-center font-mono mt-1"><span id="moonAzimuthRaw">--</span>° azimuth <span class="cursor-help text-muted" title="Measured clockwise from North (0°)">ⓘ</span></p>
						</div>

						<!-- Core Metrics Grid Header -->
						<h3 class="text-xs font-mono uppercase text-muted tracking-wider mt-6 mb-2 pl-1">Right Now</h3>

						<!-- Core Metrics Row (4-column) -->
						<div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
							<!-- 1. Phase Card with Custom SVG -->
							<div class="rounded-panel border border-hairline bg-canvas p-4 text-center card-elevated flex flex-col justify-between min-h-[140px]">
								<p class="font-mono text-[9px] uppercase text-muted tracking-wider">Phase</p>
								<div id="moonPhaseSvgContainer" class="size-11 mx-auto mt-2" aria-hidden="true">
									<!-- Dynamically injected math-accurate SVG -->
								</div>
								<div>
									<p id="moonPhaseNameVal" class="text-[11px] font-semibold text-white mt-2 truncate">--</p>
									<p id="moonIlluminationVal" class="text-[9px] text-body mt-0.5 font-mono">--% lit</p>
								</div>
							</div>

							<!-- 2. Altitude -->
							<div class="rounded-panel border border-hairline bg-canvas p-4 text-center card-elevated flex flex-col justify-between min-h-[140px]">
								<p class="font-mono text-[9px] uppercase text-muted tracking-wider">Altitude</p>
								<div class="my-auto">
									<p id="moonAltitudeVal" class="text-sm font-semibold text-white font-mono">--</p>
								</div>
								<p id="moonAltitudeHelp" class="text-[9px] text-body">--</p>
							</div>

							<!-- 3. Moonrise -->
							<div class="rounded-panel border border-hairline bg-canvas p-4 text-center card-elevated flex flex-col justify-between min-h-[140px]">
								<p class="font-mono text-[9px] uppercase text-muted tracking-wider">Moonrise</p>
								<div class="my-auto font-mono">
									<p id="moonriseTimeVal" class="text-sm font-semibold text-white">--</p>
								</div>
								<p class="text-[9px] text-body">local time</p>
							</div>

							<!-- 4. Moonset -->
							<div class="rounded-panel border border-hairline bg-canvas p-4 text-center card-elevated flex flex-col justify-between min-h-[140px]">
								<p class="font-mono text-[9px] uppercase text-muted tracking-wider">Moonset</p>
								<div class="my-auto font-mono">
									<p id="moonsetTimeVal" class="text-sm font-semibold text-white">--</p>
								</div>
								<p class="text-[9px] text-body">local time</p>
							</div>
						</div>
					</div>

					<!-- Right: Sidebar controls and secondary metrics -->
					<aside class="grid gap-6">
						<!-- Location settings panel -->
						<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="moon-location-title">
							<h2 id="moon-location-title" class="text-xs font-mono uppercase text-muted tracking-wider">Observer Coordinates</h2>
							<div class="mt-4">
								<LocationPrompt messageId="moonLocationNote" compact />
							</div>
						</section>

						<!-- Lunar metrics details -->
						<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="moon-times-title">
							<h2 id="moon-times-title" class="text-xs font-mono uppercase text-muted tracking-wider">Lunar Stats</h2>
							<dl class="mt-4 grid gap-3 text-xs">
								<div class="flex justify-between gap-4 border-t border-hairline pt-3">
									<dt class="text-body font-mono">Distance</dt>
									<dd id="moonDistance" class="font-mono text-white font-semibold">--</dd>
								</div>
								<div class="flex justify-between gap-4 border-t border-hairline pt-3">
									<dt class="text-body font-mono">Visibility</dt>
									<dd id="moonVisibility" class="font-mono text-white font-semibold">--</dd>
								</div>
							</dl>
						</section>
					</aside>
				</div>
			</section>

			<!-- Educational Info -->
			<section class="border-t border-hairline bg-canvas py-12 sm:py-16">
				<div class="content-grid">
					<div class="max-w-2xl">
						<p class="font-mono text-xs uppercase text-muted tracking-widest">Physics Reference</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-white sm:text-3xl">Understanding the lunar path.</h2>
						<p class="mt-3 text-xs sm:text-sm text-body leading-relaxed">
							The Moon orbiting Earth moves along an elliptical path inclined relative to Earth\'s equator, generating distinct phases and rise/set times that shift dynamically:
						</p>
					</div>
					<div class="mt-8 grid gap-4 sm:grid-cols-2">
						{facts.map(([title, body]) => (
							<article class="rounded border border-hairline bg-canvas-soft-2 p-5">
								<h3 class="text-sm font-semibold text-white font-mono">{title}</h3>
								<p class="mt-3 text-xs leading-relaxed text-body">{body}</p>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
	import { mountDeviceUi } from '../scripts/device-ui';
	import { formatDegrees, formatTime, getMoonSnapshot, getDirectionText, getMoonPhaseSvg } from '../lib/astronomy';

	const beacon = document.querySelector('#moonDialBeacon');
	const bodyEl = document.querySelector('#moonDialBody');
	const degrees = document.querySelector('#moonDialDegrees');
	const altitudeEl = document.querySelector('#moonDialAltitude');
	const status = document.querySelector('#moonDialStatus');
	const dialLocationCity = document.querySelector('#dialLocationCity');

	// Restructured core metrics
	const directionText = document.querySelector('#moonDirectionText');
	const rawAzimuth = document.querySelector('#moonAzimuthRaw');
	const coreAltitude = document.querySelector('#moonAltitudeVal');
	const coreAltitudeHelp = document.querySelector('#moonAltitudeHelp');
	const coreMoonrise = document.querySelector('#moonriseTimeVal');
	const coreMoonset = document.querySelector('#moonsetTimeVal');

	// Phase readouts
	const phaseSvgContainer = document.querySelector('#moonPhaseSvgContainer');
	const phaseNameVal = document.querySelector('#moonPhaseNameVal');
	const illuminationVal = document.querySelector('#moonIlluminationVal');

	let coords: { latitude: number; longitude: number } | null = null;
	let timer: number | undefined;

	function setText(el: Element | null, value: string) {
		if (el) el.textContent = value;
	}

	function formatMoonTime(date: Date | undefined, alwaysUp: boolean, alwaysDown: boolean, kind: 'rise' | 'set'): string {
		if (alwaysUp) return kind === 'rise' ? 'Always up' : '—';
		if (alwaysDown) return kind === 'set' ? 'Always down' : '—';
		return formatTime(date);
	}

	function renderMoon() {
		if (!coords) return;
		const snapshot = getMoonSnapshot(new Date(), { lat: coords.latitude, lng: coords.longitude });

		// Rotate beacon
		if (beacon instanceof HTMLElement) {
			beacon.style.setProperty('--azimuth', `${snapshot.azimuth}deg`);
		}
		
		// Polar projection translate: 0.8 is horizon boundary.
		if (bodyEl instanceof HTMLElement) {
			const ratio = 0.8 * (1 - snapshot.altitude / 90);
			bodyEl.style.setProperty('--distance-ratio', ratio.toFixed(4));
			
			if (!bodyEl.innerHTML) {
				bodyEl.innerHTML = `
					<svg viewBox="0 0 100 100" class="w-full h-full">
						<circle cx="50" cy="50" r="32" fill="url(#moonGlow)" opacity="0.35" />
						<circle cx="50" cy="50" r="22" fill="url(#moonCore)" stroke="#cbd5e1" stroke-width="0.6" />
						<!-- Craters -->
						<circle cx="42" cy="40" r="4" fill="#475569" opacity="0.16" />
						<circle cx="42" cy="40" r="3" fill="#334155" opacity="0.1" />
						
						<circle cx="62" cy="46" r="3" fill="#475569" opacity="0.16" />
						<circle cx="62" cy="46" r="2" fill="#334155" opacity="0.1" />
						
						<circle cx="48" cy="62" r="4.5" fill="#475569" opacity="0.16" />
						<circle cx="48" cy="62" r="3.5" fill="#334155" opacity="0.1" />
						
						<circle cx="58" cy="64" r="2" fill="#475569" opacity="0.12" />
						<circle cx="34" cy="52" r="1.5" fill="#475569" opacity="0.12" />
						<defs>
							<radialGradient id="moonGlow" cx="50%" cy="50%" r="50%">
								<stop offset="0%" stop-color="#f1f5f9" stop-opacity="1" />
								<stop offset="100%" stop-color="#cbd5e1" stop-opacity="0" />
							</radialGradient>
							<linearGradient id="moonCore" x1="0%" y1="0%" x2="100%" y2="100%">
								<stop offset="0%" stop-color="#f8fafc" />
								<stop offset="50%" stop-color="#e2e8f0" />
								<stop offset="100%" stop-color="#94a3b8" />
							</linearGradient>
						</defs>
					</svg>
				`;
			}
		}

		setText(degrees, Math.round(snapshot.azimuth).toString());
		setText(altitudeEl, `Altitude ${formatDegrees(snapshot.altitude)}`);
		setText(
			status,
			snapshot.isUp ? 'Moon is above the horizon' : 'Moon is below the horizon',
		);

		// Core direction and altitude readouts
		setText(directionText, getDirectionText(snapshot.azimuth));
		setText(rawAzimuth, Math.round(snapshot.azimuth).toString());
		setText(coreAltitude, formatDegrees(snapshot.altitude));
		setText(coreAltitudeHelp, snapshot.isUp ? 'above horizon' : 'below horizon');
		
		// Times
		setText(
			coreMoonrise,
			formatMoonTime(snapshot.times.rise, snapshot.times.alwaysUp, snapshot.times.alwaysDown, 'rise'),
		);
		setText(
			coreMoonset,
			formatMoonTime(snapshot.times.set, snapshot.times.alwaysUp, snapshot.times.alwaysDown, 'set'),
		);

		// Math-accurate SVG Moon Phase rendering
		if (phaseSvgContainer) {
			phaseSvgContainer.innerHTML = getMoonPhaseSvg(snapshot.illumination.phase);
		}
		setText(phaseNameVal, snapshot.illumination.phaseName);
		setText(illuminationVal, `${snapshot.illumination.percent}% lit`);

		// Sidebar details
		setText(document.querySelector('#moonDistance'), `${snapshot.distanceKm.toLocaleString()} km`);
		setText(document.querySelector('#moonVisibility'), snapshot.isUp ? 'Visible now' : 'Below horizon');
	}

	function onLocation(latitude: number, longitude: number) {
		coords = { latitude, longitude };
		renderMoon();
		window.clearInterval(timer);
		timer = window.setInterval(renderMoon, 30_000);
	}

	mountDeviceUi({
		onLocation: (c) => onLocation(c.latitude, c.longitude),
	});

	// Location Event Listeners
	document.addEventListener('oc:location-ready', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
		setText(status, 'Location ready');
		setText(dialLocationCity, `(${detail.coords.latitude.toFixed(4)}°, ${detail.coords.longitude.toFixed(4)}°)`);
	});

	document.addEventListener('oc:location-city-ready', (event) => {
		const detail = (event as CustomEvent<{ city: string; coords: { latitude: number; longitude: number } }>).detail;
		setText(dialLocationCity, `${detail.city} (${detail.coords.latitude.toFixed(4)}°, ${detail.coords.longitude.toFixed(4)}°)`);
	});

	document.addEventListener('oc:location-needs-permission', () => {
		setText(status, 'Permission needed');
	});

	document.addEventListener('oc:location-denied', () => {
		setText(status, 'Location blocked');
	});
</script>

<style>
	/* Mesh background */
	.mesh-gradient-bg {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1400px;
		height: 600px;
		opacity: 0.1;
		filter: blur(120px);
		background: 
			radial-gradient(circle at 10% 20%, #007cf0 0%, transparent 40%),
			radial-gradient(circle at 90% 30%, #00dfd8 0%, transparent 45%),
			radial-gradient(circle at 35% 70%, #7928ca 0%, transparent 40%),
			radial-gradient(circle at 65% 15%, #ff0080 0%, transparent 40%),
			radial-gradient(circle at 50% 50%, #f9cb28 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}

	#moonDialBody {
		background: radial-gradient(circle, #f3f4f6, #9ca3af);
		box-shadow: 0 0 14px rgba(255, 255, 255, 0.4), 0 0 4px #ffffff;
	}
</style>
