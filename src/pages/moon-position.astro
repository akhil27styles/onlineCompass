---
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import DevicePanel from '../components/DevicePanel.astro';
import LocationPrompt from '../components/LocationPrompt.astro';
import SkyDial from '../components/SkyDial.astro';

const facts = [
	['Moon Phase', 'Illuminated fraction of the moon’s visible disk, from new moon to full moon.'],
	['Azimuth', 'Compass direction toward the moon along the horizon circle.'],
	['Moonrise / Moonset', 'Times when the moon crosses the horizon — can be missing on some days near the poles.'],
	['Distance', 'Approximate distance to the moon in kilometers, useful for understanding apparent size.'],
];
---

<Layout
	title="Moon Position - Online Compass | freeOnlinecompass.com"
	description="Track moon phase, azimuth, altitude, moonrise, and moonset for your location with a privacy-friendly browser moon position tool."
	canonical="https://freeonlinecompass.com/moon-position/"
>
	<SiteHeader current="moon" />

	<main id="main">
		<section class="border-b border-hairline bg-canvas-soft pt-8 pb-6 sm:pt-12 lg:pb-14">
			<div class="content-grid grid gap-8 lg:grid-cols-[minmax(0,1fr)_360px] lg:items-start">
				<div class="min-w-0">
					<p class="font-mono text-xs uppercase text-muted" translate="no">freeOnlinecompass.com</p>
					<h1 class="mt-3 max-w-3xl text-balance text-4xl font-semibold leading-none tracking-tight text-ink sm:text-5xl">
						Moon Position
					</h1>
					<p class="mt-4 max-w-2xl text-pretty text-base leading-7 text-body sm:text-lg">
						Current moon phase, direction, altitude, and tonight’s moonrise and moonset — updated from your location.
					</p>
				</div>
				<DevicePanel />
			</div>
		</section>

		<section class="bg-white py-6 sm:py-12">
			<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_360px]">
				<div class="grid gap-6">
					<SkyDial id="moonDial" title="Moon Direction Now" subtitle="Live Sky" />

					<section class="rounded-panel border border-hairline bg-canvas-soft p-4 sm:p-5" aria-labelledby="moon-phase-title">
						<h2 id="moon-phase-title" class="text-sm font-semibold">Moon Phase</h2>
						<div class="mt-4 flex flex-wrap items-center gap-6">
							<div class="moon-phase-disc" id="moonPhaseDisc" aria-hidden="true"></div>
							<div>
								<p id="moonPhaseName" class="text-xl font-semibold tracking-tight text-ink">--</p>
								<p id="moonIllumination" class="mt-1 font-mono text-sm text-body">-- illuminated</p>
							</div>
						</div>
					</section>
				</div>

				<aside class="grid gap-6">
					<section class="rounded-panel border border-hairline bg-canvas-soft p-4" aria-labelledby="moon-times-title">
						<h2 id="moon-times-title" class="text-sm font-semibold">Today’s Moon Times</h2>
						<dl class="mt-4 grid gap-3 text-sm">
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Moonrise</dt>
								<dd id="moonriseTime" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Moonset</dt>
								<dd id="moonsetTime" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Distance</dt>
								<dd id="moonDistance" class="font-mono text-ink">--</dd>
							</div>
							<div class="flex justify-between gap-4 border-t border-hairline pt-3">
								<dt class="text-body">Visibility</dt>
								<dd id="moonVisibility" class="font-mono text-ink">--</dd>
							</div>
						</dl>
					</section>

					<section class="rounded-panel border border-hairline bg-white p-4" aria-labelledby="moon-location-title">
						<h2 id="moon-location-title" class="text-sm font-semibold">Your Location</h2>
						<LocationPrompt messageId="moonLocationNote" compact />
					</section>
				</aside>
			</div>
		</section>

		<section class="border-t border-hairline bg-canvas-soft py-10 sm:py-14">
			<div class="content-grid">
				<div class="max-w-2xl">
					<p class="font-mono text-xs uppercase text-muted">Reference</p>
					<h2 class="mt-2 text-3xl font-semibold tracking-tight">How to read moon position</h2>
				</div>
				<div class="mt-8 grid gap-3 sm:grid-cols-2">
					{
						facts.map(([title, body]) => (
							<article class="rounded-panel border border-hairline bg-white p-5">
								<h3 class="text-base font-semibold">{title}</h3>
								<p class="mt-3 text-sm leading-6 text-body">{body}</p>
							</article>
						))
					}
				</div>
			</div>
		</section>
	</main>

	<SiteFooter />
</Layout>

<script>
	import { mountDeviceUi } from '../scripts/device-ui';
	import { formatDegrees, formatTime, getMoonSnapshot } from '../lib/astronomy';

	const beacon = document.querySelector('#moonDialBeacon');
	const degrees = document.querySelector('#moonDialDegrees');
	const altitudeEl = document.querySelector('#moonDialAltitude');
	const status = document.querySelector('#moonDialStatus');
	const phaseDisc = document.querySelector('#moonPhaseDisc');

	let coords: { latitude: number; longitude: number } | null = null;
	let timer: number | undefined;

	function setText(el: Element | null, value: string) {
		if (el) el.textContent = value;
	}

	function formatMoonTime(date: Date | undefined, alwaysUp: boolean, alwaysDown: boolean, kind: 'rise' | 'set'): string {
		if (alwaysUp) return kind === 'rise' ? 'Always up' : '—';
		if (alwaysDown) return kind === 'set' ? 'Always down' : '—';
		return formatTime(date);
	}

	function renderMoon() {
		if (!coords) return;
		const snapshot = getMoonSnapshot(new Date(), { lat: coords.latitude, lng: coords.longitude });

		if (beacon instanceof HTMLElement) {
			beacon.style.setProperty('--azimuth', `${snapshot.azimuth}deg`);
		}
		setText(degrees, Math.round(snapshot.azimuth).toString());
		setText(altitudeEl, `Altitude ${formatDegrees(snapshot.altitude)}`);
		setText(
			status,
			snapshot.isUp ? 'Moon is above the horizon' : 'Moon is below the horizon',
		);

		setText(document.querySelector('#moonPhaseName'), snapshot.illumination.phaseName);
		setText(document.querySelector('#moonIllumination'), `${snapshot.illumination.percent}% illuminated`);
		setText(
			document.querySelector('#moonriseTime'),
			formatMoonTime(snapshot.times.rise, snapshot.times.alwaysUp, snapshot.times.alwaysDown, 'rise'),
		);
		setText(
			document.querySelector('#moonsetTime'),
			formatMoonTime(snapshot.times.set, snapshot.times.alwaysUp, snapshot.times.alwaysDown, 'set'),
		);
		setText(document.querySelector('#moonDistance'), `${snapshot.distanceKm.toLocaleString()} km`);
		setText(document.querySelector('#moonVisibility'), snapshot.isUp ? 'Visible now' : 'Below horizon');

		if (phaseDisc instanceof HTMLElement) {
			const lit = snapshot.illumination.fraction;
			const angle = snapshot.illumination.phase * 360;
			phaseDisc.style.background = `conic-gradient(from ${angle}deg, #171717 ${lit * 50}%, #ebebeb ${lit * 50}% 100%)`;
		}
	}

	function onLocation(latitude: number, longitude: number) {
		coords = { latitude, longitude };
		renderMoon();
		window.clearInterval(timer);
		timer = window.setInterval(renderMoon, 30_000);
	}

	mountDeviceUi({
		onLocation: (c) => onLocation(c.latitude, c.longitude),
	});

	document.addEventListener('oc:location-ready', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
		setText(status, 'Location ready');
	});

	document.addEventListener('oc:location-needs-permission', () => {
		setText(status, 'Allow location to continue');
	});

	document.addEventListener('oc:location-denied', () => {
		setText(status, 'Location needed');
	});
</script>

<style>
	.moon-phase-disc {
		width: 88px;
		height: 88px;
		border-radius: 50%;
		border: 1px solid var(--color-hairline);
		box-shadow: inset 0 0 0 6px #ffffff;
	}
</style>
