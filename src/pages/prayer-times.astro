---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import LocationPrompt from '../components/LocationPrompt.astro';
import AdSlot from '../components/AdSlot.astro';
import { CALCULATION_METHODS } from '../lib/prayer-times';

const faqs = [
	['What are the 5 times of prayer for salah?', 'The five daily prayers in Islam are: Fajr (dawn), Dhuhr (midday), Asr (afternoon), Maghrib (sunset), and Isha (night). Each prayer corresponds to a specific part of the day determined by the sun\'s position. Times vary daily based on latitude and season.'],
	['What are the timings for salah?', 'Prayer times are calculated based on your location\'s latitude, longitude, and the selected calculation method. This tool displays exact prayer times for your area. Generally: Fajr 1-2 hours before sunrise, Dhuhr around solar noon, Asr mid-afternoon, Maghrib at sunset, Isha 1-1.5 hours after sunset.'],
	['Can I pray Fajr at 4.30 am?', 'Fajr time is specific to your location and date (determined by true dawn, not clock time). Fajr at 4:30 AM is only valid if that is the calculated dawn time for your coordinates. Earlier prayer (before dawn) is not valid. Use this tool to find exact Fajr time for your location.'],
	['When to pray ishraq and chasht?', 'Ishraq is prayed 15-20 minutes after sunrise (voluntary). Chasht is midday prayer, typically prayed around 20 minutes before Dhuhr (also voluntary). These are not among the five obligatory prayers but are recommended in Islamic tradition.'],
	['What is the 7 7 7 rule in Islam?', 'This refers to personal daily practices: 7 verses of Quran, 7 prayers, 7 good deeds, done 7 days a week. However, there is no strict "7-7-7 rule" in Islamic jurisprudence. The actual obligations are the five daily prayers (Fajr, Dhuhr, Asr, Maghrib, Isha).'],
	['Why do Muslims pray 5x per day?', 'The five daily prayers are commanded by Allah in the Quran and are one of the Five Pillars of Islam. They keep believers connected to God throughout the day, promote discipline, and mark important times in Earth\'s daily rotation.'],
	['Can I pray Maghrib 15 minutes early?', 'No. Maghrib prayer begins precisely at sunset (when the sun\'s upper edge disappears below the horizon). Praying before sunset invalidates the prayer. If you must pray early, pray the previous prayer (Asr) instead.'],
	['Who calls Muslims to prayer 5 times a day?', 'The Muezzin (Islamic official) traditionally gives the call to prayer (Adhan) from the mosque five times daily. Recorded Adhans or app notifications also remind Muslims of prayer times. Each Muslim is responsible for praying within the prayer window.'],
	['What is the correct time to pray?', 'Each prayer has a specific time window based on the sun\'s position: Fajr from dawn until sunrise, Dhuhr from solar noon until Asr begins, Asr begins and continues until sunset, Maghrib begins at sunset until Isha, Isha from twilight until dawn. This tool displays exact windows.'],
	['Is it haram to pray 10 minutes before sunrise?', 'Yes. Fajr prayer must be within the Fajr prayer window (from true dawn until sunrise begins). Praying before dawn is not valid. If you miss Fajr, you can make it up (Qaza) after sunrise with the proper intention.'],
	['Are Muslims allowed to say "Oh my god"?', 'Islamic scholars have varying opinions. Some consider it acceptable as a casual expression (similar to "my goodness"). Others prefer "SubhanAllah" (Glorified is Allah). It\'s generally acceptable but "Alhamdulillah" (Praise be to Allah) is preferred in Islamic context.'],
	['Which namaz increases beauty?', 'There is no specific prayer that "increases beauty." However, prayers and spiritual practices are believed to bring inner peace and contentment, which manifests as outer tranquility and dignity. Regular prayer (Salah) is encouraged for all spiritual benefits.'],
];
---

<Layout
	title="Prayer Times Today — Fajr, Dhuhr, Asr, Maghrib, Isha | trulycompass.com"
	description="Accurate daily prayer times for your location. Fajr, Dhuhr, Asr, Maghrib, Isha with live countdown. Multiple calculation methods. Free mobile-friendly."
	keywords="prayer times, salah times, fajr time, dhuhr time, asr time, maghrib time, isha time, islamic prayer times, namaz times"
	canonical="https://trulycompass.com/prayer-times/"
>
	<SeoJsonLd
		slot="head"
		name="Prayer Times — Truly Compass"
		description="Daily prayer times with live countdown to next prayer. Multiple calculation methods."
		url="https://trulycompass.com/prayer-times/"
	/>
	<div class="relative min-h-screen flex flex-col overflow-x-hidden bg-canvas-soft">
		<div class="mesh-gradient-bg" aria-hidden="true"></div>

		<SiteShell current="prayer-times" />

		<main id="main" class="flex-grow z-10">
			<section class="content-grid pt-8 pb-6 sm:pt-10 sm:pb-8 text-center relative z-20">
				<p class="font-mono text-xs uppercase text-muted tracking-widest" translate="no">trulycompass.com</p>
				<h1 class="mt-4 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-none tracking-tighter text-ink sm:text-5xl">
					Prayer Times
				</h1>
				<p class="mt-4 max-w-2xl mx-auto text-pretty text-sm leading-6 text-body">
					Daily prayer times for your location. Select your calculation method for accurate Fajr, Dhuhr, Asr, Maghrib, and Isha times.
				</p>
			</section>

			<section class="py-6 sm:py-8">
				<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">

					<!-- Left: Main content -->
					<div class="flex flex-col">
						<!-- Next Prayer Countdown -->
						<div class="rounded-panel border border-hairline bg-canvas p-6 card-elevated text-center">
							<p class="font-mono text-[10px] uppercase text-muted tracking-wider">Next Prayer</p>
							<p id="nextPrayerName" class="mt-2 text-lg font-semibold text-ink font-mono">--</p>
							<p id="nextPrayerCountdown" class="mt-1 text-3xl sm:text-4xl font-semibold tracking-tight text-ink font-mono">--</p>
							<p id="nextPrayerTime" class="text-xs text-body mt-1 font-mono"></p>
						</div>

						<!-- Method & Hanafi Controls -->
						<div class="rounded-panel border border-hairline bg-canvas p-4 card-elevated mt-4">
							<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
								<div class="flex flex-col gap-1.5">
									<label for="methodSelect" class="text-[10px] font-mono text-muted uppercase tracking-wider">Calculation Method</label>
									<select
										id="methodSelect"
										class="focus-ring rounded-md border border-hairline bg-canvas-soft-2 px-3 py-2 text-xs font-mono text-ink"
									>
										{CALCULATION_METHODS.map(m => (
											<option value={m.id} selected={m.id === 'mwl'}>{m.name}</option>
										))}
									</select>
								</div>
								<div class="flex flex-col gap-1.5">
									<span class="text-[10px] font-mono text-muted uppercase tracking-wider">Asr Calculation</span>
									<div class="flex gap-2">
										<label class="flex items-center gap-2 cursor-pointer rounded-md border border-hairline bg-canvas-soft-2 px-3 py-2 text-xs font-mono text-ink">
											<input type="radio" name="asrMethod" value="shafii" checked class="accent-ink w-3 h-3" />
											Shafi'i / Maliki / Hanbali
										</label>
										<label class="flex items-center gap-2 cursor-pointer rounded-md border border-hairline bg-canvas-soft-2 px-3 py-2 text-xs font-mono text-ink">
											<input type="radio" name="asrMethod" value="hanafi" class="accent-ink w-3 h-3" />
											Hanafi
										</label>
									</div>
								</div>
							</div>
						</div>

						<!-- Prayer Times Table -->
						<div class="rounded-panel border border-hairline bg-canvas card-elevated mt-4 overflow-hidden">
							<div class="overflow-x-auto">
								<table id="prayerTable" class="w-full text-xs font-mono">
									<thead>
										<tr class="border-b border-hairline bg-canvas-soft-2">
											<th scope="col" class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">Prayer</th>
											<th scope="col" class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">Time</th>
											<th scope="col" class="px-4 py-3 text-left font-semibold text-ink uppercase tracking-wider text-[10px]">Status</th>
										</tr>
									</thead>
									<tbody>
										<tr id="row-fajr" class="border-b border-hairline">
											<td class="px-4 py-3 font-semibold text-ink">Fajr</td>
											<td id="time-fajr" class="px-4 py-3 text-body">--</td>
											<td id="status-fajr" class="px-4 py-3 text-muted">--</td>
										</tr>
										<tr id="row-dhuhr" class="border-b border-hairline">
											<td class="px-4 py-3 font-semibold text-ink">Dhuhr</td>
											<td id="time-dhuhr" class="px-4 py-3 text-body">--</td>
											<td id="status-dhuhr" class="px-4 py-3 text-muted">--</td>
										</tr>
										<tr id="row-asr" class="border-b border-hairline">
											<td class="px-4 py-3 font-semibold text-ink">Asr</td>
											<td id="time-asr" class="px-4 py-3 text-body">--</td>
											<td id="status-asr" class="px-4 py-3 text-muted">--</td>
										</tr>
										<tr id="row-maghrib" class="border-b border-hairline">
											<td class="px-4 py-3 font-semibold text-ink">Maghrib</td>
											<td id="time-maghrib" class="px-4 py-3 text-body">--</td>
											<td id="status-maghrib" class="px-4 py-3 text-muted">--</td>
										</tr>
										<tr id="row-isha" class="border-b border-hairline last:border-0">
											<td class="px-4 py-3 font-semibold text-ink">Isha</td>
											<td id="time-isha" class="px-4 py-3 text-body">--</td>
											<td id="status-isha" class="px-4 py-3 text-muted">--</td>
										</tr>
									</tbody>
								</table>
							</div>
						</div>
					</div>

					<!-- Right: Sidebar -->
					<aside class="grid gap-6">
						<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="pt-location-title">
							<h2 id="pt-location-title" class="text-xs font-mono uppercase text-muted tracking-wider">Observer Coordinates</h2>
							<div class="mt-4">
								<LocationPrompt messageId="ptLocationNote" compact showAlert={false}/>
							</div>
						</section>

						<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="pt-method-title">
							<h2 id="pt-method-title" class="text-xs font-mono uppercase text-muted tracking-wider">About Methods</h2>
							<p class="mt-3 text-xs text-body leading-relaxed">
								Prayer times vary by calculation method due to different Fajr and Isha solar depression angles. The Muslim World League (MWL) method is the most widely used internationally and is the default here. Select the method followed by your local mosque.
							</p>
							<div class="mt-3 flex items-center gap-2">
								<a
									class="focus-ring inline-flex items-center gap-1 rounded-md border border-hairline bg-canvas px-3 py-1.5 text-[10px] font-mono text-body hover:border-hairline-strong hover:text-ink transition-colors"
									href="/qibla-compass/"
								>
									🕋 Find Qibla Direction
								</a>
							</div>
						</section>

						<AdSlot id="ad-pt-sidebar" format="vertical" />
					</aside>
				</div>
			</section>

			<!-- Educational Info -->
			<section class="border-t border-hairline bg-canvas py-12 sm:py-16">
				<div class="content-grid">
					<div class="max-w-2xl">
						<p class="font-mono text-xs uppercase text-muted tracking-widest">Islamic Reference</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Understanding prayer times.</h2>
						<p class="mt-3 text-xs sm:text-sm text-body leading-relaxed">
							Prayer times are determined by the position of the sun in the sky. Each of the five daily prayers has a defined window based on solar measurements that have been used for over 1,400 years.
						</p>
					</div>
					<div class="mt-8 grid gap-4 sm:grid-cols-2">
						{faqs.map(([title, body]) => (
							<article class="rounded border border-hairline bg-canvas-soft-2 p-5">
								<h3 class="text-sm font-semibold text-ink font-mono">{title}</h3>
								<p class="mt-3 text-xs leading-relaxed text-body">{body}</p>
							</article>
						))}
					</div>
				</div>
			</section>
		</main>

		<!-- FAQ Section -->
		<section id="faq" class="border-t border-hairline bg-canvas py-12 sm:py-16">
			<div class="content-grid">
				<div class="max-w-2xl">
					<p class="font-mono text-xs uppercase text-muted tracking-widest">FAQ</p>
					<h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Common questions about prayer times.</h2>
				</div>
				<div class="mt-8 grid gap-3">
					{faqs.map(([question, answer]) => (
						<details class="group rounded border border-hairline bg-canvas-soft-2 p-4 transition-colors [&_summary]:open:text-ink">
							<summary class="focus-ring cursor-pointer list-none text-xs font-semibold text-body hover:text-ink font-mono flex items-center justify-between">
								<span>{question}</span>
								<span class="text-[14px] text-muted transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
							</summary>
							<p class="mt-3 text-xs leading-relaxed text-body border-t border-hairline pt-3">{answer}</p>
						</details>
					))}
				</div>
			</div>
		</section>

		<SiteFooter />
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{"@type": "Question", "name": "What are the 5 times of prayer for salah?", "acceptedAnswer": {"@type": "Answer", "text": "The five daily prayers in Islam are: Fajr (dawn), Dhuhr (midday), Asr (afternoon), Maghrib (sunset), and Isha (night). Each prayer corresponds to a specific part of the day determined by the sun's position. Times vary daily based on latitude and season."}},
					{"@type": "Question", "name": "What are the timings for salah?", "acceptedAnswer": {"@type": "Answer", "text": "Prayer times are calculated based on your location's latitude, longitude, and the selected calculation method. This tool displays exact prayer times for your area. Generally: Fajr 1-2 hours before sunrise, Dhuhr around solar noon, Asr mid-afternoon, Maghrib at sunset, Isha 1-1.5 hours after sunset."}},
					{"@type": "Question", "name": "Can I pray Fajr at 4.30 am?", "acceptedAnswer": {"@type": "Answer", "text": "Fajr time is specific to your location and date (determined by true dawn, not clock time). Fajr at 4:30 AM is only valid if that is the calculated dawn time for your coordinates. Earlier prayer (before dawn) is not valid. Use this tool to find exact Fajr time for your location."}},
					{"@type": "Question", "name": "When to pray ishraq and chasht?", "acceptedAnswer": {"@type": "Answer", "text": "Ishraq is prayed 15-20 minutes after sunrise (voluntary). Chasht is midday prayer, typically prayed around 20 minutes before Dhuhr (also voluntary). These are not among the five obligatory prayers but are recommended in Islamic tradition."}},
					{"@type": "Question", "name": "What is the 7 7 7 rule in Islam?", "acceptedAnswer": {"@type": "Answer", "text": "This refers to personal daily practices: 7 verses of Quran, 7 prayers, 7 good deeds, done 7 days a week. However, there is no strict '7-7-7 rule' in Islamic jurisprudence. The actual obligations are the five daily prayers (Fajr, Dhuhr, Asr, Maghrib, Isha)."}},
					{"@type": "Question", "name": "Why do Muslims pray 5x per day?", "acceptedAnswer": {"@type": "Answer", "text": "The five daily prayers are commanded by Allah in the Quran and are one of the Five Pillars of Islam. They keep believers connected to God throughout the day, promote discipline, and mark important times in Earth's daily rotation."}},
					{"@type": "Question", "name": "Can I pray Maghrib 15 minutes early?", "acceptedAnswer": {"@type": "Answer", "text": "No. Maghrib prayer begins precisely at sunset (when the sun's upper edge disappears below the horizon). Praying before sunset invalidates the prayer. If you must pray early, pray the previous prayer (Asr) instead."}},
					{"@type": "Question", "name": "Who calls Muslims to prayer 5 times a day?", "acceptedAnswer": {"@type": "Answer", "text": "The Muezzin (Islamic official) traditionally gives the call to prayer (Adhan) from the mosque five times daily. Recorded Adhans or app notifications also remind Muslims of prayer times. Each Muslim is responsible for praying within the prayer window."}},
					{"@type": "Question", "name": "What is the correct time to pray?", "acceptedAnswer": {"@type": "Answer", "text": "Each prayer has a specific time window based on the sun's position: Fajr from dawn until sunrise, Dhuhr from solar noon until Asr begins, Asr begins and continues until sunset, Maghrib begins at sunset until Isha, Isha from twilight until dawn. This tool displays exact windows."}},
					{"@type": "Question", "name": "Is it haram to pray 10 minutes before sunrise?", "acceptedAnswer": {"@type": "Answer", "text": "Yes. Fajr prayer must be within the Fajr prayer window (from true dawn until sunrise begins). Praying before dawn is not valid. If you miss Fajr, you can make it up (Qaza) after sunrise with the proper intention."}},
					{"@type": "Question", "name": "Are Muslims allowed to say 'Oh my god'?", "acceptedAnswer": {"@type": "Answer", "text": "Islamic scholars have varying opinions. Some consider it acceptable as a casual expression (similar to 'my goodness'). Others prefer 'SubhanAllah' (Glorified is Allah). It's generally acceptable but 'Alhamdulillah' (Praise be to Allah) is preferred in Islamic context."}},
					{"@type": "Question", "name": "Which namaz increases beauty?", "acceptedAnswer": {"@type": "Answer", "text": "There is no specific prayer that 'increases beauty.' However, prayers and spiritual practices are believed to bring inner peace and contentment, which manifests as outer tranquility and dignity. Regular prayer (Salah) is encouraged for all spiritual benefits."}}
				]
			}
		</script>
	</div>
</Layout>

<script>
	import { prefetchLocationSilently } from '../lib/geo';
	import { mountDeviceUi } from '../scripts/device-ui';
	import { getPrayerTimes, formatPrayerTime, formatRemaining, CALCULATION_METHODS } from '../lib/prayer-times';

	prefetchLocationSilently();

	let coords: { latitude: number; longitude: number } | null = null;
	let timer: number | undefined;
	let currentNextPrayer: { name: string; time: Date } | null = null;

	const prayerIds = ['fajr', 'dhuhr', 'asr', 'maghrib', 'isha'];
	const prayerNames = ['Fajr', 'Dhuhr', 'Asr', 'Maghrib', 'Isha'];

	function setText(el: Element | null, value: string) {
		if (el) el.textContent = value;
	}

	function render() {
		if (!coords) return;

		const methodSelect = document.querySelector('#methodSelect') as HTMLSelectElement;
		const hanafiRadio = document.querySelector('input[name="asrMethod"]:checked') as HTMLInputElement;
		const methodId = methodSelect?.value || 'mwl';
		const hanafi = hanafiRadio?.value === 'hanafi';

		const times = getPrayerTimes(new Date(), coords.latitude, coords.longitude, methodId, hanafi);
		const now = new Date();

		const prayerMap: Record<string, Date> = {
			fajr: times.fajr,
			dhuhr: times.dhuhr,
			asr: times.asr,
			maghrib: times.maghrib,
			isha: times.isha,
		};

		let nextFound = false;

		prayerIds.forEach((id, i) => {
			const time = prayerMap[id];
			const row = document.querySelector(`#row-${id}`);
			const timeEl = document.querySelector(`#time-${id}`);
			const statusEl = document.querySelector(`#status-${id}`);

			setText(timeEl, formatPrayerTime(time));

			if (time > now && !nextFound) {
				nextFound = true;
				setText(statusEl, 'Next ✓');
				statusEl?.classList.add('text-amber-accent', 'font-semibold');
				statusEl?.classList.remove('text-muted');
				row?.classList.add('bg-amber-50', 'dark:bg-amber-950/10');
			} else if (time < now && (i === prayerIds.length - 1 || prayerMap[prayerIds[i + 1]] > now)) {
				setText(statusEl, 'Current');
				statusEl?.classList.add('text-cyan-accent', 'font-semibold');
				statusEl?.classList.remove('text-muted');
				row?.classList.add('bg-cyan-50', 'dark:bg-cyan-950/10');
			} else {
				setText(statusEl, time > now ? 'Upcoming' : 'Passed');
				statusEl?.classList.remove('text-amber-accent', 'text-cyan-accent', 'font-semibold');
				statusEl?.classList.add('text-muted');
				row?.classList.remove('bg-amber-50', 'dark:bg-amber-950/10', 'bg-cyan-50', 'dark:bg-cyan-950/10');
			}
		});

		currentNextPrayer = times.nextPrayer;
		const nextName = document.querySelector('#nextPrayerName');
		const nextCountdown = document.querySelector('#nextPrayerCountdown');
		const nextTime = document.querySelector('#nextPrayerTime');

		if (times.nextPrayer) {
			setText(nextName, times.nextPrayer.name);
			setText(nextCountdown, formatRemaining(times.nextPrayer.time));
			setText(nextTime, `at ${formatPrayerTime(times.nextPrayer.time)}`);
		}
	}

	function onLocation(latitude: number, longitude: number) {
		coords = { latitude, longitude };
		render();
		window.clearInterval(timer);
		timer = window.setInterval(render, 30_000);
	}

	document.querySelector('#methodSelect')?.addEventListener('change', render);
	document.querySelectorAll('input[name="asrMethod"]').forEach(el => {
		el.addEventListener('change', render);
	});

	mountDeviceUi({
		onLocation: (c) => onLocation(c.latitude, c.longitude),
	});

	document.addEventListener('oc:location-ready', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
	});
</script>

<style>
	.mesh-gradient-bg {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1400px;
		height: 600px;
		opacity: 0.1;
		filter: blur(120px);
		background: 
			radial-gradient(circle at 10% 20%, #007cf0 0%, transparent 40%),
			radial-gradient(circle at 90% 30%, #00dfd8 0%, transparent 45%),
			radial-gradient(circle at 35% 70%, #7928ca 0%, transparent 40%),
			radial-gradient(circle at 65% 15%, #ff0080 0%, transparent 40%),
			radial-gradient(circle at 50% 50%, #f9cb28 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}
	[data-theme="light"] .mesh-gradient-bg {
		opacity: 0.06;
	}
</style>
