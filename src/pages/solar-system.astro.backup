---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
---

<Layout
	title="3D Solar System Explorer — Interactive Planet Viewer"
	description="Explore our solar system in stunning 3D. View planets, moons, and satellites with real-time orbits and detailed information. Interactive space exploration."
	keywords="3D solar system, planets, space, astronomy, solar system explorer, interactive planets"
	canonical="https://freeonlinecompass.com/solar-system/"
>
	<SeoJsonLd
		slot="head"
		name="3D Solar System — Online Compass"
		description="Interactive 3D solar system with planets, moons, and satellites."
		url="https://freeonlinecompass.com/solar-system/"
	/>
	<div class="relative min-h-screen flex flex-col overflow-hidden bg-canvas-soft">
		<SiteShell current="solar-system" />

		<main id="main" class="flex-grow relative">
			<!-- 3D Canvas -->
			<div id="solarSystemCanvas" class="fixed inset-0 z-0"></div>

			<!-- UI Overlay -->
			<div class="relative z-10 pointer-events-none">
				<!-- Header Info -->
				<div class="content-grid pt-4 sm:pt-6 pb-3 sm:pb-4 pointer-events-auto">
					<div class="flex items-center justify-between gap-2 sm:gap-4 bg-canvas/90 backdrop-blur-md rounded-lg border border-hairline p-3 sm:p-4">
						<div class="min-w-0">
							<h1 class="text-lg sm:text-2xl font-semibold tracking-tight text-ink truncate">3D Solar System</h1>
							<p class="text-[10px] sm:text-xs text-body mt-0.5 sm:mt-1">Explore planets, moons, and satellites</p>
						</div>
						<button id="resetCamera" class="shrink-0 rounded-md bg-ink px-3 sm:px-4 py-2 text-xs sm:text-sm font-semibold text-canvas hover:opacity-90 transition-opacity">
							<span class="hidden sm:inline">Reset View</span>
							<span class="sm:hidden">Reset</span>
						</button>
					</div>
				</div>

				<!-- Planet Info Panel (initially hidden) -->
				<div id="planetInfo" class="fixed right-2 sm:right-4 top-20 sm:top-24 w-[calc(100%-1rem)] sm:w-80 max-w-sm bg-canvas/95 backdrop-blur-md rounded-lg border border-hairline p-4 sm:p-5 shadow-lg hidden pointer-events-auto max-h-[60vh] sm:max-h-[70vh] overflow-y-auto">
					<div class="flex items-start justify-between gap-3 mb-3 sm:mb-4">
						<div class="flex-1 min-w-0">
							<h2 id="planetName" class="text-lg sm:text-xl font-semibold text-ink truncate">Planet Name</h2>
							<p id="planetType" class="text-[10px] sm:text-xs text-muted uppercase tracking-wider mt-0.5 sm:mt-1">Type</p>
						</div>
						<button id="closeInfo" class="shrink-0 text-body hover:text-ink transition-colors">
							<svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
								<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
							</svg>
						</button>
					</div>
					
					<div class="space-y-2 sm:space-y-3 text-xs sm:text-sm">
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-hairline">
							<span class="text-body">Diameter</span>
							<span id="planetDiameter" class="text-ink font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-hairline">
							<span class="text-body">Distance from Sun</span>
							<span id="planetDistance" class="text-ink font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-hairline">
							<span class="text-body">Orbital Period</span>
							<span id="planetPeriod" class="text-ink font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-hairline">
							<span class="text-body">Rotation Period</span>
							<span id="planetRotation" class="text-ink font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="flex justify-between py-1.5 sm:py-2 border-b border-hairline">
							<span class="text-body">Moons</span>
							<span id="planetMoons" class="text-ink font-mono text-xs sm:text-sm">--</span>
						</div>
						<div class="pt-2">
							<p id="planetDescription" class="text-[11px] sm:text-xs text-body leading-relaxed">--</p>
						</div>
					</div>
				</div>

				<!-- Controls Panel - Hidden on small mobile -->
				<div class="hidden sm:block fixed left-4 bottom-24 bg-canvas/80 backdrop-blur-md rounded-lg border border-hairline p-4 pointer-events-auto">
					<p class="text-xs font-mono uppercase text-muted tracking-wider mb-3">Controls</p>
					<div class="space-y-2 text-xs text-body">
						<div class="flex items-center gap-2">
							<kbd class="px-2 py-1 bg-canvas-soft-2 rounded border border-hairline font-mono text-ink">Mouse</kbd>
							<span>Rotate view</span>
						</div>
						<div class="flex items-center gap-2">
							<kbd class="px-2 py-1 bg-canvas-soft-2 rounded border border-hairline font-mono text-ink">Scroll</kbd>
							<span>Zoom in/out</span>
						</div>
						<div class="flex items-center gap-2">
							<kbd class="px-2 py-1 bg-canvas-soft-2 rounded border border-hairline font-mono text-ink">Click</kbd>
							<span>Select planet</span>
						</div>
					</div>
				</div>

				<!-- Quick Planet Navigation - Mobile Optimized with Real Images -->
				<div class="fixed bottom-3 sm:bottom-4 left-1/2 -translate-x-1/2 bg-canvas/90 backdrop-blur-md rounded-full border border-hairline px-2 sm:px-4 py-1.5 sm:py-2 pointer-events-auto overflow-x-auto max-w-[95vw]">
					<div class="flex items-center gap-1.5 sm:gap-2">
						<button class="planet-quick-nav planet-icon w-7 h-7 sm:w-8 sm:h-8 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-yellow-400" data-planet="sun" title="Sun">
							<img src="/images/sun.jpeg" alt="Sun" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-5 h-5 sm:w-6 sm:h-6 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-gray-400" data-planet="mercury" title="Mercury">
							<img src="/images/mercury.jpeg" alt="Mercury" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-orange-300" data-planet="venus" title="Venus">
							<img src="/images/venus.jpeg" alt="Venus" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-blue-400" data-planet="earth" title="Earth">
							<img src="/images/earth.jpeg" alt="Earth" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-5 h-5 sm:w-6 sm:h-6 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-red-400" data-planet="mars" title="Mars">
							<img src="/images/mars.jpeg" alt="Mars" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-7 h-7 sm:w-9 sm:h-9 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-orange-200" data-planet="jupiter" title="Jupiter">
							<img src="/images/jupiter.jpeg" alt="Jupiter" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-7 h-7 sm:w-8 sm:h-8 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-yellow-300" data-planet="saturn" title="Saturn">
							<img src="/images/saturn.jpeg" alt="Saturn" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-cyan-300" data-planet="uranus" title="Uranus">
							<img src="/images/uranus.jpeg" alt="Uranus" class="w-full h-full object-cover" />
						</button>
						<button class="planet-quick-nav planet-icon w-6 h-6 sm:w-7 sm:h-7 rounded-full hover:scale-110 transition-transform shrink-0 overflow-hidden border border-blue-400" data-planet="neptune" title="Neptune">
							<img src="/images/neptune.jpeg" alt="Neptune" class="w-full h-full object-cover" />
						</button>
					</div>
				</div>
			</div>
		</main>

		<SiteFooter />
	</div>
</Layout>

<script>
	import * as THREE from 'three';
	import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';

	// Planet data with real information
	const planetData = {
		sun: {
			name: 'Sun',
			type: 'Star',
			diameter: '1,392,700 km',
			distanceText: '0 km',
			period: '—',
			rotation: '25-35 days',
			moons: '0',
			description: 'The Sun is the star at the center of our Solar System. It accounts for about 99.86% of the total mass of the Solar System.',
			size: 20,
			color: 0xfdb813,
			distance: 0,
			speed: 0
		},
		mercury: {
			name: 'Mercury',
			type: 'Terrestrial Planet',
			diameter: '4,879 km',
			distanceText: '57.9 million km',
			period: '88 days',
			rotation: '59 days',
			moons: '0',
			description: 'Mercury is the smallest planet in our solar system and closest to the Sun. It has a very thin atmosphere.',
			size: 2.5,
			color: 0x8c7853,
			distance: 40,
			speed: 0.04
		},
		venus: {
			name: 'Venus',
			type: 'Terrestrial Planet',
			diameter: '12,104 km',
			distanceText: '108.2 million km',
			period: '225 days',
			rotation: '243 days',
			moons: '0',
			description: 'Venus is the hottest planet in our solar system with surface temperatures hot enough to melt lead. It rotates in the opposite direction to most planets.',
			size: 3.5,
			color: 0xffc649,
			distance: 55,
			speed: 0.03
		},
		earth: {
			name: 'Earth',
			type: 'Terrestrial Planet',
			diameter: '12,742 km',
			distanceText: '149.6 million km',
			period: '365.25 days',
			rotation: '24 hours',
			moons: '1 (Moon)',
			description: 'Earth is our home planet, the only known planet to harbor life. It has one natural satellite, the Moon, and is covered 71% by water.',
			size: 3.5,
			color: 0x2233ff,
			distance: 70,
			speed: 0.025,
			hasMoon: true
		},
		mars: {
			name: 'Mars',
			type: 'Terrestrial Planet',
			diameter: '6,779 km',
			distanceText: '227.9 million km',
			period: '687 days',
			rotation: '24.6 hours',
			moons: '2 (Phobos, Deimos)',
			description: 'Mars is known as the Red Planet due to iron oxide on its surface. It has the largest volcano in the solar system, Olympus Mons.',
			size: 2.8,
			color: 0xdc143c,
			distance: 85,
			speed: 0.02
		},
		jupiter: {
			name: 'Jupiter',
			type: 'Gas Giant',
			diameter: '139,820 km',
			distanceText: '778.5 million km',
			period: '11.86 years',
			rotation: '9.9 hours',
			moons: '95+',
			description: 'Jupiter is the largest planet in our solar system. Its famous Great Red Spot is a giant storm larger than Earth that has raged for hundreds of years.',
			size: 11,
			color: 0xffa500,
			distance: 130,
			speed: 0.013
		},
		saturn: {
			name: 'Saturn',
			type: 'Gas Giant',
			diameter: '116,460 km',
			distanceText: '1.43 billion km',
			period: '29.46 years',
			rotation: '10.7 hours',
			moons: '146+',
			description: 'Saturn is best known for its spectacular ring system made of ice and rock particles. It is the least dense planet and would float in water.',
			size: 9,
			color: 0xffd700,
			distance: 170,
			speed: 0.01,
			hasRings: true
		},
		uranus: {
			name: 'Uranus',
			type: 'Ice Giant',
			diameter: '50,724 km',
			distanceText: '2.87 billion km',
			period: '84 years',
			rotation: '17.2 hours',
			moons: '27',
			description: 'Uranus rotates on its side, likely due to a massive collision long ago. It appears blue-green due to methane in its atmosphere.',
			size: 5,
			color: 0x4fd0e0,
			distance: 210,
			speed: 0.007
		},
		neptune: {
			name: 'Neptune',
			type: 'Ice Giant',
			diameter: '49,244 km',
			distanceText: '4.5 billion km',
			period: '164.8 years',
			rotation: '16 hours',
			moons: '14',
			description: 'Neptune is the windiest planet with speeds reaching 2,100 km/h. It was the first planet located through mathematical predictions.',
			size: 4.8,
			color: 0x1e90ff,
			distance: 245,
			speed: 0.005
		}
	};

	// Scene setup with enhanced rendering
	const scene = new THREE.Scene();
	const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 5000);
	const renderer = new THREE.WebGLRenderer({
		antialias: true,
		alpha: false,
		powerPreference: 'high-performance'
	});

	const container = document.getElementById('solarSystemCanvas');
	if (!container) throw new Error('Canvas container not found');

	renderer.setSize(window.innerWidth, window.innerHeight);
	renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
	renderer.shadowMap.enabled = true;
	renderer.shadowMap.type = THREE.PCFSoftShadowMap;
	renderer.toneMapping = THREE.ACESFilmicToneMapping;
	renderer.toneMappingExposure = 1.0;
	renderer.outputColorSpace = THREE.SRGBColorSpace;
	container.appendChild(renderer.domElement);

	// Texture loader with CORS support and loading tracking
	const textureLoader = new THREE.TextureLoader();
	textureLoader.crossOrigin = 'anonymous';

	// Track texture loading progress
	let texturesLoaded = 0;
	const totalTextures = 9; // sun, mercury, venus, earth, mars, jupiter, saturn, uranus, neptune

	function updateLoadingProgress() {
		texturesLoaded++;
		console.log(`Loaded ${texturesLoaded}/${totalTextures} planet textures`);
		if (texturesLoaded >= totalTextures) {
			console.log('✓ All textures loaded - Solar System ready!');
		}
	}

	// Local planet texture URLs from our images folder
	const textureUrls = {
		sun: '/images/sun.jpeg',
		mercury: '/images/mercury.jpeg',
		venus: '/images/venus.jpeg',
		earth: '/images/earth.jpeg',
		mars: '/images/mars.jpeg',
		jupiter: '/images/jupiter.jpeg',
		saturn: '/images/saturn.jpeg',
		uranus: '/images/uranus.png',
		neptune: '/images/neptune.jpeg',
		moon: '/images/moon.jpeg',
		saturnRing: '/images/saturn.jpeg' // Using Saturn texture for ring alpha approximation
	};

	// Camera position
	camera.position.set(0, 100, 150);
	camera.lookAt(0, 0, 0);

	// Controls
	const controls = new OrbitControls(camera, renderer.domElement);
	controls.enableDamping = true;
	controls.dampingFactor = 0.05;
	controls.minDistance = 25;
	controls.maxDistance = 500;
	
	// Mobile-friendly controls
	controls.touches = {
		ONE: THREE.TOUCH.ROTATE,
		TWO: THREE.TOUCH.DOLLY_PAN
	};

	// Enhanced starfield background with varied sizes and colors
	function createStarfield() {
		const starsGeometry = new THREE.BufferGeometry();
		const starsVertices = [];
		const starsSizes = [];
		const starsColors = [];

		// Create 15000 stars with varied properties for depth
		for (let i = 0; i < 15000; i++) {
			const x = (Math.random() - 0.5) * 3000;
			const y = (Math.random() - 0.5) * 3000;
			const z = (Math.random() - 0.5) * 3000;
			starsVertices.push(x, y, z);

			// Vary star sizes (0.5 to 2.5)
			const size = Math.random() * 2 + 0.5;
			starsSizes.push(size);

			// Vary star colors (white to slightly blue/yellow)
			const colorVariation = Math.random();
			if (colorVariation < 0.7) {
				// Most stars: white
				starsColors.push(1, 1, 1);
			} else if (colorVariation < 0.85) {
				// Some stars: slight blue tint
				starsColors.push(0.9, 0.95, 1);
			} else {
				// Some stars: slight yellow tint
				starsColors.push(1, 0.98, 0.9);
			}
		}

		starsGeometry.setAttribute('position', new THREE.Float32BufferAttribute(starsVertices, 3));
		starsGeometry.setAttribute('size', new THREE.Float32BufferAttribute(starsSizes, 1));
		starsGeometry.setAttribute('color', new THREE.Float32BufferAttribute(starsColors, 3));

		const starsMaterial = new THREE.PointsMaterial({
			size: 1.2,
			vertexColors: true,
			transparent: true,
			opacity: 0.9,
			sizeAttenuation: true
		});

		return new THREE.Points(starsGeometry, starsMaterial);
	}
	scene.add(createStarfield());

	// Add subtle space fog/nebula effect for depth
	const fogColor = new THREE.Color(0x000508);
	scene.fog = new THREE.FogExp2(fogColor, 0.00015);

	// Realistic lighting setup for photorealistic planets
	// Ambient light - very dim space lighting
	const ambientLight = new THREE.AmbientLight(0x111111, 0.2);
	scene.add(ambientLight);

	// Sun light - main light source from the sun
	const sunLight = new THREE.PointLight(0xffffff, 4, 2500);
	sunLight.position.set(0, 0, 0);
	sunLight.castShadow = true;
	sunLight.shadow.mapSize.width = 2048;
	sunLight.shadow.mapSize.height = 2048;
	scene.add(sunLight);

	// Subtle hemisphere light for better depth perception
	const hemiLight = new THREE.HemisphereLight(0x0d1a33, 0x000000, 0.15);
	scene.add(hemiLight);

	// Create planets
	const planets: { [key: string]: { mesh: THREE.Mesh; orbit: number; speed: number; angle: number; moon?: THREE.Mesh; moonOrbit?: number; ring?: THREE.Mesh } } = {};

	// Load textures and create planets
	Object.entries(planetData).forEach(([key, data]) => {
		// Create planet with real texture
		const geometry = new THREE.SphereGeometry(data.size, 64, 64);
		
		// Load texture with proper error handling and callbacks
		const texture = textureLoader.load(
			textureUrls[key as keyof typeof textureUrls],
			(loadedTexture) => {
				// Texture loaded successfully - enable anisotropic filtering for better quality
				loadedTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();
				loadedTexture.colorSpace = THREE.SRGBColorSpace;
				console.log(`✓ Loaded texture for ${key}`);
				updateLoadingProgress();
			},
			undefined,
			(error) => {
				console.error(`✗ Failed to load texture for ${key}:`, error);
				// Even on error, increment counter to not block loading
				updateLoadingProgress();
			}
		);

		// Configure texture wrapping to clamp edges (avoid repeating)
		texture.wrapS = THREE.ClampToEdgeWrapping;
		texture.wrapT = THREE.ClampToEdgeWrapping;

		// Configure material based on planet type for photorealism
		let material;
		if (key === 'sun') {
			// Sun: bright, emissive glow
			material = new THREE.MeshBasicMaterial({
				map: texture,
				color: 0xffffff,
				toneMapped: false
			});

			// Add glow effect to sun
			const glowGeometry = new THREE.SphereGeometry(data.size * 1.2, 32, 32);
			const glowMaterial = new THREE.ShaderMaterial({
				uniforms: {
					glowColor: { value: new THREE.Color(0xffaa00) },
					viewVector: { value: camera.position }
				},
				vertexShader: `
					uniform vec3 viewVector;
					varying float intensity;
					void main() {
						vec3 vNormal = normalize(normalMatrix * normal);
						vec3 vNormel = normalize(normalMatrix * viewVector);
						intensity = pow(0.7 - dot(vNormal, vNormel), 2.0);
						gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
					}
				`,
				fragmentShader: `
					uniform vec3 glowColor;
					varying float intensity;
					void main() {
						vec3 glow = glowColor * intensity;
						gl_FragColor = vec4(glow, 1.0);
					}
				`,
				side: THREE.BackSide,
				blending: THREE.AdditiveBlending,
				transparent: true
			});
		} else if (key === 'earth') {
			// Earth: special case with atmosphere simulation
			material = new THREE.MeshStandardMaterial({
				map: texture,
				roughness: 0.7,
				metalness: 0.1,
				flatShading: false,
				emissive: 0x000000,
				emissiveIntensity: 0
			});
		} else if (key === 'jupiter' || key === 'saturn') {
			// Gas giants: smoother, slightly reflective
			material = new THREE.MeshStandardMaterial({
				map: texture,
				roughness: 0.6,
				metalness: 0.05,
				flatShading: false
			});
		} else if (key === 'uranus' || key === 'neptune') {
			// Ice giants: smoother, more reflective
			material = new THREE.MeshStandardMaterial({
				map: texture,
				roughness: 0.4,
				metalness: 0.15,
				flatShading: false
			});
		} else {
			// Rocky planets (Mercury, Venus, Mars): rough surface
			material = new THREE.MeshStandardMaterial({
				map: texture,
				roughness: 1.0,
				metalness: 0,
				flatShading: false
			});
		}
		
		const planet = new THREE.Mesh(geometry, material);
		planet.userData = { planetKey: key, ...data };
		planet.castShadow = true;
		planet.receiveShadow = true;

		if (key !== 'sun') {
			planet.position.x = data.distance;
			
			// Create orbit line
			const orbitGeometry = new THREE.BufferGeometry();
			const orbitPoints = [];
			for (let i = 0; i <= 64; i++) {
				const angle = (i / 64) * Math.PI * 2;
				orbitPoints.push(
					Math.cos(angle) * data.distance,
					0,
					Math.sin(angle) * data.distance
				);
			}
			orbitGeometry.setAttribute('position', new THREE.Float32BufferAttribute(orbitPoints, 3));
			const orbitMaterial = new THREE.LineBasicMaterial({ color: 0x444444, transparent: true, opacity: 0.3 });
			const orbitLine = new THREE.Line(orbitGeometry, orbitMaterial);
			scene.add(orbitLine);
		}
		
		scene.add(planet);
		planets[key] = {
			mesh: planet,
			orbit: data.distance,
			speed: data.speed,
			angle: Math.random() * Math.PI * 2
		};

		// Add moon for Earth with realistic texture
		if (data.hasMoon) {
			const moonGeometry = new THREE.SphereGeometry(0.8, 32, 32);
			const moonTexture = textureLoader.load(textureUrls.moon, (loadedTexture) => {
				loadedTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();
				loadedTexture.colorSpace = THREE.SRGBColorSpace;
			});
			const moonMaterial = new THREE.MeshStandardMaterial({
				map: moonTexture,
				roughness: 1.0,
				metalness: 0,
				flatShading: false
			});
			const moon = new THREE.Mesh(moonGeometry, moonMaterial);
			moon.position.x = 8;
			moon.castShadow = true;
			moon.receiveShadow = true;
			planet.add(moon);
			planets[key].moon = moon;
			planets[key].moonOrbit = 8;
		}

		// Add realistic rings for Saturn with texture
		if (data.hasRings) {
			const ringGeometry = new THREE.RingGeometry(data.size * 1.5, data.size * 2.5, 128);
			const ringTexture = textureLoader.load(textureUrls.saturnRing, (loadedTexture) => {
				loadedTexture.anisotropy = renderer.capabilities.getMaxAnisotropy();
			});
			const ringMaterial = new THREE.MeshStandardMaterial({
				map: ringTexture,
				side: THREE.DoubleSide,
				transparent: true,
				opacity: 0.8,
				roughness: 0.9,
				metalness: 0
			});
			const ring = new THREE.Mesh(ringGeometry, ringMaterial);
			ring.rotation.x = Math.PI / 2.2;
			ring.castShadow = true;
			ring.receiveShadow = true;
			planet.add(ring);
			planets[key].ring = ring;
		}
	});

	// Raycaster for click detection
	const raycaster = new THREE.Raycaster();
	const mouse = new THREE.Vector2();

	function onPlanetClick(event: MouseEvent) {
		mouse.x = (event.clientX / window.innerWidth) * 2 - 1;
		mouse.y = -(event.clientY / window.innerHeight) * 2 + 1;

		raycaster.setFromCamera(mouse, camera);
		const intersects = raycaster.intersectObjects(Object.values(planets).map(p => p.mesh));

		if (intersects.length > 0) {
			const planet = intersects[0].object as THREE.Mesh;
			const planetKey = planet.userData.planetKey;
			showPlanetInfo(planetKey);
			focusOnPlanet(planetKey);
		}
	}

	function showPlanetInfo(planetKey: string) {
		const data = planetData[planetKey];
		const panel = document.getElementById('planetInfo');
		if (!panel) return;

		document.getElementById('planetName')!.textContent = data.name;
		document.getElementById('planetType')!.textContent = data.type;
		document.getElementById('planetDiameter')!.textContent = data.diameter;
		document.getElementById('planetDistance')!.textContent = data.distanceText;
		document.getElementById('planetPeriod')!.textContent = data.period;
		document.getElementById('planetRotation')!.textContent = data.rotation;
		document.getElementById('planetMoons')!.textContent = data.moons;
		document.getElementById('planetDescription')!.textContent = data.description;

		panel.classList.remove('hidden');
	}

	function focusOnPlanet(planetKey: string) {
		const planet = planets[planetKey];
		const targetPosition = planet.mesh.position.clone();
		const distance = planetData[planetKey].size * 4;
		
		const cameraPosition = new THREE.Vector3(
			targetPosition.x + distance,
			distance * 0.5,
			targetPosition.z + distance
		);

		// Smooth camera transition
		const duration = 1000;
		const startPosition = camera.position.clone();
		const startTime = Date.now();

		function animateCamera() {
			const elapsed = Date.now() - startTime;
			const progress = Math.min(elapsed / duration, 1);
			const eased = 1 - Math.pow(1 - progress, 3); // Ease out cubic

			camera.position.lerpVectors(startPosition, cameraPosition, eased);
			controls.target.lerp(targetPosition, eased);
			controls.update();

			if (progress < 1) {
				requestAnimationFrame(animateCamera);
			}
		}
		animateCamera();
	}

	// Event listeners
	window.addEventListener('click', onPlanetClick);
	
	document.getElementById('closeInfo')?.addEventListener('click', () => {
		document.getElementById('planetInfo')?.classList.add('hidden');
	});

	document.getElementById('resetCamera')?.addEventListener('click', () => {
		camera.position.set(0, 100, 150);
		controls.target.set(0, 0, 0);
		controls.update();
		document.getElementById('planetInfo')?.classList.add('hidden');
	});

	document.querySelectorAll('.planet-quick-nav').forEach(button => {
		button.addEventListener('click', () => {
			const planetKey = (button as HTMLElement).dataset.planet;
			if (planetKey) {
				showPlanetInfo(planetKey);
				focusOnPlanet(planetKey);
			}
		});
	});

	// Animation loop
	function animate() {
		requestAnimationFrame(animate);

		// Rotate planets
		Object.entries(planets).forEach(([key, planet]) => {
			if (key !== 'sun') {
				planet.angle += planet.speed;
				planet.mesh.position.x = Math.cos(planet.angle) * planet.orbit;
				planet.mesh.position.z = Math.sin(planet.angle) * planet.orbit;
			}
			
			// Rotate planet on axis
			planet.mesh.rotation.y += 0.01;

			// Rotate moon
			if (planet.moon && planet.moonOrbit) {
				const moonAngle = Date.now() * 0.001;
				planet.moon.position.x = Math.cos(moonAngle) * planet.moonOrbit;
				planet.moon.position.z = Math.sin(moonAngle) * planet.moonOrbit;
			}
		});

		controls.update();
		renderer.render(scene, camera);
	}

	// Handle window resize
	window.addEventListener('resize', () => {
		camera.aspect = window.innerWidth / window.innerHeight;
		camera.updateProjectionMatrix();
		renderer.setSize(window.innerWidth, window.innerHeight);
	});

	animate();
</script>

<style>
	#solarSystemCanvas {
		background:
			radial-gradient(ellipse at 20% 30%, rgba(20, 30, 60, 0.3) 0%, transparent 50%),
			radial-gradient(ellipse at 80% 70%, rgba(40, 20, 50, 0.2) 0%, transparent 50%),
			radial-gradient(ellipse at 50% 50%, rgba(10, 20, 40, 0.4) 0%, transparent 70%),
			linear-gradient(180deg, #000000 0%, #0a0a1a 40%, #050510 70%, #000000 100%);
	}

	[data-theme="light"] #solarSystemCanvas {
		background:
			radial-gradient(ellipse at 20% 30%, rgba(30, 40, 70, 0.2) 0%, transparent 50%),
			radial-gradient(ellipse at 80% 70%, rgba(50, 30, 60, 0.15) 0%, transparent 50%),
			linear-gradient(180deg, #0a0520 0%, #1a1a2e 40%, #0f0f1e 70%, #05050a 100%);
	}

	.planet-quick-nav {
		cursor: pointer;
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
		position: relative;
	}

	.planet-quick-nav:hover {
		box-shadow: 0 4px 12px rgba(255, 255, 255, 0.4);
	}

	.planet-icon img {
		display: block;
	}

	kbd {
		display: inline-block;
		min-width: 2rem;
		text-align: center;
	}
</style>
