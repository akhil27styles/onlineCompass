---
import Layout from '../layouts/Layout.astro';
import SiteShell from '../components/SiteShell.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SeoJsonLd from '../components/SeoJsonLd.astro';
import LocationPrompt from '../components/LocationPrompt.astro';
import AdSlot from '../components/AdSlot.astro';

const faqs = [
	['What is the heat index today?', 'The heat index is the feels-like temperature when air temperature and humidity are combined. This page calculates it for your detected location and adds sun position, UV, and wind for outdoor heat risk.'],
	['Is heat index the same as temperature?', 'No. Temperature is the measured air temperature. Heat index estimates how hot it feels to the human body, especially when humidity slows sweat evaporation.'],
	['How does the Sun affect heat risk?', 'A high solar altitude means stronger direct sunlight. The same temperature can feel more dangerous in strong midday sun than in shade or after sunset.'],
	['What is a dangerous heat index?', 'Heat risk increases quickly above about 32°C feels-like temperature, especially with high humidity, high UV, low wind, children, older adults, or intense outdoor work.'],
];
---

<Layout
	title="Heat Index Today — Feels Like Temperature & Heat Risk"
	description="Check the heat index today for your location. Live feels-like temperature, humidity, UV index, solar altitude, wind and heat risk advice."
	keywords="heat index today, feels like temperature, heat risk, heat wave, heat warning, humidity today, UV index, sun exposure, outdoor heat safety"
	canonical="https://trulycompass.com/heat-index/"
>
	<SeoJsonLd
		slot="head"
		name="Heat Index Today — Truly Compass"
		description="Live heat index, feels-like temperature, sun exposure, UV context and heat risk advice for your location."
		url="https://trulycompass.com/heat-index/"
	/>
	<div class="relative min-h-screen flex flex-col overflow-x-hidden bg-canvas-soft">
		<div class="mesh-gradient-bg" aria-hidden="true"></div>
		<SiteShell current="heat-index" />

		<main id="main" class="flex-grow z-10">
			<section class="content-grid pt-8 pb-6 sm:pt-10 sm:pb-8 text-center relative z-20">
				<p class="font-mono text-xs uppercase text-muted tracking-widest" translate="no">trulycompass.com</p>
				<h1 class="mt-4 max-w-3xl mx-auto text-balance text-4xl font-semibold leading-none tracking-tighter text-ink sm:text-5xl">
					Heat Index Today
				</h1>
				<p class="mt-4 max-w-2xl mx-auto text-pretty text-sm leading-6 text-body">
					Live feels-like temperature, humidity, UV index, wind, and sun-angle heat risk for your location.
				</p>
			</section>

			<section class="py-6 sm:py-8">
				<div class="content-grid grid gap-6 lg:grid-cols-[minmax(0,1fr)_340px]">
					<div class="flex flex-col gap-4">
						<section class="rounded-panel border border-hairline bg-canvas p-6 card-elevated text-center" aria-labelledby="heat-title">
							<p class="font-mono text-[10px] uppercase text-muted tracking-wider">Current Heat Risk</p>
							<h2 id="heat-title" class="mt-3 text-3xl font-semibold tracking-tight text-ink">
								<span id="heatRiskLevel">Detecting</span>
							</h2>
							<p id="heatRiskScore" class="mt-2 font-mono text-xs text-body">Waiting for location…</p>
							<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4">
								<div class="rounded border border-hairline bg-canvas-soft-2 p-4">
									<p class="font-mono text-[9px] uppercase text-muted">Feels Like</p>
									<p id="heatIndexVal" class="mt-1 font-mono text-lg font-semibold text-ink">--</p>
								</div>
								<div class="rounded border border-hairline bg-canvas-soft-2 p-4">
									<p class="font-mono text-[9px] uppercase text-muted">Temperature</p>
									<p id="temperatureVal" class="mt-1 font-mono text-lg font-semibold text-ink">--</p>
								</div>
								<div class="rounded border border-hairline bg-canvas-soft-2 p-4">
									<p class="font-mono text-[9px] uppercase text-muted">Humidity</p>
									<p id="humidityVal" class="mt-1 font-mono text-lg font-semibold text-ink">--</p>
								</div>
								<div class="rounded border border-hairline bg-canvas-soft-2 p-4">
									<p class="font-mono text-[9px] uppercase text-muted">UV Index</p>
									<p id="uvVal" class="mt-1 font-mono text-lg font-semibold text-ink">--</p>
								</div>
							</div>
							<p id="heatAdvice" class="mt-5 border-t border-hairline pt-4 text-sm leading-relaxed text-body">
								Allow location or use detected city data to calculate local heat risk.
							</p>
						</section>

						<section class="rounded-panel border border-hairline bg-canvas p-5 card-elevated">
							<p class="font-mono text-[10px] uppercase text-muted tracking-wider">Outdoor Planning</p>
							<div class="mt-4 grid gap-3 sm:grid-cols-3">
								<div class="rounded border border-hairline bg-canvas-soft-2 p-4">
									<p class="font-mono text-[9px] uppercase text-muted">Solar Load</p>
									<p id="solarLoadVal" class="mt-1 font-mono text-sm font-semibold text-ink">--</p>
								</div>
								<div class="rounded border border-hairline bg-canvas-soft-2 p-4">
									<p class="font-mono text-[9px] uppercase text-muted">Sun Altitude</p>
									<p id="sunAltitudeVal" class="mt-1 font-mono text-sm font-semibold text-ink">--</p>
								</div>
								<div class="rounded border border-hairline bg-canvas-soft-2 p-4">
									<p class="font-mono text-[9px] uppercase text-muted">Wind</p>
									<p id="windVal" class="mt-1 font-mono text-sm font-semibold text-ink">--</p>
								</div>
							</div>
						</section>
					</div>

					<aside class="grid gap-6">
						<section class="rounded-panel border border-hairline bg-canvas p-4 shadow-sm" aria-labelledby="heat-location-title">
							<h2 id="heat-location-title" class="text-xs font-mono uppercase text-muted tracking-wider">Observer Coordinates</h2>
							<div class="mt-4">
								<LocationPrompt compact />
							</div>
						</section>
						<AdSlot id="ad-heat-sidebar" format="vertical" />
					</aside>
				</div>
			</section>

			<section class="border-t border-hairline bg-canvas py-12 sm:py-16">
				<div class="content-grid">
					<div class="max-w-2xl">
						<p class="font-mono text-xs uppercase text-muted tracking-widest">Heat Safety</p>
						<h2 class="mt-3 text-2xl font-semibold tracking-tight text-ink sm:text-3xl">Heat risk is more than temperature.</h2>
						<p class="mt-3 text-xs sm:text-sm text-body leading-relaxed">
							Humidity, direct sunlight, UV index, and low wind can make outdoor heat feel much stronger. Use this page before running, hiking, commuting, or working outside during hot weather.
						</p>
					</div>
					<div class="mt-8 grid gap-3">
						{faqs.map(([question, answer]) => (
							<details class="group rounded border border-hairline bg-canvas-soft-2 p-4">
								<summary class="focus-ring cursor-pointer list-none text-xs font-semibold text-body hover:text-ink font-mono flex items-center justify-between">
									<span>{question}</span>
									<span class="text-[14px] text-muted transition-transform duration-200 group-open:rotate-45" aria-hidden="true">+</span>
								</summary>
								<p class="mt-3 text-xs leading-relaxed text-body border-t border-hairline pt-3">{answer}</p>
							</details>
						))}
					</div>
				</div>
			</section>
		</main>

		<SiteFooter />
		<script type="application/ld+json" set:html={JSON.stringify({
			'@context': 'https://schema.org',
			'@type': 'FAQPage',
			mainEntity: faqs.map(([question, answer]) => ({
				'@type': 'Question',
				name: question,
				acceptedAnswer: { '@type': 'Answer', text: answer },
			})),
		})} />
	</div>
</Layout>

<script>
	import { prefetchLocationSilently } from '../lib/geo';
	import { mountDeviceUi } from '../scripts/device-ui';
	import { fetchWeather } from '../lib/weather';
	import { fetchUVIndex } from '../lib/uv';
	import { getSunSnapshot, formatDegrees } from '../lib/astronomy';
	import { getHeatRisk } from '../lib/heat-risk';

	prefetchLocationSilently();

	function setText(el: Element | null, value: string) {
		if (el) el.textContent = value;
	}

	async function onLocation(latitude: number, longitude: number) {
		setText(document.querySelector('#heatRiskLevel'), 'Loading');
		const [weather, uv] = await Promise.all([
			fetchWeather(latitude, longitude),
			fetchUVIndex(latitude, longitude),
		]);

		if (!weather) {
			setText(document.querySelector('#heatRiskLevel'), 'Unavailable');
			setText(document.querySelector('#heatAdvice'), 'Weather data is unavailable for this location right now.');
			return;
		}

		const sun = getSunSnapshot(new Date(), { lat: latitude, lng: longitude });
		const risk = getHeatRisk({
			temperatureC: weather.temperature,
			humidity: weather.humidity,
			windSpeedKmh: weather.windSpeed,
			solarAltitude: sun.altitude,
			uvIndex: uv?.current,
		});

		const level = document.querySelector('#heatRiskLevel') as HTMLElement | null;
		if (level) {
			level.textContent = risk.level;
			level.style.color = risk.color;
		}
		setText(document.querySelector('#heatRiskScore'), `Heat score ${risk.score} based on weather, UV, wind, and sun angle`);
		setText(document.querySelector('#heatIndexVal'), `${risk.heatIndexC.toFixed(1)}°C`);
		setText(document.querySelector('#temperatureVal'), `${weather.temperature}°C`);
		setText(document.querySelector('#humidityVal'), `${weather.humidity}%`);
		setText(document.querySelector('#uvVal'), uv ? uv.current.toFixed(1) : '—');
		setText(document.querySelector('#solarLoadVal'), risk.solarLoad);
		setText(document.querySelector('#sunAltitudeVal'), formatDegrees(sun.altitude));
		setText(document.querySelector('#windVal'), `${weather.windSpeed} km/h`);
		setText(document.querySelector('#heatAdvice'), risk.recommendation);
	}

	mountDeviceUi({
		onLocation: (coords) => onLocation(coords.latitude, coords.longitude),
	});

	document.addEventListener('oc:location-ready', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
	});

	document.addEventListener('oc:location-updated', (event) => {
		const detail = (event as CustomEvent<{ coords: { latitude: number; longitude: number } }>).detail;
		onLocation(detail.coords.latitude, detail.coords.longitude);
	});
</script>

<style>
	.mesh-gradient-bg {
		position: absolute;
		top: -20%;
		left: 50%;
		transform: translateX(-50%);
		width: 100%;
		max-width: 1400px;
		height: 600px;
		opacity: 0.1;
		filter: blur(120px);
		background:
			radial-gradient(circle at 10% 20%, #007cf0 0%, transparent 40%),
			radial-gradient(circle at 90% 30%, #00dfd8 0%, transparent 45%),
			radial-gradient(circle at 35% 70%, #7928ca 0%, transparent 40%),
			radial-gradient(circle at 65% 15%, #ff0080 0%, transparent 40%),
			radial-gradient(circle at 50% 50%, #f9cb28 0%, transparent 50%);
		pointer-events: none;
		z-index: 0;
	}
</style>
