---
import ThemeToggle from './ThemeToggle.astro';

const { current = 'compass' } = Astro.props as { current?: 'compass' | 'compass-bearings' | 'sun' | 'moon' | 'solar-system' | 'qibla' | 'wind' | 'golden-hour' | 'uv-index' | 'prayer-times' | 'day-length' | 'heat-index' | 'air-quality' | 'stargazing' };

const buttonLabel = 
	current === 'compass' ? 'Open Compass' : 
	current === 'compass-bearings' ? 'Compass Bearings' : 
	current === 'sun' ? 'Sun Tool' : 
	current === 'moon' ? 'Moon Tool' : 
	current === 'qibla' ? 'Qibla Finder' : 
	current === 'wind' ? 'Wind Compass' : 
	current === 'golden-hour' ? 'Golden Hour' :
	current === 'uv-index' ? 'UV Index' :
	current === 'heat-index' ? 'Heat Index' :
	current === 'air-quality' ? 'Air Quality' :
	current === 'stargazing' ? 'Stargazing' :
	current === 'prayer-times' ? 'Prayer Times' :
	current === 'day-length' ? 'Day Length' :
	'Solar System';

const buttonHref = 
	current === 'compass' ? '#compass' : 
	current === 'compass-bearings' ? '/compass-bearings/' : 
	current === 'sun' ? '/sun-position/' : 
	current === 'moon' ? '/moon-position/' : 
	current === 'qibla' ? '/qibla-compass/' : 
	current === 'wind' ? '/wind-compass/' : 
	current === 'golden-hour' ? '/golden-hour/' :
	current === 'uv-index' ? '/uv-index/' :
	current === 'heat-index' ? '/heat-index/' :
	current === 'air-quality' ? '/air-quality/' :
	current === 'stargazing' ? '/stargazing/' :
	current === 'prayer-times' ? '/prayer-times/' :
	current === 'day-length' ? '/day-length/' :
	'/solar-system/';

const navTools = [
	{ href: '/', label: 'Compass' },
	{ href: '/sun-position/', label: 'Sun Position' },
	{ href: '/moon-position/', label: 'Moon Position' },
	{ href: '/prayer-times/', label: 'Prayer Times' },
	{ href: '/qibla-compass/', label: 'Qibla Finder' },
	{ href: '/golden-hour/', label: 'Golden Hour' },
	{ href: '/wind-compass/', label: 'Wind Compass' },
	{ href: '/gps-coordinates/', label: 'GPS Coordinates' },
	{ href: '/uv-index/', label: 'UV Index' },
	{ href: '/heat-index/', label: 'Heat Index' },
	{ href: '/air-quality/', label: 'Air Quality' },
	{ href: '/stargazing/', label: 'Stargazing' },
	{ href: '/day-length/', label: 'Day Length' },
	{ href: '/compass-bearings/', label: 'Compass Bearings' },
	{ href: '/solar-system/', label: '3D Solar System' },
];
---

<a
	class="focus-ring fixed left-4 top-4 z-50 -translate-y-20 rounded-md bg-white px-3 py-2 text-sm font-medium text-black transition-transform duration-150 focus-visible:translate-y-0"
	href="#main"
>
	Skip to Content
</a>

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas-soft/90 backdrop-blur-md">
	<div class="content-grid flex h-14 items-center justify-between gap-3 sm:h-16">
		<a class="focus-ring flex min-w-0 items-center gap-2 rounded-md" href="/" aria-label="Truly Compass Home">
			<span class="grid size-7 place-items-center rounded bg-white text-[11px] font-bold text-black" translate="no">TC</span>
			<span class="hidden sm:block truncate text-sm font-semibold tracking-tight text-ink" translate="no">Truly Compass</span>
		</a>
		<div class="flex items-center gap-2">
			<div class="hidden sm:flex items-center gap-3 mr-1 text-xs font-mono">
				<a class="focus-ring rounded text-body hover:text-ink transition-colors" href="/about/">About</a>
				<a class="focus-ring rounded text-body hover:text-ink transition-colors" href="/contact/">Contact</a>
			</div>
			<ThemeToggle />
			<a
				class="focus-ring hidden sm:inline-flex shrink-0 rounded-full border border-hairline bg-canvas px-3 py-1.5 font-mono text-[11px] text-body hover:border-hairline-strong hover:text-ink sm:text-xs"
				href={buttonHref}
			>
				{buttonLabel}
			</a>
			<!-- Mobile menu button -->
			<button
				id="mobileMenuBtn"
				class="focus-ring inline-flex sm:hidden items-center justify-center size-9 rounded-md border border-hairline bg-canvas text-body hover:text-ink hover:border-hairline-strong transition-colors cursor-pointer"
				type="button"
				aria-label="Open navigation menu"
				aria-expanded="false"
				aria-controls="mobileMenu"
			>
				<svg id="menuIconOpen" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
					<line x1="4" y1="6" x2="20" y2="6" />
					<line x1="4" y1="12" x2="20" y2="12" />
					<line x1="4" y1="18" x2="20" y2="18" />
				</svg>
				<svg id="menuIconClose" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" style="display:none;">
					<line x1="6" y1="6" x2="18" y2="18" />
					<line x1="6" y1="18" x2="18" y2="6" />
				</svg>
			</button>
		</div>
	</div>

	<!-- Mobile navigation drawer -->
	<nav id="mobileMenu" class="mobile-menu" aria-label="Mobile navigation" style="display:none;">
		<div class="content-grid py-4">
			<div class="grid gap-1">
				<p class="px-3 py-1.5 font-mono text-[10px] uppercase text-muted tracking-wider">Pages</p>
				<a class="mobile-nav-link" href="/about/">About Us</a>
				<a class="mobile-nav-link" href="/contact/">Contact</a>
				<a class="mobile-nav-link" href="/privacy-policy/">Privacy Policy</a>
				<a class="mobile-nav-link" href="/terms/">Terms & Conditions</a>
			</div>
			<div class="mt-3 pt-3 border-t border-hairline grid gap-1">
				<p class="px-3 py-1.5 font-mono text-[10px] uppercase text-muted tracking-wider">Tools</p>
				{navTools.map((tool) => (
					<a class="mobile-nav-link" href={tool.href}>{tool.label}</a>
				))}
			</div>
		</div>
	</nav>
</header>

<script>
	const btn = document.getElementById('mobileMenuBtn');
	const menu = document.getElementById('mobileMenu');
	const iconOpen = document.getElementById('menuIconOpen');
	const iconClose = document.getElementById('menuIconClose');

	if (btn && menu && iconOpen && iconClose) {
		btn.addEventListener('click', () => {
			const isOpen = menu.style.display !== 'none';
			menu.style.display = isOpen ? 'none' : 'block';
			btn.setAttribute('aria-expanded', String(!isOpen));
			iconOpen.style.display = isOpen ? 'block' : 'none';
			iconClose.style.display = isOpen ? 'none' : 'block';
		});
	}
</script>

<style>
	.mobile-menu {
		border-top: 1px solid var(--color-hairline);
		background: var(--color-canvas);
		max-height: 70vh;
		overflow-y: auto;
	}

	.mobile-nav-link {
		display: block;
		padding: 0.5rem 0.75rem;
		border-radius: 6px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		color: var(--color-body);
		transition: background 0.15s ease, color 0.15s ease;
	}

	.mobile-nav-link:hover {
		background: var(--color-canvas-soft-2);
		color: var(--color-ink);
	}
</style>
