---
const { current = 'compass' } = Astro.props as { current?: 'compass' | 'sun' | 'moon' };

const toolHash = current === 'compass' ? '#compass' : current === 'sun' ? '#main' : '#main';
---

<a
	class="focus-ring fixed left-4 top-4 z-50 -translate-y-20 rounded-md bg-white px-3 py-2 text-sm font-medium text-black transition-transform duration-150 focus-visible:translate-y-0"
	href="#main"
>
	Skip to Content
</a>

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas-soft/90 backdrop-blur-md">
	<div class="content-grid flex h-14 items-center justify-between gap-3 sm:h-16">
		<a class="focus-ring flex min-w-0 items-center gap-2 rounded-md" href="/" aria-label="Online Compass Home">
			<span class="grid size-7 place-items-center rounded bg-white text-[11px] font-bold text-black" translate="no">OC</span>
			<span class="truncate text-sm font-semibold tracking-tight text-ink" translate="no">Online Compass</span>
		</a>
		<a
			class="focus-ring shrink-0 rounded-full border border-hairline bg-canvas px-3 py-1.5 font-mono text-[11px] text-body hover:border-hairline-strong hover:text-ink sm:text-xs"
			href={current === 'compass' ? '#compass' : current === 'sun' ? '/sun-position/' : '/moon-position/'}
		>
			{current === 'compass' ? 'Open Compass' : current === 'sun' ? 'Sun Tool' : 'Moon Tool'}
		</a>
	</div>
</header>
