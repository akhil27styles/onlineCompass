---
type NavItem = { href: string; label: string };

const { current = 'compass' } = Astro.props as { current?: 'compass' | 'sun' | 'moon' };

const links: NavItem[] = [
	{ href: '/', label: 'Compass' },
	{ href: '/sun-position/', label: 'Sun Position' },
	{ href: '/moon-position/', label: 'Moon Position' },
];

function isActive(href: string): boolean {
	if (current === 'compass' && href === '/') return true;
	if (current === 'sun' && href.startsWith('/sun')) return true;
	if (current === 'moon' && href.startsWith('/moon')) return true;
	return false;
}
---

<a
	class="focus-ring fixed left-4 top-4 z-50 -translate-y-20 rounded-md bg-ink px-3 py-2 text-sm font-medium text-canvas transition-transform duration-150 focus-visible:translate-y-0"
	href="#main"
>
	Skip to Content
</a>

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas-soft/80 backdrop-blur-md">
	<nav class="content-grid flex h-16 items-center justify-between gap-3" aria-label="Primary">
		<a class="focus-ring flex min-w-0 items-center gap-2 rounded-md" href="/" aria-label="Online Compass Home">
			<span class="grid size-7 place-items-center rounded bg-white text-[11px] font-bold text-black" translate="no">OC</span>
			<span class="truncate text-sm font-semibold tracking-tight text-ink" translate="no">Online Compass</span>
		</a>

		<div class="hidden items-center gap-1.5 text-xs font-mono sm:flex">
			{
				links.map((link) => (
					<a
						class:list={[
							'focus-ring rounded-full px-3 py-1.5 transition-all duration-150',
							isActive(link.href)
								? 'bg-canvas-soft-2 font-semibold text-white border border-hairline'
								: 'text-body hover:text-white',
						]}
						href={link.href}
						aria-current={isActive(link.href) ? 'page' : undefined}
					>
						{link.label}
					</a>
				))
			}
		</div>

		<details class="group relative sm:hidden">
			<summary class="focus-ring list-none rounded border border-hairline px-3 py-1.5 text-xs font-mono text-body cursor-pointer hover:text-white marker:content-none">
				Menu
			</summary>
			<div class="absolute top-[calc(100%+8px)] right-0 z-50 min-w-44 rounded border border-hairline bg-canvas p-2 shadow-xl">
				{
					links.map((link) => (
						<a
							class:list={[
								'focus-ring block rounded px-3 py-2 text-xs font-mono',
								isActive(link.href) ? 'bg-canvas-soft-2 font-semibold text-white' : 'text-body hover:text-white',
							]}
							href={link.href}
						>
							{link.label}
						</a>
					))
				}
			</div>
		</details>

		<a
			class="focus-ring hidden rounded border border-hairline px-3 py-1.5 text-xs font-mono text-body hover:text-white hover:border-white sm:inline-flex"
			href={current === 'compass' ? '#compass' : '/#compass'}
		>
			Open Tool
		</a>
	</nav>
</header>
