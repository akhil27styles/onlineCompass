---
import ThemeToggle from './ThemeToggle.astro';

const { current = 'compass' } = Astro.props as { current?: 'compass' | 'sun' | 'moon' | 'solar-system' | 'qibla' | 'wind' | 'golden-hour' | 'uv-index' | 'prayer-times' | 'day-length' | 'heat-index' | 'air-quality' | 'stargazing' };

const buttonLabel = 
	current === 'compass' ? 'Open Compass' : 
	current === 'sun' ? 'Sun Tool' : 
	current === 'moon' ? 'Moon Tool' : 
	current === 'qibla' ? 'Qibla Finder' : 
	current === 'wind' ? 'Wind Compass' : 
	current === 'golden-hour' ? 'Golden Hour' :
	current === 'uv-index' ? 'UV Index' :
	current === 'heat-index' ? 'Heat Index' :
	current === 'air-quality' ? 'Air Quality' :
	current === 'stargazing' ? 'Stargazing' :
	current === 'prayer-times' ? 'Prayer Times' :
	current === 'day-length' ? 'Day Length' :
	'Solar System';

const buttonHref = 
	current === 'compass' ? '#compass' : 
	current === 'sun' ? '/sun-position/' : 
	current === 'moon' ? '/moon-position/' : 
	current === 'qibla' ? '/qibla-compass/' : 
	current === 'wind' ? '/wind-compass/' : 
	current === 'golden-hour' ? '/golden-hour/' :
	current === 'uv-index' ? '/uv-index/' :
	current === 'heat-index' ? '/heat-index/' :
	current === 'air-quality' ? '/air-quality/' :
	current === 'stargazing' ? '/stargazing/' :
	current === 'prayer-times' ? '/prayer-times/' :
	current === 'day-length' ? '/day-length/' :
	'/solar-system/';
---

<a
	class="focus-ring fixed left-4 top-4 z-50 -translate-y-20 rounded-md bg-white px-3 py-2 text-sm font-medium text-black transition-transform duration-150 focus-visible:translate-y-0"
	href="#main"
>
	Skip to Content
</a>

<header class="sticky top-0 z-40 border-b border-hairline bg-canvas-soft/90 backdrop-blur-md">
	<div class="content-grid flex h-14 items-center justify-between gap-3 sm:h-16">
		<a class="focus-ring flex min-w-0 items-center gap-2 rounded-md" href="/" aria-label="Truly Compass Home">
			<span class="grid size-7 place-items-center rounded bg-white text-[11px] font-bold text-black" translate="no">TC</span>
			<span class="hidden sm:block truncate text-sm font-semibold tracking-tight text-ink" translate="no">Truly Compass</span>
		</a>
		<div class="flex items-center gap-2">
			<div class="hidden sm:flex items-center gap-3 mr-1 text-xs font-mono">
				<a class="focus-ring rounded text-body hover:text-white transition-colors" href="/about/">About</a>
				<a class="focus-ring rounded text-body hover:text-white transition-colors" href="/contact/">Contact</a>
			</div>
			<ThemeToggle />
			<a
				class="focus-ring shrink-0 rounded-full border border-hairline bg-canvas px-3 py-1.5 font-mono text-[11px] text-body hover:border-hairline-strong hover:text-ink sm:text-xs"
				href={buttonHref}
			>
				{buttonLabel}
			</a>
		</div>
	</div>
</header>
