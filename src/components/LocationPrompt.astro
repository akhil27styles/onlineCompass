---
const {
	compact = false,
	messageId = 'locationResult',
} = Astro.props as { compact?: boolean; messageId?: string };
---

<div class:list={['grid gap-3', compact && 'mt-3']}>
	<!-- Display state -->
	<div id="locationDisplayState" class="flex flex-col gap-1.5">
		<div class="flex items-center justify-between gap-2">
			<span class="text-xs font-mono uppercase text-muted">Detected City</span>
			<button id="toggleEditLocation" class="text-xs font-medium text-link hover:underline inline-flex items-center gap-1 cursor-pointer" type="button">
				<svg class="size-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
				</svg>
				Edit
			</button>
		</div>
		<p id="locationCity" class="text-base font-semibold text-ink">Detecting city…</p>
		<p id={messageId} class="text-xs text-body" aria-live="polite">
			Checking location permission…
		</p>
	</div>

	<!-- Edit state (collapsible form, hidden by default) -->
	<form id="editLocationForm" class="hidden flex-col gap-3 rounded-md border border-hairline bg-canvas-soft-2 p-3" aria-label="Edit location manually">
		<p class="text-xs font-semibold text-ink">Set Coordinates Manually</p>
		<div class="grid grid-cols-2 gap-2">
			<div>
				<label class="block text-[11px] font-mono uppercase text-muted" for="inputLat">Latitude</label>
				<input id="inputLat" class="mt-1 w-full rounded border border-hairline bg-canvas px-2.5 py-1 text-sm font-mono text-ink focus:outline-none focus:border-link" type="number" step="any" min="-90" max="90" required />
			</div>
			<div>
				<label class="block text-[11px] font-mono uppercase text-muted" for="inputLng">Longitude</label>
				<input id="inputLng" class="mt-1 w-full rounded border border-hairline bg-canvas px-2.5 py-1 text-sm font-mono text-ink focus:outline-none focus:border-link" type="number" step="any" min="-180" max="180" required />
			</div>
		</div>
		<div class="flex gap-2 justify-end mt-1 text-xs">
			<button id="cancelEditLocation" class="rounded px-2.5 py-1.5 font-medium border border-hairline bg-canvas hover:bg-canvas-soft hover:text-ink cursor-pointer" type="button">Cancel</button>
			<button id="saveLocationBtn" class="rounded bg-ink text-white px-3 py-1.5 font-semibold hover:bg-black cursor-pointer" type="submit">Save</button>
		</div>
	</form>

	<button
		id="allowLocation"
		class="focus-ring rounded-md bg-ink px-4 py-3 text-sm font-semibold text-white transition-colors duration-150 hover:bg-black"
		type="button"
		hidden
	>
		Allow Location Access
	</button>
	<button
		id="retryLocation"
		class="focus-ring rounded-md border border-hairline bg-canvas px-4 py-3 text-sm font-semibold transition-colors duration-150 hover:border-hairline-strong hover:bg-canvas-soft-2"
		type="button"
		hidden
	>
		Use Device GPS
	</button>
</div>
