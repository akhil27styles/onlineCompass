---
const {
	compact = false,
	messageId = 'locationResult',
	showAlert = false,
} = Astro.props as { compact?: boolean; messageId?: string; showAlert?: boolean };
---

<!-- Prominent Alert Banner (shown on sun/moon pages) -->
{showAlert && (
	<div id="locationAlertBanner" class="rounded-lg border-2 border-amber-400 bg-amber-50 dark:bg-amber-950/20 p-4 mb-4" role="alert">
		<div class="flex items-start gap-3">
			<div class="shrink-0 w-5 h-5 rounded-full bg-amber-400 text-canvas flex items-center justify-center text-sm font-bold">!</div>
			<div class="flex-1 min-w-0">
				<h3 class="text-sm font-semibold text-amber-900 dark:text-amber-200 mb-1">Location Access Required</h3>
				<p class="text-xs text-amber-800 dark:text-amber-300 leading-relaxed mb-3">
					We need your GPS location to calculate accurate sun/moon positions for your area. Your location stays private in your browser and is never stored on our servers.
				</p>
				<button
					id="allowLocationAlert"
					class="focus-ring rounded-md bg-amber-600 hover:bg-amber-700 px-4 py-2 text-sm font-semibold text-white transition-colors duration-150 inline-flex items-center gap-2"
					type="button"
				>
					<svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
						<path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
					</svg>
					Allow Location Access
				</button>
			</div>
			<button
				id="dismissLocationAlert"
				class="shrink-0 text-amber-600 hover:text-amber-800 dark:text-amber-400 dark:hover:text-amber-200"
				type="button"
				aria-label="Dismiss"
			>
				<svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
				</svg>
			</button>
		</div>
	</div>
)}

<div class:list={['grid gap-3', compact && 'mt-3']}>
	<!-- Display state -->
	<div id="locationDisplayState" class="flex flex-col gap-1.5">
		<span class="text-xs font-mono uppercase text-muted">Detected City</span>
		<p id="locationCity" class="text-base font-semibold text-ink">Detecting city…</p>
		<p id={messageId} class="text-xs text-body" aria-live="polite">
			Checking location permission…
		</p>
	</div>

	<button
		id="allowLocation"
		class="focus-ring rounded-md bg-ink px-4 py-3 text-sm font-semibold text-canvas transition-colors duration-150 hover:opacity-90"
		type="button"
		hidden
	>
		Allow Location Access
	</button>
	<button
		id="retryLocation"
		class="focus-ring rounded-md border border-hairline bg-canvas px-4 py-3 text-sm font-semibold transition-colors duration-150 hover:border-hairline-strong hover:bg-canvas-soft-2"
		type="button"
		hidden
	>
		Use Device GPS
	</button>
</div>
