---
import { SUPPORTED_LOCALES, DEFAULT_LOCALE } from '../i18n/locales';

const { currentLang = DEFAULT_LOCALE } = Astro.props as { currentLang?: string };
---

<div class="relative group">
	<button
		id="localeSwitcherBtn"
		class="focus-ring flex items-center gap-1 rounded-md border border-hairline bg-canvas px-2 py-1.5 text-[11px] font-mono text-body hover:border-hairline-strong hover:text-ink transition-colors"
		type="button"
		aria-haspopup="true"
		aria-expanded="false"
		aria-label="Switch language"
	>
		<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<circle cx="12" cy="12" r="10"/>
			<line x1="2" y1="12" x2="22" y2="12"/>
			<path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
		</svg>
		<span class="hidden sm:inline">{SUPPORTED_LOCALES.find(l => l.code === currentLang)?.label || 'EN'}</span>
		<svg class="w-3 h-3 transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<polyline points="6 9 12 15 18 9"/>
		</svg>
	</button>
	<div
		id="localeDropdown"
		class="absolute right-0 top-full mt-1 z-50 hidden min-w-[140px] rounded-md border border-hairline bg-canvas shadow-lg"
		role="menu"
	>
		{SUPPORTED_LOCALES.map(l => {
			const href = l.code === DEFAULT_LOCALE ? '/' : `/${l.code}/`;
			return (
				<a
					href={href}
					data-lang-code={l.code}
					class:list={[
						'block px-3 py-2 text-xs font-mono transition-colors hover:bg-canvas-soft-2',
						l.code === currentLang ? 'text-ink font-semibold' : 'text-body',
					]}
					lang={l.code}
					dir={l.dir}
					role="menuitem"
				>
					{l.label}
				</a>
			);
		})}
	</div>
</div>

<script>
	const btn = document.getElementById('localeSwitcherBtn');
	const dropdown = document.getElementById('localeDropdown');

	if (btn && dropdown) {
		btn.addEventListener('click', (e) => {
			e.stopPropagation();
			const isOpen = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!isOpen));
			dropdown.classList.toggle('hidden', isOpen);
		});

		document.addEventListener('click', () => {
			btn.setAttribute('aria-expanded', 'false');
			dropdown.classList.add('hidden');
		});

		// Fix locale links to preserve current path
		dropdown.querySelectorAll('a').forEach(a => {
			a.addEventListener('click', (e) => {
				e.preventDefault();
				const code = a.getAttribute('data-lang-code');
				const currentPath = window.location.pathname;
				// Remove existing locale prefix
				const normalizedPath = currentPath.replace(/^\/[a-z]{2}(\/|$)/, '/');
				const newPath = code === 'en' ? normalizedPath : `/${code}${normalizedPath}`;
				window.location.href = newPath;
			});
		});
	}
</script>
