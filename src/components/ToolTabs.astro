---
import { DEFAULT_LOCALE } from '../i18n/locales';

const { current = 'compass', lang = DEFAULT_LOCALE, t = {} as Record<string, string> } = Astro.props as {
	current?: 'compass' | 'sun' | 'moon' | 'solar-system' | 'qibla' | 'wind' | 'golden-hour' | 'uv-index' | 'prayer-times' | 'day-length';
	lang?: string;
	t?: Record<string, string>;
};

function localeHref(path: string): string {
	if (lang === DEFAULT_LOCALE) return path;
	if (path === '/') return `/${lang}/`;
	return `/${lang}${path}`;
}

const tabs = [
	{ id: 'compass', href: localeHref('/'), labelKey: 'nav.compass', shortKey: 'nav.compass.short', icon: '◎', ariaKey: 'nav.compass.aria' },
	{ id: 'sun', href: localeHref('/sun-position/'), labelKey: 'nav.sun', shortKey: 'nav.sun.short', icon: '☀', ariaKey: 'nav.sun.aria' },
	{ id: 'moon', href: localeHref('/moon-position/'), labelKey: 'nav.moon', shortKey: 'nav.moon.short', icon: '☽', ariaKey: 'nav.moon.aria' },
	{ id: 'qibla', href: localeHref('/qibla-compass/'), labelKey: 'nav.qibla', shortKey: 'nav.qibla.short', icon: '🕋', ariaKey: 'nav.qibla.aria' },
	{ id: 'wind', href: localeHref('/wind-compass/'), labelKey: 'nav.wind', shortKey: 'nav.wind.short', icon: '💨', ariaKey: 'nav.wind.aria' },
	{ id: 'golden-hour', href: localeHref('/golden-hour/'), labelKey: 'nav.goldenHour', shortKey: 'nav.goldenHour.short', icon: '🌅', ariaKey: 'nav.goldenHour.aria' },
	{ id: 'uv-index', href: localeHref('/uv-index/'), labelKey: 'nav.uvIndex', shortKey: 'nav.uvIndex.short', icon: '☀️', ariaKey: 'nav.uvIndex.aria' },
	{ id: 'prayer-times', href: localeHref('/prayer-times/'), labelKey: 'nav.prayerTimes', shortKey: 'nav.prayerTimes.short', icon: '🕌', ariaKey: 'nav.prayerTimes.aria' },
	{ id: 'day-length', href: localeHref('/day-length/'), labelKey: 'nav.dayLength', shortKey: 'nav.dayLength.short', icon: '📅', ariaKey: 'nav.dayLength.aria' },
	{ id: 'solar-system', href: localeHref('/solar-system/'), labelKey: 'nav.solarSystem', shortKey: 'nav.solarSystem.short', icon: '🪐', ariaKey: 'nav.solarSystem.aria' },
] as const;

function tr(key: string): string {
	return t[key] || key.split('.').pop()?.replace(/([A-Z])/g, ' $1').replace(/^./, s => s.toUpperCase()) || key;
}
---

<nav
	class="sticky top-16 z-30 border-b border-hairline bg-canvas/95 backdrop-blur-md"
	aria-label={t['nav.main.label'] || 'Main tools'}
>
	<div class="content-grid py-2">
		<ul class="flex gap-1.5 overflow-x-auto sm:grid sm:grid-cols-5 lg:grid-cols-10 sm:gap-2">
			{
				tabs.map((tab) => (
					<li>
						<a
							class:list={[
								'focus-ring flex min-h-11 flex-col items-center justify-center rounded-md border px-2 py-2 text-center transition-colors duration-150 sm:min-h-12 sm:flex-row sm:gap-2 sm:px-4',
								current === tab.id
									? 'border-hairline-strong bg-ink font-semibold text-canvas'
									: 'border-hairline bg-canvas-soft-2 text-body hover:border-hairline-strong hover:text-ink',
							]}
							href={tab.href}
							aria-current={current === tab.id ? 'page' : undefined}
							aria-label={tr(tab.ariaKey)}
						>
							<span class="text-base leading-none sm:text-lg" aria-hidden="true">
								{tab.icon}
							</span>
							<span class="mt-0.5 text-[10px] font-mono uppercase tracking-wide sm:mt-0 sm:text-xs sm:normal-case sm:tracking-normal">
								<span class="sm:hidden">{tr(tab.shortKey)}</span>
								<span class="hidden sm:inline">{tr(tab.labelKey)}</span>
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</nav>
