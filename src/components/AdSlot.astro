---
/**
 * AdSlot.astro
 * Renders a Google AdSense ad unit that only activates after cookie consent.
 * No empty placeholder boxes — hidden until ads can load.
 */
const { format = 'horizontal', id } = Astro.props as { format?: 'responsive' | 'horizontal' | 'vertical'; id?: string };

const layoutMap: Record<string, string> = {
	horizontal: 'auto',
	vertical: 'auto',
	responsive: 'auto',
};
const adFormat = layoutMap[format] || 'auto';
---

<div class="ad-container" id={id} data-ad-format={format}>
	<ins class="adsbygoogle ad-unit"
		data-ad-client="ca-pub-7553741538403317"
		data-ad-format={adFormat}
		data-full-width-responsive="true"
	></ins>
</div>

<script>
	// Only push ads when AdSense script is loaded (after consent)
	function tryInitAd(el: HTMLElement) {
		try {
			// @ts-ignore
			(window.adsbygoogle = window.adsbygoogle || []).push({});
		} catch (_) {
			// AdSense not loaded yet — ignore
		}
	}

	function initAllAds() {
		document.querySelectorAll('.ad-unit:not([data-ad-status])').forEach((el) => {
			tryInitAd(el as HTMLElement);
		});
	}

	// If AdSense already loaded (consent was previously given)
	// @ts-ignore
	if (window.adsbygoogle) {
		initAllAds();
	}

	// Listen for consent event to initialize ads
	window.addEventListener('cookie-consent-granted', () => {
		// Small delay to let AdSense script load
		setTimeout(initAllAds, 1000);
	});
</script>

<style>
	.ad-container {
		width: 100%;
		min-height: 0;
		overflow: hidden;
	}

	.ad-unit {
		display: block;
		width: 100%;
	}
</style>