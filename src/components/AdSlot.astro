---
const { format = 'responsive', id } = Astro.props as { format?: 'responsive' | 'horizontal' | 'vertical'; id?: string };
---

<div class="ad-slot rounded-panel border border-dashed border-hairline bg-canvas-soft p-4 text-center" data-ad-format={format} id={id}>
  <slot />
</div>

<style>
.ad-slot {
  min-height: 90px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
}
</style>