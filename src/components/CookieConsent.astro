---
/**
 * CookieConsent.astro
 * GDPR-compliant cookie consent banner required for Google AdSense.
 * Gates loading of Google Analytics and AdSense until user consents.
 */
---

<div id="cookieConsent" class="cookie-banner" role="dialog" aria-label="Cookie consent" aria-modal="false" style="display:none;">
	<div class="content-grid">
		<div class="cookie-inner">
			<div class="cookie-text">
				<p class="cookie-title">We value your privacy</p>
				<p class="cookie-desc">
					We use cookies to enhance your experience, serve personalized ads through Google AdSense, and analyze traffic with Google Analytics. By clicking "Accept All", you consent to our use of cookies. You can manage your preferences or learn more in our <a href="/privacy-policy/">Privacy Policy</a>.
				</p>
			</div>
			<div class="cookie-actions">
				<button id="cookieReject" class="cookie-btn cookie-btn-secondary" type="button">
					Reject Non-Essential
				</button>
				<button id="cookieAccept" class="cookie-btn cookie-btn-primary" type="button">
					Accept All
				</button>
			</div>
		</div>
	</div>
</div>

<script>
	(function () {
		const CONSENT_KEY = 'oc:cookie-consent';
		const consent = localStorage.getItem(CONSENT_KEY);

		function loadAdSense() {
			if (document.getElementById('adsense-script')) return;
			const s = document.createElement('script');
			s.id = 'adsense-script';
			s.async = true;
			s.crossOrigin = 'anonymous';
			s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7553741538403317';
			document.head.appendChild(s);
		}

		function loadAnalytics() {
			if (document.getElementById('ga-script')) return;
			const s = document.createElement('script');
			s.id = 'ga-script';
			s.async = true;
			s.src = 'https://www.googletagmanager.com/gtag/js?id=G-L1KC85ZFZF';
			document.head.appendChild(s);
			s.onload = function () {
				// @ts-ignore
				window.dataLayer = window.dataLayer || [];
				// @ts-ignore
				function gtag() { window.dataLayer.push(arguments); }
				// @ts-ignore
				gtag('js', new Date());
				// @ts-ignore
				gtag('config', 'G-L1KC85ZFZF');
			};
		}

		function acceptAll() {
			localStorage.setItem(CONSENT_KEY, 'accepted');
			hideBanner();
			loadAdSense();
			loadAnalytics();
			// Dispatch event so AdSlots can initialize
			window.dispatchEvent(new CustomEvent('cookie-consent-granted'));
		}

		function rejectNonEssential() {
			localStorage.setItem(CONSENT_KEY, 'rejected');
			hideBanner();
		}

		function hideBanner() {
			const banner = document.getElementById('cookieConsent');
			if (banner) {
				banner.style.opacity = '0';
				banner.style.transform = 'translateY(100%)';
				setTimeout(() => { banner.style.display = 'none'; }, 300);
			}
		}

		function showBanner() {
			const banner = document.getElementById('cookieConsent');
			if (banner) {
				banner.style.display = 'block';
				requestAnimationFrame(() => {
					banner.style.opacity = '1';
					banner.style.transform = 'translateY(0)';
				});
			}
		}

		// If consent was already given, load scripts immediately
		if (consent === 'accepted') {
			loadAdSense();
			loadAnalytics();
		} else if (!consent) {
			// Show banner if no consent recorded yet
			// Use requestIdleCallback or setTimeout to not block initial render
			if ('requestIdleCallback' in window) {
				requestIdleCallback(showBanner, { timeout: 1500 });
			} else {
				setTimeout(showBanner, 800);
			}
		}

		// Bind buttons
		document.addEventListener('DOMContentLoaded', () => {
			document.getElementById('cookieAccept')?.addEventListener('click', acceptAll);
			document.getElementById('cookieReject')?.addEventListener('click', rejectNonEssential);
		});
	})();
</script>

<style>
	.cookie-banner {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 9999;
		padding: 1rem 0;
		background: var(--color-canvas);
		border-top: 1px solid var(--color-hairline-strong);
		box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.3);
		opacity: 0;
		transform: translateY(100%);
		transition: opacity 0.3s ease, transform 0.3s ease;
	}

	[data-theme="light"] .cookie-banner {
		box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.08);
	}

	.cookie-inner {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	@media (min-width: 640px) {
		.cookie-inner {
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			gap: 1.5rem;
		}
	}

	.cookie-title {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: var(--color-ink);
	}

	.cookie-desc {
		margin: 0.375rem 0 0;
		font-size: 0.75rem;
		line-height: 1.5;
		color: var(--color-body);
	}

	.cookie-desc a {
		color: var(--color-ink);
		text-decoration: underline;
	}

	.cookie-desc a:hover {
		text-decoration: none;
	}

	.cookie-actions {
		display: flex;
		gap: 0.5rem;
		flex-shrink: 0;
	}

	.cookie-btn {
		cursor: pointer;
		border: none;
		border-radius: 9999px;
		padding: 0.5rem 1rem;
		font-family: var(--font-mono);
		font-size: 0.6875rem;
		font-weight: 600;
		white-space: nowrap;
		transition: opacity 0.15s ease;
	}

	.cookie-btn:hover {
		opacity: 0.85;
	}

	.cookie-btn-primary {
		background: var(--color-ink);
		color: var(--color-canvas);
	}

	.cookie-btn-secondary {
		background: var(--color-canvas-soft-2);
		color: var(--color-body);
		border: 1px solid var(--color-hairline-strong);
	}
</style>
